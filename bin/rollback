#!/usr/bin/env bash
set -e

ENV="${1:-staging}"
TAG="$2"

if [ "$ENV" != "staging" ] && [ "$ENV" != "production" ]; then
  echo "Usage: bin/rollback [staging|production] [optional_commit_sha]"
  exit 1
fi

# Set host and directory based on environment
if [ "$ENV" = "production" ]; then
  SERVER="makerepo.com"
  APP_DIR="/var/www/makerrepo"
else
  SERVER="staging-server.makerepo.com"
  APP_DIR="/var/www/makerrepo-staging"
fi

# Locate the SSH key
SSH_KEY="$HOME/.ssh/makerepo_key"
SSH_OPTS=""
if [ -f "$SSH_KEY" ]; then
  SSH_OPTS="-i $SSH_KEY"
fi

# If no tag was provided, find the previous commit SHA from git
if [ -z "$TAG" ]; then
  echo "🔍 No tag specified. Finding previous commit SHA from git..."
  # Gets the full 40-character commit hash of the previous commit (HEAD~1)
  TARGET_SHA=$(git rev-parse HEAD~1 2>/dev/null || true)
  
  if [ -z "$TARGET_SHA" ]; then
    echo "❌ Could not determine previous git commit. Please specify a commit SHA:"
    echo "   bin/rollback $ENV <commit_sha>"
    exit 1
  fi
  TARGET_TAG="${ENV}-${TARGET_SHA}"
else
  # Normalize user input (handles short SHAs, full SHAs, or pre-prefixed tags)
  if [[ "$TAG" == "${ENV}-"* ]]; then
    TARGET_TAG="$TAG"
  else
    # If the user passed a short SHA (e.g. 5b7f5d4), expand to full SHA if possible
    FULL_SHA=$(git rev-parse "$TAG" 2>/dev/null || echo "$TAG")
    TARGET_TAG="${ENV}-${FULL_SHA}"
  fi
fi

echo "🔄 Rolling back $ENV on $SERVER to tag: $TARGET_TAG..."

ssh $SSH_OPTS -A deploy@$SERVER bash -s << EOF
  set -e
  cd $APP_DIR

  export DOCKER_IMAGE="ghcr.io/uottawa-makerspace/makerspacerepo"
  export IMAGE_TAG="$TARGET_TAG"

  echo "⬇️  Pulling image \${DOCKER_IMAGE}:\${IMAGE_TAG} from GHCR..."
  if ! docker compose --env-file .env.${ENV} -f docker-compose.${ENV}.yml pull web worker; then
    echo "❌ Failed to pull tag \${IMAGE_TAG} from GHCR. Does this build exist?"
    exit 1
  fi

  echo "🚀 Restarting containers with rolled back image..."
  docker compose --env-file .env.${ENV} -f docker-compose.${ENV}.yml up -d --remove-orphans

  echo "✅ Successfully rolled back to \$IMAGE_TAG!"
EOF