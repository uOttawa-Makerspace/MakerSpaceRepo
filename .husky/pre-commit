# Run against the checkout being committed, which may be a git worktree with
# its own bin/ and Gemfile (never the main checkout's).
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1
export PATH="$repo_root/bin:$PATH"
export BUNDLE_GEMFILE="$repo_root/Gemfile"

yarn lint-staged

printf "Changed Files:\n"
# staged filenames, filter out deleted
changed_files=$(git diff --name-only --staged HEAD --diff-filter=d | grep -E '\.(erb)$') && echo "$changed_files"
if [ -n "$changed_files" ]; then
  printf "Running erb_lint..."
  bundle exec erb_lint $changed_files --autocorrect
  git add $changed_files
fi
