<div class="container">
    <div class="row align-items-start">
        <div class="col-4 py-3 px-my-5">
            <%= render "badge_icon", width: "", height: "", level: @certification.level, name: @certification.training.localized_name, skill: @certification.get_skill_id %>
        </div>
        <div class="col-8 py-3 px-my-5">
            <h1><%= @certification.training.localized_name %></h1>
            <h4 class="my-3 fw-bold"><%= t("badges.show.owner", name: @earner.name) %></h4>
            <h5 class="my-3"><%= t("badges.show.issued_by", date: l(@certification.created_at.to_date, format: :issued)) %></h5>
            <p><%= @certification.training.description %></p>

            <a class="my-4 text-decoration-underline" href="https://www.uottawa.ca/faculty-engineering/"><%= t("badges.show.learn_more") %></a> <br>
            
            <div class="my-5">
                <h5><%= t("badges.show.skills") %></h5>
                
                <% @certification.training.skill_list.each do |sk| %>
                    <span class="badge" style="background: <%= @skill_colour %>; inline"><%= sk %></span>
                <% end %>
            </div>
            <% if current_user.id == @earner.id %>
                <a id="linkedin" class="btn btn-outline-secondary" href="https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=<%= @certification.get_name_fr %> // <%= @certification.get_name_en %>&organizationId=38127375&issueYear=<%= @certification.created_at.year %>&issueMonth=<%= @certification.created_at.month %>&expirationYear=<%= @certification.created_at.year + 10 %>&expirationMonth=5&certUrl=https://makerepo.com/badges/<%= @certification.id %>/&certId=<%= @certification.id %>"><%= t("badges.show.add_to_linkedin") %>
                </a>
                
                <button id="add-to-linkedin" class="btn btn-outline-secondary"><%= t("badges.show.download_png") %></button>
            <% end %>
        </div>
    </div>
</div>
