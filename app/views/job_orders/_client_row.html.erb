<td class="px-1">
  <% if unread > 0 %>
    <div class="mx-auto position-relative" style="width: min-content;">
      <i class="fa fa-bell text-danger" style="scale: 1.7;"></i>
      <span class="position-absolute translate-middle badge rounded-pill bg-danger">
        <%= unread %>
        <span class="visually-hidden"><%= t('job_orders.list.unread_messages') %></span>
      </span>
    </div>
  <% end %>
</td>
<td>
  <% if !jo.user.nil? %>
    <%= link_to jo.user.name, user_path(jo.user.username) %>
    <%= jo.user.email %>
  <% else %>
    <%= t('job_orders.order.deleted_user') %>
  <% end %>
</td>
<td><%= jo.id %></td>
<td data-sort="<%= jo.created_at %>"><%= l(jo.created_at, format: :long) %></td>
</td>
<td>
  <% jo.job_tasks.each_with_index do |task, i| %>
    <%= " ," if i != 0 %>
    <%= task.job_type&.name || t("job_orders.order.no_job_type") %>
  <% end %>
</td>
<td><%= jo.latest_status.job_status.t_name %></td>
<td>
  <%= 
    link_to t('job_orders.list.view'), job_order_path(jo.id), class: 'btn btn-primary btn-sm'
  %>
</td>
