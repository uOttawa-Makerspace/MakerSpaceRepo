<div class="jumbotron text-center">
  <h1><%= t('job_orders.customer_pages.thank_you_for_ordering') %></h1>
  <p><%= t('job_orders.customer_pages.approval_intro') %></p>
  <hr>
  <p class="lead">
    <%= t('job_orders.customer_pages.total_quote', amount: number_to_currency(@job_order.total_price)) %>
    <div class="mt-3">
      <%= button_to t('job_orders.customer_pages.approve_quote'), user_magic_approval_confirmation_job_orders_path(token: @token, approved: true), method: :patch, class: "btn btn-primary", **confirmation_options(t('confirmations.job_orders.approve_quote')) %>
      <%= button_to t('job_orders.customer_pages.deny_quote'), user_magic_approval_confirmation_job_orders_path(token: @token, approved: false), method: :patch, class: "btn btn-danger", **confirmation_options(t('confirmations.job_orders.deny_quote')) %>
    </div>
  </p>
  <hr>
  <%= render 'job_orders/contact' %>
</div>
