<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <title><%= t('job_orders.invoice_page.title') %></title>

  <style>
      .invoice-box {
          max-width: 800px;
          margin: auto;
          padding: 30px;
          border: 1px solid #eee;
          box-shadow: 0 0 10px rgba(0, 0, 0, .15);
          font-size: 16px;
          line-height: 24px;
          font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
          color: #555;
      }

      .invoice-box table {
          width: 100%;
          line-height: inherit;
          text-align: left;
      }

      .invoice-box table td {
          padding: 5px;
          vertical-align: top;
      }

      .invoice-box table tr td:nth-child(2) {
          text-align: right;
      }

      .invoice-box table tr.top table td {
          padding-bottom: 20px;
      }

      .invoice-box table tr.top table td.title {
          font-size: 45px;
          line-height: 45px;
          color: #333;
      }

      .invoice-box table tr.information table td {
          padding-bottom: 40px;
      }

      .invoice-box table tr.heading td {
          background: #eee;
          border-bottom: 1px solid #ddd;
          font-weight: bold;
      }

      .invoice-box table tr.details td {
          padding-bottom: 20px;
      }

      .invoice-box table tr.item td {
          border-bottom: 1px solid #eee;
      }

      .invoice-box table tr.item.last td {
          border-bottom: none;
      }

      .invoice-box table tr.total td:nth-child(2) {
          border-top: 2px solid #eee;
          font-weight: bold;
      }

      @media only screen and (max-width: 600px) {
          .invoice-box table tr.top table td {
              width: 100%;
              display: block;
              text-align: center;
          }

          .invoice-box table tr.information table td {
              width: 100%;
              display: block;
              text-align: center;
          }
      }

   @media print {
     .print-button{
       display: none;
     }

     .invoice-box {
       max-width: unset;
       border: unset;
       box-shadow: unset;
     }
   }

      /** RTL **/
      .rtl {
          direction: rtl;
          font-family: Tahoma, 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
      }

      .rtl table {
          text-align: right;
      }

      .rtl table tr td:nth-child(2) {
          text-align: left;
      }
  </style>
  <script>
   window.print();
  </script>
</head>

<body>
<div class="invoice-box">
  <table>
    <tr class="top">
      <td colspan="2">
        <table>
          <tr>
            <td class="title"><%= vite_image_tag 'images/ceed.png', alt: t('common.names.ceed_logo') %></td>
            <td><%= t('job_orders.invoice_page.number', id: @job_order.id) %></td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="information">
      <td colspan="2">
        <table>
          <tr>
            <td>
              <%= t('job_orders.invoice_page.address.name') %><br>
              <%= t('job_orders.invoice_page.address.room') %><br>
              <%= t('job_orders.invoice_page.address.street') %><br>
              <%= t('job_orders.invoice_page.address.city') %>
            </td>

            <td>
              <%# A deleted customer account is hidden from user lookups, so the order may have no customer to name. %>
              <%= t('job_orders.invoice_page.client', name: @job_order.user&.name || t('job_orders.order.deleted_user')) %>
              <br>
              <%# The day of the latest status; an order without any status row has only its own creation day. %>
              <%= t('job_orders.invoice_page.date', date: l((@job_order.latest_status || @job_order).created_at, format: :job_order_invoice)) %>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="heading">
      <td>
        <%= t('job_orders.invoice_page.payment_method') %>
      </td>
      <td></td>
    </tr>

    <tr class="details">
      <td>
        <%= t('job_orders.invoice_page.payment_details_html', link: link_to('https://en.wiki.makerepo.com/wiki/How_to_pay_for_an_Order', 'https://en.wiki.makerepo.com/wiki/How_to_pay_for_an_Order')) %>
      </td>
      <td></td>
    </tr>

    <tr class="heading">
      <td>
        <%= t('job_orders.invoice_page.item') %>
      </td>
      <td>
        <%= t('job_orders.invoice_page.price') %>
      </td>
    </tr>

    <% @tasks.each do |task| %>
      <!-- Task Base Fee -->
      <% if task.job_task_quote&.price.to_f > 0 %>
        <tr class="item">
          <td>
            <%= t('job_orders.invoice_page.base_fee', task: task.title) %>
          </td>
          <td>
            <%= t('job_orders.invoice_page.amount', amount: number_to_currency(task.job_task_quote.price)) %>
          </td>
        </tr>
      <% end %>

      <!-- Task Service -->
      <% service_total = task.job_task_quote ? task.job_task_quote.service_total : 0 %>
      <% if service_total > 0 %>
        <tr class="item">
          <td>
            <%= task.title %> - <%= task.job_service&.name || t('job_orders.invoice_page.service') %>
            <% if task.job_service&.job_service_group %>
              (<%= task.job_service.job_service_group.name %>)
            <% end %>
            - <%= number_with_delimiter(task.job_task_quote.service_quantity || 0, delimiter: '') %> <%= task.job_service&.unit.presence || t('job_orders.invoice_page.unit') %>
          </td>
          <td>
            <%= t('job_orders.invoice_page.amount', amount: number_to_currency(service_total)) %>
          </td>
        </tr>
      <% end %>

      <!-- Task Options -->
      <% task.job_task_quote&.job_task_quote_options&.each do |option| %>
        <tr class="item">
          <td>
            <%= task.title %> - <%= t('job_orders.invoice_page.option', name: option.job_option.name) %>
          </td>
          <td>
            <%= t('job_orders.invoice_page.amount', amount: number_to_currency(option.price)) %>
          </td>
        </tr>
      <% end %>
    <% end %>

    <% if @job_order.job_quote_line_items.any? %>
      <% @job_order.job_quote_line_items.each do |item| %>
        <tr class="item">
          <td>
            <%= item.description.presence || t('job_orders.invoice_page.line_item') %>
          </td>
          <td>
            <%= t('job_orders.invoice_page.amount', amount: number_to_currency(item.price)) %>
          </td>
        </tr>
      <% end %>
    <% end %>

    <tr class="total">
      <td></td>
      <td>
        <%= t('job_orders.invoice_page.total', amount: t('job_orders.invoice_page.amount', amount: number_to_currency(@job_order.total_price))) %>
      </td>
    </tr>
  </table>
  <button class="print-button" onclick="window.print()"><%= t('job_orders.invoice_page.print') %></button>
</div>
</body>
</html>