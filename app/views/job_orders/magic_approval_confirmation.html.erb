<div class="jumbotron text-center">
  <% if @status %>
    <i class="fa fa-check-circle fa-5x mb-3 text-success"></i>
    <h1><%= t('job_orders.customer_pages.thank_you_for_answering') %></h1>
  <% else %>
    <i class="fa fa-times-circle fa-5x mb-3 text-danger"></i>
    <h1><%= t("errors.job_orders.approval_failed_title") %></h1>

    <h2><%= @refusal %></h2>
  <% end %>
  <hr>
  <%= render 'job_orders/contact' %>
</div>
