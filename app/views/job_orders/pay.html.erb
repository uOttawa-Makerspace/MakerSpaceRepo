<div class="jumbotron text-center">
  <h1><%= t('job_orders.customer_pages.thank_you_for_ordering') %></h1>
  <p><%= t('job_orders.customer_pages.pay_intro') %></p>
  <p><%= t('job_orders.customer_pages.no_payment_data_saved_html') %></p>
  <hr>
  <p class="lead">
    <%= t('job_orders.customer_pages.total_quote', amount: number_to_currency(@job_order.total_price)) %>
  <div class="mt-3">
    <% if @payment_link.present? %>
      <%= link_to t('job_orders.customer_pages.proceed_to_payment'), @payment_link, class: 'btn btn-primary' %>
    <% else %>
      <div class="alert alert-warning"><%= t("job_orders.alerts.payment_link_unavailable") %></div>
    <% end %>
  </div>
  </p>
  <hr>
  <%= render 'job_orders/contact' %>
</div>
