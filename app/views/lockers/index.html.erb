<% provide :title, t('lockers.locker_dashboard') %>

<div class="container my-4">
    <h1 class="text-center mb-3"><%= t('lockers.index.heading') %></h1>
    <div class="text-center mb-4">
        <%= link_to t('lockers.index.show_requests'), admin_locker_rentals_path, class: 'fw-bold link-primary text-decoration-none' %>
    </div>

    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-body-tertiary">
            <h2 class="h5 mb-0"><%= t('lockers.assign_a_locker') %></h2>
        </div>
        <div class="card-body">
            <p class="text-body-secondary"><%= t('lockers.index.assign_intro') %></p>
            <%= render 'locker_rentals/assign_locker_form' %>
        </div>
    </div>

    <div class="text-center border rounded bg-body-tertiary p-4 mb-4 shadow-sm">
        <% if LockerOption.lockers_enabled %>
            <div class="fs-4 mb-2"><i class="fa-solid fa-check text-success me-2"></i> <%= t('lockers.index.rentals_enabled') %></div>
            <%= button_to t('lockers.index.disable_rentals'), enabled_lockers_path,
                          method: :put, params: {value: 'f'}, class: 'btn btn-danger my-2' %>
        <% else %>
            <div class="fs-4 mb-2"><i class="fa-solid fa-xmark text-danger me-2"></i> <%= t('lockers.index.rentals_disabled') %></div>
            <%= button_to t('lockers.index.enable_rentals'), enabled_lockers_path,
                          method: :put, params: {value: 't'}, class: 'btn btn-success my-2' %>
        <% end %>
        <p class="text-body-secondary mb-0"><%= t('lockers.index.enabling_note_html', link: link_to(t('lockers.index.request_form_link'), locker_rentals_path, class: 'link-primary')) %></p>
    </div>

    <!-- Collapsible Configure Locker Options Box -->
    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center"
             role="button"
             data-bs-toggle="collapse"
             data-bs-target="#collapseLockerOptions"
             aria-expanded="false"
             aria-controls="collapseLockerOptions"
             style="cursor: pointer;">
            <h2 class="h5 mb-0">
                <i class="fa-solid fa-sliders me-2"></i> <%= t('lockers.index.configure_options') %>
            </h2>
            <span class="btn btn-sm btn-outline-secondary"><%= t('lockers.index.toggle_settings') %> <i class="fa-solid fa-chevron-down ms-1"></i></span>
        </div>
        <div class="collapse" id="collapseLockerOptions">
            <div class="card-body">
                <%= render 'locker_size_control' %>
            </div>
        </div>
    </div>

    <h2 class="text-center my-4" id="lockerInventory"><%= t('lockers.index.inventory') %></h2>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newRangeLockerModal">
            <i class="fa-solid fa-plus-circle"></i> <%= t('lockers.index.make_range') %>
        </button>

        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newLockerModal">
            <i class="fa-solid fa-plus"></i> <%= t('lockers.index.make_single') %>
        </button>
    </div>

    <div>
        <% if @lockers.blank? %>
            <p class="text-body-secondary"><%= t('lockers.index.no_lockers') %></p>
        <% else %>
            <h3 class="h5 mb-3"><%= t('lockers.index.edit_current') %></h3>
            <%= render 'locker_bulk_edit_modal' %>
            <%= render 'lockers_inventory_table' %>
        <% end %>
    </div>
</div>

<%= render 'new_locker_modal' %>
