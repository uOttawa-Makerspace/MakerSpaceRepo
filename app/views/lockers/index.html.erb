<% provide :title, 'Locker dashboard' %>

<div class="container my-4">
    <h1 class="text-center mb-3">Locker Management</h1>
    <div class="text-center mb-4">
        <%= link_to 'Show pending locker requests', admin_locker_rentals_path, class: 'fw-bold link-primary text-decoration-none' %>
    </div>

    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-body-tertiary">
            <h2 class="h5 mb-0">Assign a locker</h2>
        </div>
        <div class="card-body">
            <p class="text-body-secondary">Assign a locker to someone, active immediately. The locker owner will be notified by email. Intended to assign lockers to staff.</p>
            <%= render 'locker_rentals/assign_locker_form' %>
        </div>
    </div>

    <div class="text-center border rounded bg-body-tertiary p-4 mb-4 shadow-sm">
        <% if LockerOption.lockers_enabled %>
            <div class="fs-4 mb-2"><i class="fa-solid fa-check text-success me-2"></i> New locker rentals are enabled.</div>
            <%= button_to 'Click here to disable locker rentals', enabled_lockers_path,
                          method: :put, params: {value: 'f'}, class: 'btn btn-danger my-2' %>
        <% else %>
            <div class="fs-4 mb-2"><i class="fa-solid fa-xmark text-danger me-2"></i> New locker rentals are disabled.</div>
            <%= button_to 'Click here to enable locker rentals', enabled_lockers_path,
                          method: :put, params: {value: 't'}, class: 'btn btn-success my-2' %>
        <% end %>
        <p class="text-body-secondary mb-0">Enabling lockers will enable <%= link_to "locker request form submissions", locker_rentals_path, class: 'link-primary' %>,
            and will display links to it on the homepage and resources header dropdown.</p>
    </div>

    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-body-tertiary">
            <h2 class="h5 mb-0">Configure locker options</h2>
        </div>
        <div class="card-body">
            <%= render 'locker_size_control' %>
        </div>
    </div>

    <h2 class="text-center my-4" id="lockerInventory">Locker Inventory</h2>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newRangeLockerModal">
            <i class="fa-solid fa-plus-circle"></i> Make a range of lockers
        </button>

        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newLockerModal">
            <i class="fa-solid fa-plus"></i> Make a single locker
        </button>
    </div>

    <div>
        <% if @lockers.blank? %>
            <p class="text-body-secondary">There are no lockers on record.</p>
        <% else %>
            <h3 class="h5 mb-3">Edit current lockers</h3>
            <%= render 'locker_bulk_edit_modal' %>
            <%= render 'lockers_inventory_table' %>
        <% end %>
    </div>
</div>

<%= render 'new_locker_modal' %>
