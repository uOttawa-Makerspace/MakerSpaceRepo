<% provide(:title, "Locker #{@locker.specifier} History") %>

<div class="mb-4">
    <%= link_to lockers_path, class: 'text-muted text-decoration-none' do %>
        <i class="fa-solid fa-arrow-left"></i> Back to Locker Inventory
    <% end %>
</div>

<h1 class="text-center mb-4">Locker <%= @locker.specifier_was %></h1>

<% if current_user.staff? %>
    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-body-tertiary">
            <h2 class="h5 mb-0">Edit Locker Details</h2>
        </div>
        <div class="card-body">
            <%= form_with model: @locker do |f| %>
                <div class="row g-3">
                    <div class="col-md-4">
                        <%= f.label :specifier, 'Specifier / Number', class: 'form-label fw-bold' %>
                        <%= f.text_field :specifier, class: 'form-control', required: true, inputmode: 'numeric', pattern: '\d+' %>
                    </div>

                    <div class="col-md-4">
                        <%= f.label :locker_size_id, 'Locker Size', class: 'form-label fw-bold' %>
                        <%= f.select :locker_size_id, @locker_sizes.map { |size|
                            [ size.size, size.id, { 'data-data' => @locker_product_info[:variants][size.shopify_gid].to_json } ]},
                         { include_blank: 'Select variant...' }, { class: 'form-select locker-variant-select' } %>
                    </div>

                    <div class="col-md-4">
                        <%= f.label :audience, 'Audience / Type', class: 'form-label fw-bold' %>
                        <%= f.select :audience, options_for_select([['General', 'general'], ['Staff', 'staff'], ['GNG Design', 'gng']], @locker.audience), {}, { class: 'form-select' } %>
                    </div>

                    <div class="col-12">
                        <%= f.label :notes, 'Physical Locker Note (Maintenance / Hardware)', class: 'form-label fw-bold' %>
                        <%= f.text_area :notes, class: 'form-control', rows: 2, placeholder: 'e.g. Broken latch, bottom locker, reserved for robotics demo...' %>
                        <div class="form-text">These notes stay with this physical locker permanently regardless of who is currently renting it.</div>
                    </div>

                    <div class="col-12 d-flex justify-content-end">
                        <%= f.submit 'Save Locker Changes', class: 'btn btn-primary' %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
<% end %>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title h5">Current Status</h2>
        <% if @active_locker_rental %>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <% if @active_locker_rental.expired? %>
                        <span class="badge bg-danger">
                            <i class="fa-solid fa-xmark"></i> Expired
                        </span>
                    <% else %>
                        <%= locker_rental_state_display @active_locker_rental %>
                    <% end %>
                    <span class="text-muted ms-2">
                        rented by <strong><%= @active_locker_rental.rented_by.username %></strong> since <%= @active_locker_rental.created_at.to_date.to_formatted_s(:long) %>
                    </span>
                </div>
                <%= link_to locker_rental_path(@active_locker_rental), class: 'btn btn-outline-secondary btn-sm' do %>
                    View rental details <i class="fa-solid fa-arrow-right"></i>
                <% end %>
            </div>
        <% else %>
            <span class="badge bg-secondary">Unoccupied</span>
        <% end %>
    </div>
</div>

<h2 class="text-center h4">Rental History</h2>
<p class="text-center text-muted mb-4">Log of previous owners of this locker</p>

<% rentals = @locker.locker_rentals.order(created_at: :desc) %>

<% if rentals.any? %>
    <div class="list-group mb-4">
        <% rentals.each do |rental| %>
            <%= link_to locker_rental_path(rental), class: 'list-group-item list-group-item-action' do %>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= rental.rented_by.username %></strong>
                        <br>
                        <small class="text-muted">
                            <%= rental.created_at.to_date.to_formatted_s(:long) %>
                            &mdash;
                            <%= rental.owned_until&.to_date&.to_formatted_s(:long) || 'Indefinite' %>
                        </small>
                    </div>
                    <span class="badge bg-secondary"><%= rental.state %></span>
                </div>
            <% end %>
        <% end %>
    </div>
<% else %>
    <p class="text-center text-muted mb-4">No rental history for this locker.</p>
<% end %>

<% if current_user.admin? %>
    <%= button_to 'Delete locker', locker_path(@locker), method: :delete, class: 'btn btn-outline-danger', data: { confirm: 'Are you sure you want to delete this locker?' } %>
<% end %>
