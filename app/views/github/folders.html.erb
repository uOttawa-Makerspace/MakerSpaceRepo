<section id="dropbox-folders">
  <ul>
    <%= tag.li("<i class=\"fa-solid fa-folder-open\"></i> #{@root}".html_safe) %>
    <% @folder.each do |f| %>
      <% if f.values.first == "directory" %>
        <%= tag.li("<i class=\"fa-solid fa-folder\"></i> #{f.keys.first}".html_safe) %>
      <% else %>
        <%= tag.li("<i class=\"fa-regular fa-file-lines\"></i> #{f.keys.first}".html_safe) %>
      <% end %>
    <% end %>
  </ul>
</section>
