<section class="container">
  <div class="text-center">
    <% @questions.find_each.each_with_index do |question, i| %>
      Question <%= i + 1 %>
      <% response = question.response_for_exam(@exam) %>
        <% if response %>
          <%= render partial: 'question_with_response', locals: { question:, response: } %>
        <% else %>
          <%= render partial: 'question_without_response', locals: { question: } %>
        <% end %>
      <br />
      <br />
      <br />
    <% end %>

    <%= button_to 'Finish Exam', finish_exam_exams_path(exam_id: @exam.id), method: :post, class: 'btn btn-primary my-5', form_class: 'button_to useTurbo',
                                                                          form: { data: { turbo_confirm: "Are you sure you want to submit your exam? You won't be able to make any changes after your exam submission. Questions not answered will be considered wrong." } } %>
  </div>
</section>
