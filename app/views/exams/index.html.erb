<section class="container">
  <div class="text-center">
    <h2><%= t('exams.index.title') %></h2>
    <% if !@exams.blank? %>
      <br />
      <div class="table-responsive">
        <table class="table table-striped">
           <thead class="table-primary"><tr>
            <th><%= t('exams.index.date_created') %></th>
            <th><%= t('exams.index.expires_at') %></th>
            <th><%= t('exams.index.category') %></th>
            <th><%= t('exams.index.status') %></th>
            <th><%= t('exams.index.score') %></th>
            <th class="action-header"><%= t('exams.index.action') %></th>
          </tr></thead>
          <tbody>
          <% @exams.find_each do |e| %>
            <tr>
              <td>
                <%= l(e.created_at, format: :exam_date) %>
                <br>
                <%= l(e.created_at, format: :exam_time).downcase %>
              </td>
              <td>
                <%= l(e.expired_at, format: :exam_date) %>
                <br>
                <%= l(e.expired_at, format: :exam_time).downcase %>
              </td>
              <td>
                <%= e.training.localized_name %>
              </td>
              <td>
                <b><%= t(e.ungraded? && e.expired? ? 'expired' : e.status.parameterize(separator: '_'), scope: 'exams.index.statuses', default: e.status.capitalize) %></b>
              </td>
              <td>
                <%= e.score || t('exams.index.not_available') %>
              </td>
              <td class="action-cell">
                <% if e.ungraded? && e.expired? %>
                  <%= t('exams.index.expired') %>
                  <br />
                <% elsif e.status == "not started" %>
                  <%= link_to t('exams.index.start'), exam_path(e.id), class: 'btn btn-primary' %>
                <% elsif e.status == "incomplete" %>
                  <%= link_to t('exams.index.resume'), exam_path(e.id), class: 'btn btn-primary' %>
                <% else %>
                  <%= t('exams.index.not_available') %>
                  <br />
                <% end %>
                <%= if current_user.admin?
                      button_to t('exams.index.delete'), { controller: :exams, action: :destroy, id: e.id }, method: :delete,
                                                                                              **confirmation_options(t('confirmations.exams.delete')), class: 'btn btn-danger my-2'
                    end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="m-5">
        <%= t('exams.index.none') %>
      </div>
    <% end %>
  </div>
</section>

