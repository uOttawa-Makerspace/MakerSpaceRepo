<section class="p-5">
  <div class="container text-center">
    <h2><%= t('learning_module_track.index.skills') %></h2>
    <div class="row my-5 mx-auto">

      <div class="col-md-12">
        <% @skills.each do |skill| %>

          <h2><%= skill.name %></h2>

          <% unless skill.trainings.present? %>
            <p><%= t('learning_module_track.index.no_trainings') %></p>
          <% end %>

          <% skill.trainings.each do |training| %>

            <div class="accordion" id="accordion-<%= training.id %>">
              <div class="accordion-item m-3">
                <div class="accordion-header" id="header-<%= training.id %>">
                  <p style="float: right"><%= sanitize(get_lower_level_lm(training)) %></p>
                  <h2 class="mb-0">
                    <button class="accordion-button btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#training-<%= training.id %>">
                      <%= training.localized_name %>
                    </button>
                  </h2>
                </div>

                <div id="training-<%= training.id %>" class="accordion-collapse collapse" aria-labelledby="header-<%= training.id %>" data-bs-parent="#accordion-<%= training.id %>">
                  <div class="accordion-body">

                    <p><%= training.description.presence %></p>

                    <p><%= t('learning_module_track.index.modules_finished', done: training.learning_modules_completed(current_user).size, total: training.learning_modules.size) %></p>
                    <p><%= t('learning_module_track.index.next_modules') %></p>
                    <ul>
                      <% get_next_lm(training).each do |next_module| %>
                        <li><%= link_to next_module.title, learning_area_path(id: next_module.id) %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

          <% end %>

        <% end %>
      </div>

      <% @certifications.each do |cert| %>
        <div class="col-md-3 text-center my-3">
          <b><%= cert.training.localized_name %> </b> <br/>
          <%= vite_image_tag(cert.get_badge_path, class: 'skills-badges', alt: t('common.names.medal_image')) %>
          <br/>
          <%= cert.training_session.level %>
        </div>
        <br/>
        <br/>
        <br/>
      <% end %>

      <% @remaining_trainings.each do |training| %>
        <div class="col-md-3 text-center my-3">
          <b><%= training.localized_name %> </b> <br/>
          <%= vite_image_tag 'images/badges/none.png', class: 'skills-badges', alt: t('common.names.no_medal_picture') %>
          <br/>
          <%= t('learning_module_track.index.no_certification') %>
        </div>
      <% end %>
    </div>
  </div>
</section>