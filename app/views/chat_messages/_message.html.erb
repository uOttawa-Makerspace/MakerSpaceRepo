<div class="mb-1 p-2 rounded d-inline-block <%= chat_message.sender_id == current_user.id ? "border" : "bg-body-secondary" %>">
  <div class="d-flex justify-content-between align-items-center">
    <span class="fw-bold">
      <%= chat_sender_label(chat_message, current_user) %>
      <% if chat_sender_staff?(chat_message, current_user) %><span class="text-primary fw-normal">(staff)</span><% end %>:
    </span>
    <small class="text-muted ms-1"><%= chat_message.timestamp %></small>
  </div>
  <div class="message"><%= simple_format(chat_message.message) %></div>
</div>

<style>
  .message * {
    margin: 0;
  }
</style>
