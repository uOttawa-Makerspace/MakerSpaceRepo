<nav class="navbar navbar-staff navbar-expand-xl shadow-sm">
  <div class="container-fluid px-2 px-sm-3 px-xl-2 px-xxl-4 justify-content-start">
    <a class="navbar-brand text-nowrap me-2 me-xxl-3" href="<%= sub_space_booking_index_path %>">Maker<strong>Room</strong></a>
    <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSubSpaceBooking"
            aria-controls="navbarSubSpaceBooking" aria-expanded="false" aria-label="Toggle subspaces header">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSubSpaceBooking">
      <ul class="navbar-nav mx-auto align-items-xl-center">
        <% Space.all.order(:name).each do |space| %>
          <% subspaces = SubSpace.where(space_id: space.id).order(:name) %>
          <% if subspaces.length > 0 %>
            <% if subspaces.length == 1 %>
              <li class="nav-item">
                <%= link_to(subspaces.last.name, sub_space_booking_index_path(room: subspaces.last.id), class: 'nav-link px-xl-1 px-xxl-2 text-nowrap') %>
              </li>
            <% else %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle px-xl-1 px-xxl-2 text-nowrap" role="button" id="dropdownSpace-<%= space.id %>" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <%= space.name %>
                </a>
                <div class="dropdown-menu" aria-labelledby="dropdownSpace-<%= space.id %>">
                  <% subspaces.each do |subspace| %>
                    <a class="dropdown-item" href="<%= sub_space_booking_index_path(room: subspace.id) %>"><%= subspace.name %></a>
                  <% end %>
                </div>
              </li>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
