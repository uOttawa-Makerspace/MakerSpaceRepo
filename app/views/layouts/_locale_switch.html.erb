<%# One language choice of the header: a form post, so a page visit never changes saved data. %>
<%= button_to t('name', locale:), locale_path, method: :patch, class: css,
      params: { locale:, back_to: request.path + (request.query_parameters.except('locale').presence&.then { |q| "?#{q.to_query}" } || '') } %>
