<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= tag.attributes(request_text_attributes) %>>
  <head>
    <%= render 'shared/theme_init' %>
    <title><%= t('getting_started.layout_title') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= favicon_link_tag '/favicon.ico' %>

    <%# Vite Core %>
    <%= vite_client_tag %>
    <%= render 'layouts/head_assets' %>

    <%= csrf_meta_tags %>
  </head>
  <body>
    <%= render 'layouts/skip_link' %>
    <%= render 'layouts/header' %>
    <main class="help-grid" id="main-content" tabindex="-1">
      <%= yield %>
      <div class="help-side-panel">
        <div class="title"><%= link_to t('getting_started.sidebar.help_center'), help_path %> / <%= t('getting_started.sidebar.title') %> </div>
        <ul>
          <%= tag.li(link_to(t('getting_started.sidebar.setting_up_account'), getting_started_sua_path)) %>
          <%= tag.li(link_to(t('getting_started.sidebar.creating_repository'), getting_started_cr_path)) %>
        </ul>
      </div>
      <div class="contact">
        <%= t('getting_started.sidebar.contact_html', contact_link: link_to(t('getting_started.sidebar.contact_link'), '#')) %>
      </div>
    </main>
    <%= render 'layouts/footer' %>
  </body>
</html>
