<%# The cart badge for `order` (local; nil = no open cart: 0). It reads only the order it is given and
    touches no session: current_order (which also clears a stale session[:order_id]) is the caller's choice. %>
<div class="cart-text">
    <%= link_to carts_path, class: 'nav-link' do %>
        <i class="fa-solid fa-cart-shopping fs-2 me-1" aria-hidden="true"></i>
        <span class="visually-hidden"><%= t('common.shopping_cart') %></span>
        <span class="fs-4"><%= order ? order.order_items.size : 0 %></span>
    <% end %>
</div>
