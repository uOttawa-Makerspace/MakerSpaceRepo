<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= yield(:title) %></title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #f5f5f5; color: #212529; text-align: center; }
      main { max-width: 34em; margin: 4em auto 0; padding: 0 1em; }
      h1 { color: #8f001a; font-size: 1.5em; }
      .reference { font-family: monospace; font-size: 1.1em; }
      a { color: #8f001a; }
    </style>
  </head>
  <body>
    <main><%= yield %></main>
  </body>
</html>
