<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-bs-theme="<%= cookies[:theme] %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="color-scheme" content="light dark">

    <%= render 'shared/theme_init' %>

    <%# Critical inline background to eliminate dark-mode flash %>
    <style>
      html[data-bs-theme="dark"],
      html[data-bs-theme="dark"] body {
        background-color: #212529 !important;
        color: #f8f9fa;
      }
    </style>

    <title><%= page_title(yield(:title)) %></title>
    
    <%# Vite Entrypoints %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'application.scss', 'data-turbo-track': 'reload' %>
    <%= vite_javascript_tag 'application', 'data-turbo-track': 'reload' %>
    
    <%# Namespaced and controller-specific JS entrypoints %>
    <% namespaced_entry = controller_path.tr('/', '_') %>
    <% if Rails.root.join("app/javascript/entrypoints/#{controller_name}.js").exist? %>
      <%= vite_javascript_tag controller_name, 'data-turbo-track': 'reload' %>
    <% elsif Rails.root.join("app/javascript/entrypoints/#{namespaced_entry}.js").exist? %>
      <%= vite_javascript_tag namespaced_entry, 'data-turbo-track': 'reload' %>
    <% end %>

    <%# Favicons %>
    <%= favicon_link_tag '/C_square.png' %>
    <%= favicon_link_tag '/apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png' %>

    <% if yield(:insert_turnstile_scripts) %>
      <link rel="preconnect" href="https://challenges.cloudflare.com">
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="MakerRepo is the uOttawa Makerspace's platform. Share and download projects for 3D printers, CNCs, Arduino and much more!" />
  </head>
  <body class="<%= controller_name %> <%= action_name %> <%= "#{controller_name}_#{action_name}" %> <%= controller_path.tr('/', '_') %> <%= 'admin' if controller_path.start_with?('admin') %> <%= 'staff' if controller_path.start_with?('staff') %>">
    <%= render 'layouts/header', with_volunteer: @with_volunteer_header, with_development: @with_development_header %>
    <main <% unless @no_container || provide(:no_container) %> class="container-lg" <% end %>>
      <div class="flash" id="flash" style="padding-left: 20px; padding-right: 20px; z-index: 100;">
        <%= render 'layouts/flash' %>
      </div>
      <%= yield %>
    </main>
    <%= render 'layouts/footer' %>

    <%# Move 3rd-party widget to the bottom of body so it doesn't block CSS/HTML rendering %>
    <script>(function(d){var s = d.createElement("script");s.setAttribute("data-account", "va12Fyrpbl");s.setAttribute("src", "https://cdn.userway.org/widget.js");(d.body || d.head).appendChild(s);})(document)</script>
    <noscript><div id="noscript-warning">Please ensure Javascript is enabled for purposes of <a href="https://userway.org">website accessibility</a></div></noscript>
  </body>
</html>
