<!DOCTYPE html>
<html>
  <head>
    <%= render 'shared/theme_init' %>
    <title><%= page_title(yield(:title), base_title: 'Staff Area | MakerRepo') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= favicon_link_tag '/C_square.png' %>

    <%# Vite Core %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application', 'data-turbo-track': 'reload' %>
    <%= vite_stylesheet_tag 'application.scss', 'data-turbo-track': 'reload' %>
    <%= vite_javascript_tag controller_name if Rails.root.join("app/javascript/entrypoints/#{controller_name}.js").exist? %>

    <%= csrf_meta_tags %>
  </head>
  <body>
    <%= render 'layouts/header', with_staff: true %>
    <%= render partial: 'partials/announcements' %>

    <section id="setting" style="width:100%">
      <%= yield(:before_container) %>
      <div class="container">
        <%= yield %>
      </div>
    </section>
    <%= render 'layouts/footer' %>
  </body>
</html>
