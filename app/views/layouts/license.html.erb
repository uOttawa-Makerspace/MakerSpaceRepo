<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= tag.attributes(request_text_attributes) %>>
  <head>
    <%= render 'shared/theme_init' %>
    <title><%= t('licenses.layout_title') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= favicon_link_tag '/favicon.ico' %>

    <%# Vite Core %>
    <%= vite_client_tag %>
    <%= render 'layouts/head_assets' %>

    <%= csrf_meta_tags %>
  </head>
  <body>
    <%= render 'layouts/skip_link' %>
    <%= render 'layouts/header' %>
    <main class="help-grid" id="main-content" tabindex="-1">
      <%= yield %>
      <div class="help-side-panel">
        <div class="title"><%= t('licenses.sidebar.title') %></div>
        <ul>
          <%= tag.li(link_to(t('licenses.sidebar.cca'), licenses_cca_path)) %>
          <%= tag.li(link_to(t('licenses.sidebar.ccasa'), licenses_ccasa_path)) %>
          <%= tag.li(link_to(t('licenses.sidebar.ccand'), licenses_ccand_path)) %>
          <%= tag.li(link_to(t('licenses.sidebar.ccanc'), licenses_ccanc_path)) %>
          <%= tag.li(link_to(t('licenses.sidebar.ancsa'), licenses_ancsa_path)) %>
          <%= tag.li(link_to(t('licenses.sidebar.ancnd'), licenses_ancnd_path)) %>
        </ul>
      </div>
    </main>
    <%= render 'layouts/footer' %>
    <%= render 'layouts/accessibility_widget' %>
  </body>
</html>
