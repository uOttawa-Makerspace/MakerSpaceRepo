<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= tag.attributes(request_text_attributes) %>>
  <head>
    <%= render 'shared/theme_init' %>
    <title><%= page_title(yield(:title), base_title: 'Admin Area | MakerRepo') %></title>
    <%= favicon_link_tag '/favicon.ico' %>

    <%# Vite Core %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application', 'data-turbo-track': 'reload' %>
    <%= vite_stylesheet_tag 'application.scss', 'data-turbo-track': 'reload' %>
    <%= vite_javascript_tag controller_name if Rails.root.join("app/javascript/entrypoints/#{controller_name}.js").exist? %>

    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="MakerRepo is the uOttawa Makerspace's platform. Share and download projects for 3D printers, CNCs, Arduino and much more!" />
  </head>
  <body>
    <%= render 'layouts/skip_link' %>
    <%= render 'layouts/header', with_admin: true %>
    <%= render partial: 'partials/announcements' %>

    <main class="main flex-grow-1" id="main-content" tabindex="-1">
      <%= yield(:before_container) %>
      <div class="container mt-3">
        <div class="flash" id="flash">
          <%= render 'layouts/flash' %>
        </div>
        <%= yield %>
      </div>
    </main>

    <%= render 'layouts/footer' %>
    <%= render 'layouts/accessibility_widget' %>
  </body>
</html>
