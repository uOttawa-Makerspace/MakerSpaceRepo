<div class="py-3 py-md-4">
  <!-- Top Navigation & Header -->
  <div class="row align-items-center justify-content-between mb-4 g-3">
    <div class="col-12 col-md-auto">
      <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item">
            <%= link_to volunteers_path, class: "text-decoration-none text-body-secondary" do %>
              <i class="fa-solid fa-hand-holding-heart me-1"></i>Volunteers
            <% end %>
          </li>
          <li class="breadcrumb-item">
            <%= link_to calendar_volunteers_path, class: "text-decoration-none text-body-secondary" do %>
              Calendar
            <% end %>
          </li>
          <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Shadowing Shifts</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-body-emphasis mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-user-clock text-primary"></i>
        <span>Shadowing Shifts</span>
      </h1>
      <p class="text-body-secondary small mb-0 mt-1">Manage and track scheduled shadowing shifts across all spaces.</p>
    </div>
    <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
      <%= link_to calendar_volunteers_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center" do %>
        <i class="fa-solid fa-calendar-days"></i>
        <span>View Calendar</span>
      <% end %>
      <% if current_user.staff? || current_user.admin? %>
        <%= link_to new_event_volunteers_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center shadow-sm" do %>
          <i class="fa-solid fa-calendar-plus"></i>
          <span>Add Shadowing Shift</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row g-3 mb-4">
    <div class="col-12 <%= current_user.staff? || current_user.admin? ? 'col-sm-6' : '' %>">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
          <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center p-3 fs-4">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">My Upcoming Shifts</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= @shifts.count %></h2>
          </div>
        </div>
      </div>
    </div>
    <% if current_user.staff? || current_user.admin? %>
      <div class="col-12 col-sm-6">
        <div class="card border rounded-3 shadow-sm bg-body h-100">
          <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
            <div class="rounded-circle bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-center p-3 fs-4">
              <i class="fa-solid fa-users-viewfinder"></i>
            </div>
            <div>
              <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">All Scheduled Volunteer Shifts</h6>
              <h2 class="fw-bold text-body-emphasis mb-0"><%= @all_shifts.count %></h2>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Shifts Main Container Card -->
  <div class="card border rounded-3 shadow-sm bg-body">
    
    <% if current_user.staff? || current_user.admin? %>
      <!-- Tabs for Staff / Admin -->
      <div class="card-header bg-body-tertiary border-bottom p-3 p-md-4">
        <ul class="nav nav-pills gap-2" id="shiftTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold d-inline-flex align-items-center gap-2" id="my-shifts-tab" data-bs-toggle="pill" data-bs-target="#my-shifts" type="button" role="tab" aria-controls="my-shifts" aria-selected="true">
              <i class="fa-solid fa-user"></i>
              <span>My Shifts</span>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1"><%= @shifts.count %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold d-inline-flex align-items-center gap-2" id="all-shifts-tab" data-bs-toggle="pill" data-bs-target="#all-shifts" type="button" role="tab" aria-controls="all-shifts" aria-selected="false">
              <i class="fa-solid fa-users"></i>
              <span>All Volunteer Shifts</span>
              <span class="badge bg-secondary-subtle text-body-secondary border border-secondary-subtle rounded-pill ms-1"><%= @all_shifts.count %></span>
            </button>
          </li>
        </ul>
      </div>
    <% else %>
      <!-- Header for Regular Volunteers -->
      <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4">
        <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
          <i class="fa-solid fa-clock text-primary"></i>
          <span>My Upcoming Shifts</span>
        </h5>
      </div>
    <% end %>

    <div class="<%= 'tab-content' if current_user.staff? || current_user.admin? %>" id="shiftTabsContent">

      <!-- Pane 1: Current User's Shifts -->
      <div class="<%= current_user.staff? || current_user.admin? ? 'tab-pane fade show active' : '' %>" id="my-shifts" role="tabpanel" aria-labelledby="my-shifts-tab">
        <% if @shifts.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-body-secondary border-bottom">
                <tr class="text-body-secondary small text-uppercase">
                  <th class="ps-3 ps-md-4 py-3" scope="col">Space</th>
                  <th class="py-3" scope="col">Date</th>
                  <th class="py-3" scope="col">Shift Time</th>
                  <th class="py-3" scope="col">Duration</th>
                  <% if current_user.staff? || current_user.admin? %>
                    <th class="pe-3 pe-md-4 py-3 text-end" scope="col">Actions</th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% @shifts.each do |s| %>
                  <% start_dt = s.start_time.is_a?(String) ? Time.zone.parse(s.start_time) : s.start_time %>
                  <% end_dt = s.end_time.is_a?(String) ? Time.zone.parse(s.end_time) : s.end_time %>
                  <tr>
                    <!-- Space Badge -->
                    <td class="ps-3 ps-md-4 py-3">
                      <% if s.space&.name&.downcase&.include?("makerspace") %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                          <i class="fa-solid fa-cube"></i>
                          <span><%= s.space.name.capitalize %></span>
                        </span>
                      <% else %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                          <i class="fa-solid fa-industry"></i>
                          <span><%= s.space&.name&.capitalize || "Space" %></span>
                        </span>
                      <% end %>
                    </td>

                    <!-- Date -->
                    <td class="py-3">
                      <div class="fw-semibold text-body-emphasis small">
                        <i class="fa-regular fa-calendar text-secondary me-1"></i>
                        <%= begin
                              start_dt.strftime("%A, %B %d, %Y")
                            rescue StandardError
                              s.start_time
                            end %>
                      </div>
                    </td>

                    <!-- Time Window -->
                    <td class="py-3">
                      <span class="badge bg-body-secondary text-body-emphasis border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                        <i class="fa-regular fa-clock text-secondary"></i>
                        <span><%= begin
                                    start_dt.strftime("%l:%M %p")
                                  rescue StandardError
                                    ""
                                  end %> – <%= begin
                                                                                     end_dt.strftime("%l:%M %p")
                                                                                   rescue StandardError
                                                                                     ""
                                                                                   end %></span>
                      </span>
                    </td>

                    <!-- Duration -->
                    <td class="py-3 text-body-secondary small">
                      <% if start_dt && end_dt %>
                        <%= distance_of_time_in_words(start_dt, end_dt) %>
                      <% else %>
                        —
                      <% end %>
                    </td>

                    <!-- Actions (Staff/Admin) -->
                    <% if current_user.staff? || current_user.admin? %>
                      <td class="pe-3 pe-md-4 py-3 text-end">
                        <%= link_to delete_event_volunteers_path(event_id: s.event_id), class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1", data: { turbo_method: :get, turbo_confirm: "Are you sure you want to cancel this shadowing shift?", confirm: "Are you sure you want to cancel this shadowing shift?" } do %>
                          <i class="fa-solid fa-trash-can"></i>
                          <span>Cancel Shift</span>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Planned Shifts</h5>
            <p class="text-body-secondary small mb-4">You do not have any upcoming shadowing shifts scheduled.</p>
            <% if current_user.staff? || current_user.admin? %>
              <div class="d-flex flex-wrap justify-content-center gap-2">
                <%= link_to new_event_volunteers_path(space: 'makerspace'), class: "btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" do %>
                  <i class="fa-solid fa-cube"></i>
                  <span>Schedule for Makerspace</span>
                <% end %>
                <%= link_to new_event_volunteers_path(space: 'brunsfield centre'), class: "btn btn-outline-warning btn-sm d-inline-flex align-items-center gap-1" do %>
                  <i class="fa-solid fa-industry"></i>
                  <span>Schedule for Brunsfield</span>
                <% end %>
              </div>
            <% else %>
              <%= link_to calendar_volunteers_path, class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" do %>
                <i class="fa-solid fa-calendar-days"></i>
                <span>Check Calendar</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Pane 2: All Shifts (Staff Only) -->
      <% if current_user.staff? || current_user.admin? %>
        <div class="tab-pane fade" id="all-shifts" role="tabpanel" aria-labelledby="all-shifts-tab">
          <% if @all_shifts.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-body-secondary border-bottom">
                  <tr class="text-body-secondary small text-uppercase">
                    <th class="ps-3 ps-md-4 py-3" scope="col">Volunteer</th>
                    <th class="py-3" scope="col">Space</th>
                    <th class="py-3" scope="col">Date</th>
                    <th class="py-3" scope="col">Shift Time</th>
                    <th class="pe-3 pe-md-4 py-3 text-end" scope="col">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y">
                  <% @all_shifts.each do |s| %>
                    <% start_dt = s.start_time.is_a?(String) ? Time.zone.parse(s.start_time) : s.start_time %>
                    <% end_dt = s.end_time.is_a?(String) ? Time.zone.parse(s.end_time) : s.end_time %>
                    <tr>
                      <!-- Volunteer Info -->
                      <td class="ps-3 ps-md-4 py-3">
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center small flex-shrink-0" style="width: 34px; height: 34px;">
                            <%= s.user&.name&.first&.upcase || "V" %>
                          </div>
                          <div>
                            <% if s.user %>
                              <%= link_to user_path(s.user.username), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm small" do %>
                                <%= s.user.name.titleize %>
                              <% end %>
                              <span class="text-body-secondary small"><%= s.user.email %></span>
                            <% else %>
                              <span class="text-body-secondary small fst-italic">Unassigned User</span>
                            <% end %>
                          </div>
                        </div>
                      </td>

                      <!-- Space -->
                      <td class="py-3">
                        <% if s.space&.name&.downcase&.include?("makerspace") %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                            <i class="fa-solid fa-cube"></i>
                            <span><%= s.space.name.capitalize %></span>
                          </span>
                        <% else %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                            <i class="fa-solid fa-industry"></i>
                            <span><%= s.space&.name&.capitalize || "Space" %></span>
                          </span>
                        <% end %>
                      </td>

                      <!-- Date -->
                      <td class="py-3">
                        <div class="fw-semibold text-body-emphasis small">
                          <i class="fa-regular fa-calendar text-secondary me-1"></i>
                          <%= begin
                                start_dt.strftime("%A, %B %d, %Y")
                              rescue StandardError
                                s.start_time
                              end %>
                        </div>
                      </td>

                      <!-- Shift Time -->
                      <td class="py-3">
                        <span class="badge bg-body-secondary text-body-emphasis border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                          <i class="fa-regular fa-clock text-secondary"></i>
                          <span><%= begin
                                      start_dt.strftime("%l:%M %p")
                                    rescue StandardError
                                      ""
                                    end %> – <%= begin
                                                                                       end_dt.strftime("%l:%M %p")
                                                                                     rescue StandardError
                                                                                       ""
                                                                                     end %></span>
                        </span>
                      </td>

                      <!-- Cancel Action -->
                      <td class="pe-3 pe-md-4 py-3 text-end">
                        <%= link_to delete_event_volunteers_path(event_id: s.event_id), class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1", data: { turbo_method: :get, turbo_confirm: "Are you sure you want to cancel #{s.user&.name}'s shadowing shift?", confirm: "Are you sure you want to cancel #{s.user&.name}'s shadowing shift?" } do %>
                          <i class="fa-solid fa-trash-can"></i>
                          <span>Cancel Shift</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5 px-3">
              <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
                <i class="fa-solid fa-calendar-check"></i>
              </div>
              <h5 class="fw-bold text-body-emphasis">No Shifts Scheduled</h5>
              <p class="text-body-secondary small mb-3">There are currently no volunteer shadowing shifts planned across any space.</p>
              <%= link_to new_event_volunteers_path, class: "btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" do %>
                <i class="fa-solid fa-calendar-plus"></i>
                <span>Add Shadowing Shift</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
