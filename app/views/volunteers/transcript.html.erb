<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Volunteer Service Record & Transcript - <%= @volunteer.name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #212529;
      background: #f4f6f8;
      margin: 0;
      padding: 0;
    }
    .transcript-card {
      max-width: 900px;
      margin: 30px auto;
      background: #ffffff;
      padding: 48px;
      border: 1px solid #dee2e6;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }
    .brand-border {
      border-bottom: 3px solid #8f001a; /* uOttawa Garnet */
      padding-bottom: 20px;
      margin-bottom: 28px;
    }
    .institution-name {
      color: #8f001a;
      font-weight: 800;
      font-size: 1.55rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .document-title {
      font-size: 1.15rem;
      font-weight: 600;
      color: #495057;
      margin-top: 4px;
    }
    .kpi-box {
      border: 1px solid #dee2e6;
      background-color: #f8f9fa;
      border-radius: 8px;
      padding: 16px;
      text-align: center;
    }
    .table-custom th {
      background-color: #f1f3f5;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #495057;
    }
    .signature-line {
      border-top: 1px solid #adb5bd;
      width: 240px;
      padding-top: 6px;
      font-size: 0.82rem;
      color: #6c757d;
      text-align: center;
    }

    @media print {
      body {
        background: #ffffff !important;
        margin: 0 !important;
      }
      .transcript-card {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
      }
      .no-print {
        display: none !important;
      }
      @page {
        margin: 1.6cm;
        size: auto;
      }
    }
  </style>
</head>
<body>

<!-- Print Controls (hidden when printing) -->
<div class="no-print bg-dark text-white py-3 px-4 mb-3 shadow-sm">
  <div class="container-xl d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div class="d-flex align-items-center gap-2">
      <i class="fa-solid fa-file-invoice text-warning fs-5"></i>
      <span class="fw-semibold">Volunteer Service Record &amp; Official Transcript</span>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" onclick="window.print()" class="btn btn-primary btn-sm px-3 fw-bold d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-print"></i>
        <span>Print or Save as PDF</span>
      </button>
      <button type="button" onclick="window.close()" class="btn btn-outline-light btn-sm px-3">
        Close Window
      </button>
    </div>
  </div>
</div>

<div class="transcript-card">
  <!-- Header -->
  <div class="brand-border d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
    <div>
      <div class="institution-name">University of Ottawa Makerspace</div>
      <div class="document-title">Official Volunteer Service Record &amp; Transcript</div>
      <div class="text-body-secondary small mt-1">Richard L’Abbé Makerspace &amp; Brunsfield Centre</div>
    </div>
    <div class="text-sm-end text-body-secondary small">
      <div><strong>Date Issued:</strong> <%= Date.current.strftime('%B %d, %Y') %></div>
      <div><strong>Verification Handle:</strong> @<%= @volunteer.username %></div>
      <div><strong>Status:</strong> <span class="badge bg-success-subtle text-success border border-success-subtle">Verified Member</span></div>
    </div>
  </div>

  <!-- Volunteer Profile & Summary Metrics -->
  <div class="row g-3 mb-4 align-items-center">
    <div class="col-12 col-md-7">
      <table class="table table-sm table-borderless mb-0">
        <tbody>
          <tr>
            <td class="text-secondary small text-uppercase fw-semibold" style="width: 140px;">Volunteer Name:</td>
            <td class="fw-bold fs-5 text-body-emphasis"><%= @volunteer.name %></td>
          </tr>
          <tr>
            <td class="text-secondary small text-uppercase fw-semibold">Username:</td>
            <td class="font-monospace text-body-secondary">@<%= @volunteer.username %></td>
          </tr>
          <tr>
            <td class="text-secondary small text-uppercase fw-semibold">Email:</td>
            <td><%= @volunteer.email %></td>
          </tr>
          <% if @volunteer.faculty.present? || @volunteer.program.present? %>
            <tr>
              <td class="text-secondary small text-uppercase fw-semibold">Program:</td>
              <td><%= [@volunteer.faculty, @volunteer.program].compact_blank.join(' · ') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="col-12 col-md-5">
      <div class="row g-2">
        <div class="col-6">
          <div class="kpi-box">
            <div class="text-secondary small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem;">Verified Hours</div>
            <div class="fs-3 fw-bold text-success"><%= @total_hours %></div>
            <div class="text-muted small">Hours Logged</div>
          </div>
        </div>
        <div class="col-6">
          <div class="kpi-box">
            <div class="text-secondary small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem;">Total Rewards</div>
            <div class="fs-3 fw-bold text-primary"><%= @total_cc %></div>
            <div class="text-muted small">CC Points Earned</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Completed Volunteer Tasks & Contributions -->
  <div class="mb-4">
    <h6 class="fw-bold text-uppercase text-body-emphasis border-bottom pb-2 mb-3 d-flex align-items-center justify-content-between">
      <span>Completed Volunteer Tasks &amp; Responsibilities</span>
      <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle rounded-pill small">
        <%= @approved_task_requests.size %> <%= "Task".pluralize(@approved_task_requests.size) %> Completed
      </span>
    </h6>

    <% if @approved_task_requests.present? %>
      <div class="table-responsive">
        <table class="table table-bordered table-custom align-middle mb-0">
          <thead>
            <tr>
              <th scope="col" class="ps-3 py-2">Task Title &amp; Category</th>
              <th scope="col" class="py-2">Facility / Space</th>
              <th scope="col" class="py-2">Completion Date</th>
              <th scope="col" class="py-2 text-center">Reward (CC)</th>
              <th scope="col" class="pe-3 py-2 text-end">Service Hours</th>
            </tr>
          </thead>
          <tbody>
            <% @approved_task_requests.each do |req| %>
              <% vt = req.volunteer_task %>
              <% next if vt.blank? %>
              <tr>
                <td class="ps-3 py-2">
                  <span class="fw-bold text-body-emphasis d-block lh-sm"><%= vt.title %></span>
                  <span class="badge bg-secondary-subtle text-body-secondary border border-secondary-subtle small mt-1"><%= vt.category %></span>
                </td>
                <td class="py-2">
                  <%= vt.space&.name || "Makerspace" %>
                </td>
                <td class="py-2 small text-nowrap">
                  <%= req.updated_at.strftime('%B %d, %Y') %>
                </td>
                <td class="py-2 text-center fw-semibold text-warning-emphasis">
                  <%= vt.cc %> CC
                </td>
                <td class="pe-3 py-2 text-end fw-bold text-success">
                  <%= vt.hours %> hrs
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="table-light fw-bold">
              <td colspan="4" class="text-end text-uppercase py-2">Total Verified Volunteer Hours:</td>
              <td class="pe-3 text-end text-success py-2 fs-6"><%= @total_hours %> hrs</td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="p-4 border rounded text-center text-muted bg-light">
        No completed volunteer tasks are on record for this user.
      </div>
    <% end %>
  </div>

  <!-- Machine & Tool Qualifications -->
  <% if @certifications.present? %>
    <div class="mb-4">
      <h6 class="fw-bold text-uppercase text-body-emphasis border-bottom pb-2 mb-3">
        Machine &amp; Tool Qualifications (Certifications)
      </h6>
      <div class="row g-2">
        <% @certifications.each do |cert| %>
          <div class="col-6 col-sm-4">
            <div class="border rounded p-2 bg-light">
              <div class="fw-bold small text-body-emphasis"><%= cert.training.localized_name %></div>
              <div class="text-body-secondary small">Level <%= cert.training_session.level %> · <%= cert.created_at.strftime('%b %Y') %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Verification Note & Signatures -->
  <div class="mt-5 pt-3">
    <div class="small text-muted mb-4 fst-italic">
      This document certifies that the individual named above has actively completed the recorded volunteer service tasks and training milestones under the supervision of Makerspace staff at the University of Ottawa.
    </div>
    <div class="d-flex justify-content-between align-items-end pt-3">
      <div class="signature-line">
        <strong>Richard L'Abbé Makerspace</strong>
        <div>Faculty of Engineering</div>
      </div>
      <div class="signature-line">
        <strong>Authorized Signatory / Staff</strong>
        <div>University of Ottawa</div>
      </div>
    </div>
  </div>
</div>

</body>
</html>