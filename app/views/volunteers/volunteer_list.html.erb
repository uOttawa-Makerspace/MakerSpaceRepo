<div class="py-3 py-md-4" data-controller="volunteer-search">
  <!-- Header & Breadcrumb -->
  <div class="row align-items-center justify-content-between mb-4 g-3">
    <div class="col-12 col-md-auto">
      <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item">
            <%= link_to volunteers_path, class: "text-decoration-none text-body-secondary" do %>
              <i class="fa-solid fa-hand-holding-heart me-1"></i>Volunteers
            <% end %>
          </li>
          <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Directory</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-body-emphasis mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-users text-primary"></i>
        <span>Volunteer Directory</span>
      </h1>
      <p class="text-body-secondary small mb-0 mt-1">Review active and inactive volunteers, assigned tasks, and certifications.</p>
    </div>
    <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
      <%= link_to emails_volunteers_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center" do %>
        <i class="fa-solid fa-envelope"></i>
        <span>Email Lists</span>
      <% end %>
      <%= link_to volunteer_tasks_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center shadow-sm" do %>
        <i class="fa-solid fa-list-check"></i>
        <span>Volunteer Tasks</span>
      <% end %>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
          <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center p-3 fs-4">
            <i class="fa-solid fa-user-check"></i>
          </div>
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Active Volunteers</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= @active_volunteers.size %></h2>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
          <div class="rounded-circle bg-secondary-subtle text-body-secondary d-flex align-items-center justify-content-center p-3 fs-4">
            <i class="fa-solid fa-user-clock"></i>
          </div>
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Inactive Volunteers</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= @unactive_volunteers.size %></h2>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Card with Search & Tabs -->
  <div class="card border rounded-3 shadow-sm bg-body">
    <div class="card-header bg-body-tertiary border-bottom p-3 p-md-4">
      <div class="row align-items-center justify-content-between g-3">
        <!-- Tabs Navigation -->
        <div class="col-12 col-md-auto">
          <ul class="nav nav-pills gap-2" id="volunteerTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active fw-semibold d-inline-flex align-items-center gap-2" id="active-tab" data-bs-toggle="pill" data-bs-target="#active-volunteers" type="button" role="tab" aria-controls="active-volunteers" aria-selected="true">
                <i class="fa-solid fa-circle-check text-success"></i>
                <span>Active</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1" data-volunteer-search-target="activeCount"><%= @active_volunteers.size %></span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link fw-semibold d-inline-flex align-items-center gap-2" id="inactive-tab" data-bs-toggle="pill" data-bs-target="#inactive-volunteers" type="button" role="tab" aria-controls="inactive-volunteers" aria-selected="false">
                <i class="fa-solid fa-circle-pause text-secondary"></i>
                <span>Inactive</span>
                <span class="badge bg-secondary-subtle text-body-secondary border border-secondary-subtle rounded-pill ms-1" data-volunteer-search-target="inactiveCount"><%= @unactive_volunteers.size %></span>
              </button>
            </li>
          </ul>
        </div>

        <!-- Live Search Bar -->
        <div class="col-12 col-md-6 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text"
                   class="form-control"
                   placeholder="Search volunteers by name, email, task, cert..."
                   aria-label="Search volunteers"
                   data-volunteer-search-target="input"
                   data-action="input->volunteer-search#filter">
            <button class="btn btn-outline-secondary border-secondary-subtle d-none"
                    type="button"
                    title="Clear search"
                    data-volunteer-search-target="clearButton"
                    data-action="click->volunteer-search#clear">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-content" id="volunteerTabsContent">
      <!-- Active Volunteers Pane -->
      <div class="tab-pane fade show active" id="active-volunteers" role="tabpanel" aria-labelledby="active-tab">
        <% if @active_volunteers.any? %>
          <div class="table-responsive" data-volunteer-search-target="activeTableContainer">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-body-secondary border-bottom">
                <tr class="text-body-secondary small text-uppercase">
                  <th class="ps-3 ps-md-4 py-3" scope="col">Volunteer</th>
                  <th class="py-3" scope="col">Contact</th>
                  <th class="py-3" scope="col">Active Tasks</th>
                  <th class="py-3" scope="col">Education</th>
                  <th class="pe-3 pe-md-4 py-3" scope="col">Certifications</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% @active_volunteers.each do |v| %>
                  <tr data-volunteer-search-target="activeRow">
                    <!-- Volunteer Name & Avatar -->
                    <td class="ps-3 ps-md-4 py-3">
                      <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center fs-6 flex-shrink-0" style="width: 40px; height: 40px;">
                          <%= v.name.to_s.first&.upcase || "V" %>
                        </div>
                        <div>
                          <%= link_to user_path(v.username), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" do %>
                            <%= v.name.to_s.titleize %>
                          <% end %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small mt-1">
                            <i class="fa-solid fa-circle fa-2xs me-1"></i>Active
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Contact -->
                    <td class="py-3">
                      <%= mail_to v.email, class: "text-body text-decoration-none d-inline-flex align-items-center gap-1 small" do %>
                        <i class="fa-regular fa-envelope text-body-secondary"></i>
                        <span><%= v.email %></span>
                      <% end %>
                    </td>

                    <!-- Active Tasks -->
                    <td class="py-3">
                      <% active_joins = v.volunteer_task_joins.select(&:active) %>
                      <% if active_joins.any? %>
                        <div class="d-flex flex-column gap-1">
                          <% active_joins.each do |vtj| %>
                            <% if vtj.volunteer_task %>
                              <%= link_to volunteer_task_path(vtj.volunteer_task_id), class: "badge bg-info-subtle text-info-emphasis border border-info-subtle text-decoration-none text-start text-truncate d-inline-flex align-items-center gap-1 p-2", style: "max-width: 220px;" do %>
                                <i class="fa-solid fa-list-check"></i>
                                <span><%= vtj.volunteer_task.title %></span>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-body-secondary small fst-italic">No active tasks</span>
                      <% end %>
                    </td>

                    <!-- Education / Program -->
                    <td class="py-3">
                      <div>
                        <% if v.program.present? %>
                          <div class="fw-semibold text-body-emphasis small"><%= v.program %></div>
                        <% end %>
                        <% if v.year_of_study.present? %>
                          <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle small mt-1">
                            Year <%= v.year_of_study %>
                          </span>
                        <% end %>
                        <% if v.program.blank? && v.year_of_study.blank? %>
                          <span class="text-body-secondary small fst-italic">Not specified</span>
                        <% end %>
                      </div>
                    </td>

                    <!-- Certifications -->
                    <td class="pe-3 pe-md-4 py-3">
                      <% if v.certifications.any? %>
                        <div class="d-flex flex-wrap gap-1">
                          <% v.certifications.each do |cert| %>
                            <% training_name = cert.training&.localized_name %>
                            <% if training_name.present? %>
                              <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                                <i class="fa-solid fa-award"></i>
                                <span><%= training_name %></span>
                                <% if cert.training_session&.level.present? %>
                                  <span class="badge bg-body text-body-emphasis rounded-pill ms-1"><%= cert.training_session.level %></span>
                                <% end %>
                              </span>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-body-secondary small fst-italic">No certifications</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Active Search Empty State -->
          <div class="text-center py-5 px-3 d-none" data-volunteer-search-target="activeEmpty">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Matching Active Volunteers</h5>
            <p class="text-body-secondary small mb-3">No active volunteers match your current search query.</p>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->volunteer-search#clear">
              <i class="fa-solid fa-rotate-left me-1"></i>Reset Search
            </button>
          </div>
        <% else %>
          <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-user-slash"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Active Volunteers</h5>
            <p class="text-body-secondary small mb-0">Currently, there are no volunteers marked as active in the program.</p>
          </div>
        <% end %>
      </div>

      <!-- Inactive Volunteers Pane -->
      <div class="tab-pane fade" id="inactive-volunteers" role="tabpanel" aria-labelledby="inactive-tab">
        <% if @unactive_volunteers.any? %>
          <div class="table-responsive" data-volunteer-search-target="inactiveTableContainer">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-body-secondary border-bottom">
                <tr class="text-body-secondary small text-uppercase">
                  <th class="ps-3 ps-md-4 py-3" scope="col">Volunteer</th>
                  <th class="py-3" scope="col">Contact</th>
                  <th class="py-3" scope="col">Previous Tasks</th>
                  <th class="py-3" scope="col">Education</th>
                  <th class="pe-3 pe-md-4 py-3" scope="col">Certifications</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% @unactive_volunteers.each do |v| %>
                  <tr data-volunteer-search-target="inactiveRow">
                    <!-- Volunteer Name & Avatar -->
                    <td class="ps-3 ps-md-4 py-3">
                      <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-secondary-subtle text-body-secondary fw-bold d-flex align-items-center justify-content-center fs-6 flex-shrink-0" style="width: 40px; height: 40px;">
                          <%= v.name.to_s.first&.upcase || "V" %>
                        </div>
                        <div>
                          <%= link_to user_path(v.username), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" do %>
                            <%= v.name.to_s.titleize %>
                          <% end %>
                          <span class="badge bg-secondary-subtle text-body-secondary border border-secondary-subtle rounded-pill small mt-1">
                            <i class="fa-solid fa-circle fa-2xs me-1"></i>Inactive
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Contact -->
                    <td class="py-3">
                      <%= mail_to v.email, class: "text-body text-decoration-none d-inline-flex align-items-center gap-1 small" do %>
                        <i class="fa-regular fa-envelope text-body-secondary"></i>
                        <span><%= v.email %></span>
                      <% end %>
                    </td>

                    <!-- Previous Tasks -->
                    <td class="py-3">
                      <% if v.volunteer_task_joins.any? %>
                        <div class="d-flex flex-column gap-1">
                          <% v.volunteer_task_joins.each do |vtj| %>
                            <% if vtj.volunteer_task %>
                              <%= link_to volunteer_task_path(vtj.volunteer_task_id), class: "badge bg-secondary-subtle text-body-secondary border border-secondary-subtle text-decoration-none text-start text-truncate d-inline-flex align-items-center gap-1 p-2", style: "max-width: 220px;" do %>
                                <i class="fa-solid fa-list-check"></i>
                                <span><%= vtj.volunteer_task.title %></span>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-body-secondary small fst-italic">No tasks assigned</span>
                      <% end %>
                    </td>

                    <!-- Education / Program -->
                    <td class="py-3">
                      <div>
                        <% if v.program.present? %>
                          <div class="fw-semibold text-body-emphasis small"><%= v.program %></div>
                        <% end %>
                        <% if v.year_of_study.present? %>
                          <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle small mt-1">
                            Year <%= v.year_of_study %>
                          </span>
                        <% end %>
                        <% if v.program.blank? && v.year_of_study.blank? %>
                          <span class="text-body-secondary small fst-italic">Not specified</span>
                        <% end %>
                      </div>
                    </td>

                    <!-- Certifications -->
                    <td class="pe-3 pe-md-4 py-3">
                      <% if v.certifications.any? %>
                        <div class="d-flex flex-wrap gap-1">
                          <% v.certifications.each do |cert| %>
                            <% training_name = cert.training&.localized_name %>
                            <% if training_name.present? %>
                              <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                                <i class="fa-solid fa-award"></i>
                                <span><%= training_name %></span>
                                <% if cert.training_session&.level.present? %>
                                  <span class="badge bg-body text-body-emphasis rounded-pill ms-1"><%= cert.training_session.level %></span>
                                <% end %>
                              </span>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-body-secondary small fst-italic">No certifications</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Inactive Search Empty State -->
          <div class="text-center py-5 px-3 d-none" data-volunteer-search-target="inactiveEmpty">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Matching Inactive Volunteers</h5>
            <p class="text-body-secondary small mb-3">No inactive volunteers match your current search query.</p>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->volunteer-search#clear">
              <i class="fa-solid fa-rotate-left me-1"></i>Reset Search
            </button>
          </div>
        <% else %>
          <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-user-check"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Inactive Volunteers</h5>
            <p class="text-body-secondary small mb-0">All registered volunteers are currently active.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
