<section id="volunteersIndex" class="mt-n3">

  <!-- 1. Hero Banner -->
  <div class="volunteerJumbotron d-flex align-items-center text-white py-5 px-3 px-md-5">
    <div class="container py-4">
      <div class="col-lg-8">
        <h1 class="display-3 fw-bold mb-2 text-white">
          <%= t('volunteers.hero.title_html') %>
        </h1>
        <p class="fs-3 text-white-50 mb-4 fw-medium"><%= t('volunteers.hero.subtitle') %></p>

        <%= button_to t('volunteers.hero.join_button'),
                    join_volunteer_program_volunteers_path,
                    method: :post,
                    class: 'btn btn-ceed btn-lg px-4 py-3 rounded-pill fs-6 fw-bold shadow' %>
      </div>
    </div>
  </div>

  <div class="shadow-sm">
    <%= render partial: 'layouts/volunteer_header' %>
  </div>

  <!-- 2. Why Volunteer Section -->
  <div class="bg-body-tertiary py-5 border-bottom">
    <div class="container text-center py-3">
      <h2 class="display-5 fw-bold mb-5 text-body">
        <%= t('volunteers.why_volunteer.title_html') %>
      </h2>

      <div class="row row-cols-1 row-cols-md-5 g-4 justify-content-center">
        <div class="col">
          <div class="icon-circle mb-3">
            <i class="fa fa-wrench fa-2x"></i>
          </div>
          <h3 class="h5 fw-bold mb-2 text-body"><%= t('volunteers.why_volunteer.cards.experience.title') %></h3>
          <p class="small text-body-secondary mb-0"><%= t('volunteers.why_volunteer.cards.experience.desc') %></p>
        </div>
        <div class="col">
          <div class="icon-circle mb-3">
            <i class="fa fa-graduation-cap fa-2x"></i>
          </div>
          <h3 class="h5 fw-bold mb-2 text-body"><%= t('volunteers.why_volunteer.cards.skills.title') %></h3>
          <p class="small text-body-secondary mb-0"><%= t('volunteers.why_volunteer.cards.skills.desc') %></p>
        </div>
        <div class="col">
          <div class="icon-circle mb-3">
            <i class="fa fa-users fa-2x"></i>
          </div>
          <h3 class="h5 fw-bold mb-2 text-body"><%= t('volunteers.why_volunteer.cards.community.title') %></h3>
          <p class="small text-body-secondary mb-0"><%= t('volunteers.why_volunteer.cards.community.desc') %></p>
        </div>
        <div class="col">
          <div class="icon-circle mb-3">
            <i class="fa fa-briefcase fa-2x"></i>
          </div>
          <h3 class="h5 fw-bold mb-2 text-body"><%= t('volunteers.why_volunteer.cards.career.title') %></h3>
          <p class="small text-body-secondary mb-0"><%= t('volunteers.why_volunteer.cards.career.desc') %></p>
        </div>
        <div class="col">
          <div class="icon-circle mb-3">
            <i class="fa fa-heart fa-2x"></i>
          </div>
          <h3 class="h5 fw-bold mb-2 text-body"><%= t('volunteers.why_volunteer.cards.impact.title') %></h3>
          <p class="small text-body-secondary mb-0"><%= t('volunteers.why_volunteer.cards.impact.desc') %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Choose How You'd Like To Get Involved (3-Column Dropdowns) -->
  <div class="bg-body py-5">
    <div class="container py-3 text-center">
      <h2 class="display-5 fw-bold mb-2 text-body"><%= t('volunteers.involvement.title') %></h2>
      <p class="lead text-body-secondary mb-5 mx-auto" style="max-width: 760px;">
        <%= t('volunteers.involvement.subtitle') %>
      </p>

      <div class="row g-4 text-start align-items-start">

        <!-- Column 1: Event Volunteer -->
        <div class="col-12 col-lg-4">
          <div class="card bg-body border shadow-sm rounded-4 overflow-hidden mb-3">
            <button class="ceed-card-header text-white"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#eventCardBody"
                    aria-expanded="true"
                    aria-controls="eventCardBody">
              <span><%= t('volunteers.involvement.types.event.title') %></span>
              <i class="fa fa-chevron-down chevron-icon"></i>
            </button>

            <div id="eventCardBody" class="collapse show">
              <div class="card-inner-wrapper">
                <!-- Sub-Dropdown 1: Involvement -->
                <div class="accordion-item">
                  <button class="accordion-button-custom"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#eventInvolvement"
                          aria-expanded="true"
                          aria-controls="eventInvolvement">
                    <span><i class="fa fa-handshake-o text-danger me-2"></i> <%= t('volunteers.involvement.labels.involvement') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="eventInvolvement" class="collapse show">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.event.involvement').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>

                <!-- Sub-Dropdown 2: Requirements -->
                <div class="accordion-item">
                  <button class="accordion-button-custom collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#eventReqs"
                          aria-expanded="false"
                          aria-controls="eventReqs">
                    <span><i class="fa fa-file-text-o text-primary me-2"></i> <%= t('volunteers.involvement.labels.requirements') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="eventReqs" class="collapse">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.event.requirements').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="text-center px-3 mb-4">
            <p class="text-body-secondary small mb-1"><%= t('volunteers.involvement.types.event.desc') %></p>
            <p class="fw-bold fst-italic text-body mb-0"><%= t('volunteers.involvement.types.event.badge') %></p>
          </div>
        </div>

        <!-- Column 2: Weekly Space Volunteer -->
        <div class="col-12 col-lg-4">
          <div class="card bg-body border shadow-sm rounded-4 overflow-hidden mb-3">
            <button class="ceed-card-header text-white"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#spaceCardBody"
                    aria-expanded="true"
                    aria-controls="spaceCardBody">
              <span><%= t('volunteers.involvement.types.space.title') %></span>
              <i class="fa fa-chevron-down chevron-icon"></i>
            </button>

            <div id="spaceCardBody" class="collapse show">
              <div class="card-inner-wrapper">
                <!-- Sub-Dropdown 1: Involvement -->
                <div class="accordion-item">
                  <button class="accordion-button-custom"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#spaceInvolvement"
                          aria-expanded="true"
                          aria-controls="spaceInvolvement">
                    <span><i class="fa fa-handshake-o text-danger me-2"></i> <%= t('volunteers.involvement.labels.involvement') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="spaceInvolvement" class="collapse show">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.space.involvement').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>

                <!-- Sub-Dropdown 2: Requirements -->
                <div class="accordion-item">
                  <button class="accordion-button-custom collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#spaceReqs"
                          aria-expanded="false"
                          aria-controls="spaceReqs">
                    <span><i class="fa fa-file-text-o text-primary me-2"></i> <%= t('volunteers.involvement.labels.requirements') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="spaceReqs" class="collapse">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.space.requirements').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="text-center px-3 mb-4">
            <p class="text-body-secondary small mb-1"><%= t('volunteers.involvement.types.space.desc') %></p>
            <p class="fw-bold fst-italic text-body mb-0"><%= t('volunteers.involvement.types.space.badge') %></p>
          </div>
        </div>

        <!-- Column 3: Project Based-Volunteer -->
        <div class="col-12 col-lg-4">
          <div class="card bg-body border shadow-sm rounded-4 overflow-hidden mb-3">
            <button class="ceed-card-header text-white"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#projectCardBody"
                    aria-expanded="true"
                    aria-controls="projectCardBody">
              <span><%= t('volunteers.involvement.types.project.title') %></span>
              <i class="fa fa-chevron-down chevron-icon"></i>
            </button>

            <div id="projectCardBody" class="collapse show">
              <div class="card-inner-wrapper">
                <!-- Sub-Dropdown 1: Involvement -->
                <div class="accordion-item">
                  <button class="accordion-button-custom"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#projectInvolvement"
                          aria-expanded="true"
                          aria-controls="projectInvolvement">
                    <span><i class="fa fa-handshake-o text-danger me-2"></i> <%= t('volunteers.involvement.labels.involvement') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="projectInvolvement" class="collapse show">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.project.involvement').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>

                <!-- Sub-Dropdown 2: Requirements -->
                <div class="accordion-item">
                  <button class="accordion-button-custom collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#projectReqs"
                          aria-expanded="false"
                          aria-controls="projectReqs">
                    <span><i class="fa fa-file-text-o text-primary me-2"></i> <%= t('volunteers.involvement.labels.requirements') %></span>
                    <i class="fa fa-chevron-down chevron-icon"></i>
                  </button>
                  <div id="projectReqs" class="collapse">
                    <div class="accordion-content">
                      <ul class="mb-0">
                        <% t('volunteers.involvement.types.project.requirements').each do |item| %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="text-center px-3 mb-4">
            <p class="text-body-secondary small mb-1"><%= t('volunteers.involvement.types.project.desc') %></p>
            <p class="fw-bold fst-italic text-body mb-0"><%= t('volunteers.involvement.types.project.badge') %></p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- 4. Ready To Get Involved Banner (Full Exact Canva Spec) -->
