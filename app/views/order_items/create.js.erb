<% if @order.errors.any? || @order_item.errors.any? %>
  alert("not valid.");
  alert("<%= @order.errors.messages %>");
<% else %>
  document.getElementsByClassName("cart-text")[0].innerHTML = "<%= escape_javascript(render 'layouts/cart_text', order: @order) %>" %>
  // Display a success toast
  document.dispatchEvent(new CustomEvent("toast:show", { detail: <%= raw({ message: "Item added to Cart. Go to ", type: "success", link: { text: "Checkout", href: carts_path } }.to_json) %> }));
<% end %>
