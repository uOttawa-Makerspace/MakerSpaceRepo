<% content_for :preheader, "#{@items.size} background jobs failed or are overdue" %>
<% content_for :team_name, "Makerspace Team" %>
<% content_for :why_received, "You received this email because your address is the maintenance notification address." %>

<h2 style="color: #000000; font-family: sans-serif; font-weight: 400; line-height: 1.4; margin: 0; margin-bottom: 30px;">Background jobs need attention</h2>

<p style="font-family: sans-serif; font-size: 14px;">Review them in the queue dashboard at /solid_queue (retry or discard). Each is reported once.</p>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; font-family: sans-serif; font-size: 14px;">
  <% @items.each do |item| %>
    <tr>
      <td style="padding: 6px 0; border-bottom: 1px solid #dddddd;">
        <strong><%= item.kind %></strong>: <%= item.class_name %> (queue <%= item.queue_name %>, job <%= item.job_id %>)<br>
        <%= item.detail %>
      </td>
    </tr>
  <% end %>
</table>
