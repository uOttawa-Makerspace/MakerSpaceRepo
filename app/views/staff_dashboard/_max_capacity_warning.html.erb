<% if @space.max_capacity.present? && !@space.max_capacity.nil? && @space.max_capacity > 0 %>

  <% if @space.signed_in_users.count == @space.max_capacity %>
    <div class="alert alert-danger text-center" role="alert">
      <b><%= t('staff_dashboard.capacity.reached') %></b>
      <br>
      <%= t('staff_dashboard.capacity.do_not_allow') %>
      <br>
      <%= t('staff_dashboard.capacity.current_html', count: @space.signed_in_users.count, max: @space.max_capacity) %>
    </div>
  <% elsif @space.signed_in_users.count > @space.max_capacity %>
    <script type="text/javascript" charset="utf-8">
      alert("<%= raw j(t('staff_dashboard.capacity.over_alert')) %>")
    </script>
    <div class="alert alert-danger text-center" role="alert">
      <h5 style="color: #721c24"><%= t('staff_dashboard.capacity.over_html') %></h5>
      <%= t('staff_dashboard.capacity.do_not_allow') %>
      <br>
      <%= t('staff_dashboard.capacity.current_html', count: @space.signed_in_users.count, max: @space.max_capacity) %>
    </div>
  <% elsif (@space.signed_in_users.count + 3) >= @space.max_capacity %>
    <div class="alert alert-warning text-center" role="alert">
      <%= t('staff_dashboard.capacity.almost_reached') %>
      <br>
      <%= t('staff_dashboard.capacity.current_html', count: @space.signed_in_users.count, max: @space.max_capacity) %>
    </div>
  <% end %>

<% end %>