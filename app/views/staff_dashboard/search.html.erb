<section class="page-contents">
  <br>
  <h2 class="text-center"><%= t('staff_dashboard.welcome_to') %>
    <strong><%= select_tag :space_id, options_from_collection_for_select(@all_spaces, :id, :name, @space.id), id: 'set_space_id', aria: { label: t('common.names.space') }, class: 'form-select', onchange: 'setSpace()' %></strong>
  </h2>
  <%= render "staff_dashboard/no_assigned_spaces" %>
  <%= render 'search' %>
  <br />
  <% if @users.any? %>
    <table class="table table-striped" id="table-js-search" data-datatable>
      <caption><%= t('staff_dashboard.search.results') %></caption>
      <thead class="table-primary">
        <tr>
          <th><%= t('staff_dashboard.columns.name') %></th>
          <th><%= t('staff_dashboard.columns.email') %></th>
          <th><%= t('staff_dashboard.columns.last_seen') %></th>
          <th><%= t('staff_dashboard.columns.status') %></th>
          <th class="action-header"><i class="fa-solid fa-check"></i>&nbsp; <%= t('staff_dashboard.columns.to_sign_in') %> <br> <i class="fa-solid fa-xmark"></i>&nbsp; <%= t('staff_dashboard.columns.to_sign_out') %></th>
        </tr>
      </thead>
      <% @users.each do |user| %>
        <tr class="sign-in-or-out" id="<%= return_no_waiver_id(user) %>">
          <td class="sign-in-cell"><%= link_to(tag.drop_username(user.name), user_url(user.username)) %></td>
          <td class="email-cell"><%= user.email %></td>
          <% lab_sessions = user.lab_sessions.present? %>
          <% signed_in = lab_sessions ? user.lab_sessions.max_by(&:sign_out_time).sign_out_time > Time.zone.now : false %>

          <td class="signed_in-cell" style="horizontal-alginment:center;">
            <%= last_seen_text(user) %>
          </td>
          <td class="status-cell">
            <%= lab_sessions && signed_in ? t('staff_dashboard.search.signed_in') : t('staff_dashboard.search.signed_out') %>
          </td>

          <td class="action-cell">
            <% if lab_sessions && signed_in %>
              <%= button_to '<i class="fa-solid fa-xmark"></i>'.html_safe, { controller: :staff_dashboard, action: :sign_out_users, dropped_users: [user.username] }, method: :put, class: 'btn btn-default x-button', aria: { label: t('common.sign_out') } %>
            <% else %>
              <%= button_to '<i class="fa-solid fa-check"></i>'.html_safe, { controller: :staff_dashboard, action: :sign_in_users, added_users: [user.username] }, method: :put, class: 'btn btn-default check-button', aria: { label: t('common.sign_in') } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <br />
    </table>
    <br />
  <% else %>
    <%= t('staff_dashboard.search.no_results') %>
  <% end %>
  <br /><br />

  <div class="table-responsive">
    <p id="user-count" class="text-center"><%= t('staff_dashboard.users_inside_label', space: @space.name) %> <%= @space.signed_in_users.count %></p>
    <div class="container text-center mx-auto">
      <%= button_to t('staff_dashboard.sign_out_all'), staff_dashboard_sign_out_all_users_path, method: :post, class: 'btn btn-secondary mx-auto text-center', **confirmation_options(t('confirmations.staff_dashboard.sign_out_all')) %>
    </div>
    <table class="staff-users-table text-center mb-5 table table-striped" data-datatable>
      <thead class="table-primary">
        <tr>
          <th class="name-header"><%= t('staff_dashboard.columns.name') %></th>
          <th class="email-header"><%= t('staff_dashboard.columns.email') %></th>
          <th class="name-header"><%= t('staff_dashboard.columns.flagged') %></th>
          <th class="certifications-header"><%= t('staff_dashboard.columns.certifications_in', space: @space.name) %></th>
          <th class="email-header"> <%= t('staff_dashboard.columns.visits_html') %></th>
          <th class="last-seen-header"><%= t('staff_dashboard.columns.last_seen') %></th>
          <th class="action-header"><%= t('staff_dashboard.columns.sign_out_of', space: @space.name) %></th>
        </tr>
      </thead>
      <tbody id="table-js-signed-in">
        <% @space.signed_in_users_with_history.each do |user| %>
          <tr class="drop-rows">
            <td class="drop-username-cell">
              <%= link_to(tag.drop_username(user.name), user_url(user.username)) %>
            </td>
            <td class="email-cell">
              <%= user.email %>
            </td>
            <td>
              <%= render 'staff_dashboard/flag', staff_dashboard_user: user %>
              <% if user.flagged? %>
                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#flag_message_<%= user.id %>"><%= t('staff_dashboard.flags.see_flag') %></button>
              <% else %>
                <%= t('staff_dashboard.flags.none') %>
              <% end %>
            </td>
            <td class="certifications-cell">
              <% if user.certifications.first.present? %>
                <% user.certifications.each do |certification| %>
                  <div class="cert-name" style="display:inline" >
                    <div class="cert-holder" style="display:inline">
                      <%= certification.training.name_en %>
                      <div id="cert-details" style="display:inline">
                        <%= certification.training.name_en %> <br />
                        <%= certification.trainer.name %> <br />
                        <%= l(certification.updated_at, format: :certified_on) %>
                      </div>
                      <br />
                    </div>
                  </div>
                <% end %>
              <% end %>
            </td>
            <td class="email-cell">
              <%= user.lab_sessions.where('space_id' => @space.id).where('created_at BETWEEN ? AND ? ', 2.months.ago, DateTime.now).count %>
            </td>
            <td class="sign_out_time-cell" style="horizontal-alginment:center;">
              <%= previous_visit_text(user) %>
            </td>
            <td class="action-cell">
              <%= button_to '<i class="fa-solid fa-xmark"></i>'.html_safe, { controller: :staff_dashboard, action: :sign_out_users, dropped_users: [user.username] }, method: :put, class: 'btn btn-default x-button', aria: { label: t('common.sign_out') } %>
            </td>
          </tr>
        <% end %>
        <br />
      </tbody>
    </table>
  </div>
  <br />

  <div class="table-responsive">
    <p class="text-center"><%= t('staff_dashboard.recently_signed_out', space: @space.name) %></p>
    <table class="staff-recent-users-table text-center mb-5 table table-striped" data-datatable>
      <thead class="table-primary">
        <tr>
          <th class="name-header"><%= t('staff_dashboard.columns.name') %></th>
          <th class="email-header"><%= t('staff_dashboard.columns.email') %></th>
          <th class="last-seen-header"><%= t('staff_dashboard.columns.last_seen') %></th>
          <th class="action-header"><i class="fa-solid fa-check"></i>&nbsp; <%= t('staff_dashboard.columns.to_sign_in') %> <br> <i class="fa-solid fa-xmark"></i>&nbsp; <%= t('staff_dashboard.columns.to_sign_out') %></th>
        </tr>
      </thead>
      <%= render partial: 'signed_out_table', locals: { space: @space, all_user_certs: @all_user_certs, certifications_on_space: @certifications_on_space } %>
    </table>
  </div>
  <br>
</section>
