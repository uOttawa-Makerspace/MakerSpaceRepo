<div class="modal fade" id="signinModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header" id="myModalHeader">
        <h1 class="modal-title fs-2 text-primary"><%= t('staff_dashboard.signin_modal.title') %></h1>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col">
            <div class="row mb-3">
              <p class="mb-0 fw-light"><%= t('staff_dashboard.signin_modal.name') %></p>
              <p id="sign-in-username"class="fs-5 mt-0"><%= t('staff_dashboard.signin_modal.full_name') %></p>
            </div>
            <div class="row mb-3">
              <p class="fw-light mb-0"><%= t('staff_dashboard.signin_modal.email') %></p>
              <p id="sign-in-email" class="fs-5 mt-0">email@uottawa.ca</p>
            </div>
            <div class="row">
              <div class="col">
                <p class="mt-3"><%= t('staff_dashboard.signin_modal.membership') %></p>
              </div>
              <div class="col d-flex justify-content-center">
                <div id="has-membership">
                 <p id="sign-in-membership" class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-success" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.has_membership') %></p>
                </div>
                <div id="no-membership">
                 <p id="sign-in-membership" class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-danger" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.no_membership') %></p>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col">
                <p class="mt-3"> <%= t('staff_dashboard.signin_modal.user_status') %> </p>
              </div>
              <div class="col d-flex justify-content-center">
                <div id="is-student">
                  <p class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-success" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.student') %></p>
                </div>
                <div id="not-student">
                  <p class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-danger" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.not_student') %></p>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col">
                <p class="mt-3"> <%= t('staff_dashboard.signin_modal.consent_form_status') %> </p>
              </div>
              <div class="col d-flex justify-content-center">
                <div id="signed-consent-form">
                  <p class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-success" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.signed') %></p>
                </div>  
                <div id="unsigned-consent-form">
                  <p class="d-flex align-items-center text-light fw-normal btn btn-light rounded-pill bg-danger" style="width: fit-content;"><%= t('staff_dashboard.signin_modal.unsigned') %></p>
                </div>  
              </div>
            </div>
          </div>
          <div class="col">
              <div class="row mb-0">
                  <p class="fw-light mb-0"><%= t('staff_dashboard.signin_modal.certifications') %></p>
              </div>
              <div class="row">
                  <div id="sign-in-certifications" class="d-flex flex-wrap align-content-start">
                  </div>
                  <a id="sign-in-profile-link" class="d-flex align-content-end mt-5"><%= t('staff_dashboard.signin_modal.see_profile') %></a>
              </div>
          </div>
        </div>
      </div>
      <div id="outer-progress-bar" class="progress" role="progressbar" aria-label="<%= t('common.names.signin_progress') %>" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
      <div id="signin-progress-bar" class="progress-bar" style="width: 0%"></div>
    </div>
    </div>
    <br>

  </div>
  
</div>
