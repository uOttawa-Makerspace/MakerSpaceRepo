<h1 class="text-center"><%= t('lockers.expired_page.heading') %></h1>
<% if @expired_locker_rentals.none? %>
    <p class="text-center"><%= t('lockers.no_expired_rentals') %></p>
<% else %>
<div class="container">
    <table data-datatable class="table table-striped">
        <thead class="table-primary">
            <tr>
                <th><%= t('lockers.locker_id') %></th>
                <th><%= t('lockers.rented_by') %></th>
                <th><%= t('lockers.expired_page.expired_on') %></th>
                <th><%= t('lockers.expired_page.action') %></th>
            </tr>
        </thead>
        <tbody>
            <% @expired_locker_rentals.each do |expired| %>
                <tr>
                    <td><%= expired.locker&.specifier %></td>
                    <td><%= expired.rented_by.username %></td>
                    <td>
                        <%= t('lockers.expired_page.expired_on_ago', date: l(expired.owned_until.to_date, format: :rental_date), time: time_ago_in_words(expired.owned_until)) %>
                    </td>
                    <td><%= link_to t('lockers.expired_page.view_rental'), locker_rental_path(expired), class: 'btn btn-primary' %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
<% end %>
