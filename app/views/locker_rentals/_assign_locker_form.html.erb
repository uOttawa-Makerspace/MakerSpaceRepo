<%= form_with model: LockerRental.new, url: locker_rentals_path, method: :post, local: true do |f| %>
  <%= f.hidden_field :state, value: 'active' %>
  
  <div class="row g-3 align-items-end">
    <div class="col-md-5">
      <%= f.label :rented_by_id, 'User', class: 'form-label fw-bold text-body' %>
      <%= f.collection_select :rented_by_id, User.order(:username), :id, :username,
            { include_blank: 'Select a user...' },
            { class: 'form-select', required: true } %>
    </div>

    <div class="col-md-5">
      <%= f.label :locker_id, 'Locker', class: 'form-label fw-bold text-body' %>
      <%= f.select :locker_id, Locker.available.order_by_specifier.map { |locker|
            size_label = locker.locker_size&.size ? " (#{locker.locker_size.size})" : ""
            ["##{locker.specifier}#{size_label}", locker.id, { data: { size: locker.locker_size&.size, staff_only: !locker.available } }]
          },
          { include_blank: 'Search for a locker...' },
          { class: 'form-select', required: true } %>
    </div>

    <div class="col-md-2">
      <%= f.submit 'Assign Locker', class: 'btn btn-primary w-100' %>
    </div>
  </div>
<% end %>
