<% provide :title, t('lockers.view_locker_request') %>

<!-- Requirement: We need a button to go back to the admin locker page -->
<div class="mb-3 clearfix">
    <% if current_user.staff? %>
        <%= link_to admin_locker_rentals_path, class: 'btn btn-outline-secondary' do %>
            <i class="fa fa-arrow-left me-1"></i> Back to Admin Locker Page
        <% end %>
    <% else %>
        <%= link_to locker_rentals_path, class: 'btn btn-outline-secondary' do %>
            <i class="fa fa-arrow-left me-1"></i> Back to My Lockers
        <% end %>
    <% end %>
</div>

<%
status_color = if @locker_rental.cancelled?
'danger'
elsif @locker_rental.expired?
    'warning'
elsif @locker_rental.active?
    'success'
elsif @locker_rental.await_payment?
    'info'
else
    'secondary'
end
%>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
    <div>
        <h1 class="mb-1"><%= t('lockers.locker_request') %></h1>
        <span class="text-muted fs-5"><%= t('lockers.locker_request') %> #<%= @locker_rental.id %></span>
    </div>

    <div class="mt-3 mt-md-0 text-md-end">
        <span class="badge rounded-pill bg-<%= status_color %> fs-6 px-3 py-2">
            <% if @locker_rental.expired? %>
                <i class="fa-solid fa-triangle-exclamation"></i> <%= t('lockers.state.expired') %>
            <% elsif @locker_rental.cancelled? %>
                <i class="fa-solid fa-circle-xmark"></i> <%= t('lockers.state.cancelled') %>
            <% elsif @locker_rental.active? %>
                <i class="fa-solid fa-circle-check"></i> <%= t('lockers.state.active') %>
            <% elsif @locker_rental.await_payment? %>
                <i class="fa-solid fa-credit-card"></i> <%= t('lockers.state.await_payment') %>
            <% else %>
                <i class="fa-solid fa-hourglass-half"></i> <%= t("lockers.state.#{@locker_rental.state}") %>
            <% end %>
        </span>
        <div class="text-muted mt-1">
            <%= t('lockers.submitted_on') %> <%= @locker_rental.created_at.to_date.to_fs(:long) %>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
            <!-- Dark Mode: Changed bg-white to bg-body-tertiary -->
            <div class="card-header bg-body-tertiary">
                <h5 class="card-title mb-0"><i class="fa-solid fa-user text-muted me-2"></i><%= t('lockers.requested_by') %></h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted"><%= t('lockers.user') %></span>
                    <span>
                        <%= link_to @locker_rental.rented_by.username, user_url(@locker_rental.rented_by.username) %>
                        <% if @locker_rental.rented_by.staff? %>
                            <span class="badge text-bg-primary ms-1"><%= @locker_rental.rented_by.role.humanize %></span>
                        <% end %>
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted"><%= t('lockers.requested_as') %></span>
                    <span class="fw-medium"><%= @locker_rental.requested_as&.humanize %></span>
                </li>
                <% if current_user.staff? %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><%= t('lockers.contact') %></span>
                        <%= mail_to @locker_rental.rented_by.email, @locker_rental.rented_by.email %>
                    </li>
                <% end %>
                <% if @locker_rental.requested_as_student? %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><%= t('lockers.team') %></span>
                        <span class="fw-medium">
                            <%= @locker_rental.team_name.presence || tag.span('Not provided', class: 'text-muted fst-italic') %>
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><%= t('lockers.course_section') %></span>
                        <span class="fw-medium">
                            <%= @locker_rental.course_name&.name.presence || tag.span('Not provided', class: 'text-muted fst-italic') %>
                            <% if @locker_rental.section_name.present? %>
                                <span class="text-muted mx-1">/</span> <%= @locker_rental.section_name %>
                            <% end %>
                        </span>
                    </li>
                <% end %>
            </ul>
        </div>

        <div class="card shadow-sm mb-4">
            <!-- Dark Mode: Changed bg-white to bg-body-tertiary -->
            <div class="card-header bg-body-tertiary">
                <h5 class="card-title mb-0"><i class="fa-solid fa-lock text-muted me-2"></i><%= t('lockers.locker_details') %></h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted"><%= t('lockers.locker') %></span>
                    <span class="ms-1">
                        <% if @locker_rental.locker %>
                            <% if current_user.admin? %>
                                <%= link_to "Locker #{@locker_rental.locker.specifier}", locker_path(@locker_rental.locker), class: 'fw-bold' %>
                            <% else %>
                                <%= t('lockers.locker') %> <%= @locker_rental.locker.specifier %>
                            <% end %>
                            <% if @locker_rental.reserves_locker? %>
                                <span class="badge bg-success ms-1"><%= t('lockers.assigned') %></span>
                            <% else %>
                                <span class="badge bg-secondary ms-1"><%= t('lockers.previously_assigned') %></span>
                            <% end %>
                        <% elsif @locker_rental.reviewing? && @locker_rental.preferred_locker %>
                            <%= link_to "#{t('lockers.locker')} #{@locker_rental.preferred_locker.specifier}", locker_path(@locker_rental.preferred_locker), class: 'fw-bold' %>
                            <span class="ms-1"><%= t('lockers.preferred_not_assigned') %></span>
                        <% elsif @locker_rental.reviewing? %>
                            <span class="text-muted fst-italic"><%= t('lockers.no_preferred_not_assigned') %></span>
                        <% else %>
                            <span class="text-muted fst-italic"><%= t('lockers.none') %></span>
                        <% end %>
                    </span>
                </li>
                <% if @locker_rental.decided_by %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><%= t('lockers.approved_by') %></span>
                        <%= link_to @locker_rental.decided_by.name, user_url(@locker_rental.decided_by.username) %>
                    </li>
                <% end %>
                <!-- Only show the expiration date if it exists (handles indefinite lockers) -->
                <% if @locker_rental.owned_until %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><%= t('lockers.owned_until') %></span>
                        <span class="fw-medium"><%= @locker_rental.owned_until.to_fs(:long) %></span>
                    </li>
                <% end %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted"><%= t('lockers.payment') %></span>
                    <span>
                        <% if @locker_rental.paid_at %>
                            <%= t('lockers.paid_on') %> <%= @locker_rental.paid_at.to_fs(:long) %>
                        <% else %>
                            <%= t('lockers.unpaid') %>
                        <% end %>
                    </span>
                </li>
            </ul>
        </div>

        <% if @locker_rental.notes.present? %>
            <div class="card shadow-sm mb-4">
                <!-- Dark Mode: Changed bg-white to bg-body-tertiary -->
                <div class="card-header bg-body-tertiary">
                    <h5 class="card-title mb-0"><i class="fa-solid fa-sticky-note text-muted me-2"></i><%= t('lockers.notes') %></h5>
                </div>
                <div class="card-body">
                    <%= simple_format(@locker_rental.notes) %>
                </div>
            </div>
        <% end %>
    </div>

    <div class="col-lg-5">
        <% if @locker_rental.active? %>
            <div class="card shadow-sm mb-4 border-<%= @locker_rental.expired? ? 'danger' : 'success' %> border-2">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <% if @locker_rental.expired? %>
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger"
                                  style="width: 72px; height: 72px;">
                                <i class="fa fa-clock-o fa-2x"></i>
                            </span>
                        <% else %>
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success"
                                  style="width: 72px; height: 72px;">
                                <i class="fa fa-calendar-check-o fa-2x"></i>
                            </span>
                        <% end %>
                    </div>

                    <div class="text-muted text-uppercase fw-semibold mb-1">
                        <% if @locker_rental.owned_until.nil? %>
                            Indefinite Rental
                        <% elsif @locker_rental.expired? %>
                            <%= t('lockers.rental_expired_at') %>
                        <% else %>
                            <%= t('lockers.rental_expires_at') %>
                        <% end %>
                    </div>
                    <div class="fs-3 fw-bold mb-2">
                        <%= @locker_rental.owned_until ? @locker_rental.owned_until.to_date.to_fs(:long) : 'No Expiry' %>
                    </div>
                    <div>
                        <% if @locker_rental.owned_until %>
                            <% if @locker_rental.expired? %>
                                <span class="text-danger fw-medium">
                                    <%= t('lockers.expired_ago', when: time_ago_in_words(@locker_rental.owned_until.to_date)) %>
                                </span>
                                <% if @locker_rental.notified_of_cancellation_at %>
                                    <br>
                                    <span class="text-muted mt-1 d-block"><i class="fa-solid fa-envelope"></i>
                                        <%= t('lockers.cancellation_notice_sent_on') %>
                                        <%= @locker_rental.notified_of_cancellation_at.to_fs :long %>
                                    </span>
                                <% end %>
                            <% else %>
                                <span class="text-success fw-medium">
                                    <%= t('lockers.time_remaining', time: time_ago_in_words(@locker_rental.owned_until.to_date)) %>
                                </span>
                            <% end %>
                        <% else %>
                            <span class="text-success fw-medium">Does not expire</span>
                        <% end %>
                    </div>
                    <% if @locker_rental.renewable? %>
                        <div class="mt-3">
                            <%= button_to 'Renew Locker', renew_locker_rental_path(@locker_rental), method: :patch, class: 'btn btn-primary w-100' %>
                        </div>
                    <% end %>
                </div>
            </div>
        <% end %>

        <% if @locker_rental.expired? && !@locker_rental.active? %>
            <div class="alert alert-warning shadow-sm" role="alert">
                <div class="d-flex align-items-start gap-2">
                    <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                    <div>
                        <strong>Expired</strong> <%= time_ago_in_words(@locker_rental.expired_since) %> ago
                        <% if @locker_rental.notified_of_cancellation_at %>
                            — cancellation notification sent by email.
                        <% else %>
                            — <strong class="text-danger">no notification sent</strong>.
                        <% end %>
                    </div>
                </div>
            </div>
        <% end %>

        <% if @locker_rental.cancelled? && @locker_rental.cancelled_at %>
            <div class="alert alert-danger shadow-sm" role="alert">
                <div class="d-flex align-items-start gap-2">
                    <i class="fa-solid fa-circle-xmark mt-1"></i>
                    <div><%= t('lockers.cancelled_on') %> <strong><%= @locker_rental.cancelled_at.to_fs(:long) %></strong></div>
                </div>
            </div>
        <% end %>

        <% if @locker_rental.pending? %>
            <% if @locker_rental.reviewing? %>
                <div class="card shadow-sm mb-4 border-start border border-secondary">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 text-secondary"
                                  style="width: 40px; height: 40px;">
                                <i class="fa fa-hourglass-half"></i>
                            </span>
                            <h5 class="mb-0"><%= t('lockers.state.reviewing') %></h5>
                        </div>
                        <p class="mb-0">
                            <%= t('lockers.reviewing_description') %>
                        </p>
                    </div>
                </div>
            <% end %>

            <% if @locker_rental.await_payment? %>
                <div class="card shadow-sm mb-4 border-start border border-info">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-info bg-opacity-10 text-info"
                                  style="width: 40px; height: 40px;">
                                <i class="fa fa-credit-card"></i>
                            </span>
                            <h5 class="mb-0"><%= t('lockers.state.await_payment') %></h5>
                        </div>
                        <p class="mb-3">
                            <%= t('lockers.payment_description') %>
                        </p>
                        <%= link_to @locker_rental.checkout_link, class: 'btn btn-info w-100' do %>
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Proceed to Checkout
                        <% end %>
                    </div>
                </div>
            <% end %>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="text-danger mb-2"><i class="fa-solid fa-circle-exclamation"></i> Cancel Request</h6>
                    <p>You may cancel your rental request at any time, up until it is paid. To cancel a paid locker rental, contact us.
                    </p>
                    <%= form_with model: @locker_rental do |f| %>
                        <%= f.hidden_field :state, value: 'cancelled' %>
                        <%= f.button class: 'btn btn-outline-danger w-100',
                          data: { confirm: 'Are you sure you want to cancel this locker request?' } do %>
                            <i class="fa-solid fa-xmark"></i> Cancel Request
                        <% end %>
                    <% end %>
                </div>
            </div>
        <% end %>

        <% if current_user.staff? %>
            <div class="card shadow-sm mb-4">
                <!-- Dark Mode: Changed bg-white to bg-body-tertiary -->
                <div class="card-header bg-body-tertiary">
                    <h5 class="card-title mb-0"><i class="fa-solid fa-clipboard text-muted me-2"></i><%= t('lockers.staff_notes') %></h5>
                </div>
                <%= form_with model: @locker_rental, class: 'card-body' do |f| %>
                    <%= f.text_area :staff_notes, class: 'form-control mb-2', placeholder: 'Staff notes are visible to staff only' %>
                    <%= f.submit 'Update staff notes', class: 'btn btn-primary float-end' %>
                <% end %>
            </div>
        <% end %>
    </div>

    <p class="text-center text-muted"><%= t('lockers.help_footer') %></p>
</div>

<% if current_user.staff? %>
    <%= render partial: 'staff_actions' %>
<% end %>
