<% provide :title, t('lockers.request_a_locker') %>

<h1 class="text-center pt-3"><%= t('lockers.new_request.header') %></h1>
<hr class="w-50 mx-auto" />
<%= t('lockers.new_request.description_html') %>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col"><%= t('lockers.request_form.available_count') %></th>
            <th scope="col"><%= t('lockers.request_form.size') %></th>
            <th scope="col"><%= t('lockers.request_form.cost') %></th>
        </tr>
    </thead>
    <tbody>
        <!-- Requirement: Filter split between staff, gng, and general based on the user -->
        <% audience = if current_user.staff?
'staff'
else
(current_user.student? ? 'gng' : 'general')
end %>
        <% LockerSize.find_each do |size| %>
            <tr>
                <td>
                    <!-- Show available count based on the determined audience -->
                    <%= size.lockers.available(audience).count %>
                </td>
                <td><%= size.size %></td>
                <td><%= t('lockers.request_form.cost_per_semester', price: @locker_product_info&.dig(:variants, size.shopify_gid, :price)) %></td>
            </tr>
        <% end %>
    </tbody>
    <caption class="caption-top"><%= t('lockers.request_form.available_caption') %></caption>
</table>

<hr />

<%# A request that failed validation shows its errors and the form, not the pending-request notice. %>
<% pending_request = @locker_rental.errors.none? ? @pending_locker_request : nil %>
<% if !LockerOption.lockers_enabled %>
    <%= t('lockers.request_form.not_accepted') %>
<% elsif pending_request&.reviewing? %>
    <p><%= t('lockers.request_form.pending_html', date: l(pending_request.created_at.to_date),
             link: link_to(safe_join([t('lockers.request_form.view_pending'), tag.i(class: 'fa-solid fa-arrow-right')], ' '), pending_request)) %></p>
<% elsif pending_request&.await_payment? %>
    <p><%= t('lockers.request_form.awaiting_payment_html', link: link_to(t('lockers.request_form.view_and_checkout'), pending_request, class: '')) %></p>
<% else %>
    <%= form_with model: @locker_rental do |f| %>
        <div class="row row-cols-auto mb-3">
            <div>
                <%= f.label :requested_as, t('lockers.request_form.requested_as'), class: 'form-label' %>
                <%= f.select :requested_as, @available_fors, { selected: @locker_rental.requested_as.presence || (@available_fors.values.first if @available_fors.one?), prompt: t('lockers.request_form.choose_one') }, { class: 'form-select w-auto', required: true } %>
            </div>
            <div>
                <%= f.label :preferred_locker_id, t('lockers.request_form.preferred_locker'), class: 'form-label' %>
                <!-- Requirement: Depending on the user they can only request a certain set of lockers -->
                <% preferrable_lockers = Locker.available(audience).includes(:locker_size) %>
                <%= f.select :preferred_locker_id, preferrable_lockers.order_by_specifier.map { |locker|
                    [locker.specifier, locker.id, {data: {size: locker.locker_size.size, staff_only: !locker.available }}]
                }, { include_blank: '' }, { class: 'form-select' } %>
                <div class="form-text"><%= t('lockers.request_form.location_note') %></div>
            </div>
        </div>
        <fieldset id="repo-select" class="border rounded p-3 mb-3" hidden disabled>
            <div class="row">
                <div class="col">
                    <%= f.label :course_name_id, t('lockers.request_form.course'), class: 'form-label' %>
                    <%= f.collection_select :course_name_id, CourseName.all, :id, :name, {}, {class: 'form-select'} %>
                </div>
                <div class="col">
                    <%= f.label :section_name, t('lockers.request_form.section'), class: 'form-label' %>
                    <%= f.text_field :section_name, class: 'form-control', required: true %>
                </div>
                <div class="col">
                    <%= f.label :team_name, t('lockers.request_form.group'), class: 'form-label' %>
                    <%= f.text_field :team_name, class: 'form-control', required: true %>
                </div>
            </div>
        </fieldset>
        <%= f.label :notes, t('lockers.request_form.notes') %>
        <%= f.text_area :notes, class: 'form-control mb-3' %>
        <div class="d-flex justify-content-between mb-3">
            <%= f.submit t('lockers.request_form.submit'), class: 'btn btn-primary' %>
            <%= link_to t('lockers.request_form.back'), locker_rentals_path, class: 'btn btn-secondary' %>
        </div>

    <% end %>
<% end %>

<% if @locker_rental.errors.any? %>
    <div class="border">
        <p class="fw-bold"><%= t('lockers.request_form.errors') %></p>
        <ul>
            <% @locker_rental.errors.each do |error| %>
                <li><%= error.full_message %></li>
            <% end %>
        </ul>
    </div>
<% end %>
