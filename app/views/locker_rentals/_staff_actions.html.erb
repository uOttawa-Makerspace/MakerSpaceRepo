<div class="card shadow-sm border-0 bg-body-tertiary">
    <h5 class="card-header bg-dark text-white mb-0">Staff Actions</h5>

    <div class="card-body">
        <% unless @locker_rental.cancelled? %>
            <div class="row g-3">
                <% if @locker_rental.reviewing? %>
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-success">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-success">
                                    <%= fa_icon 'paper-plane', text: 'Send to Checkout' %>
                                </h6>
                                <% if @locker_rental.requested_as_student? || @locker_rental.requested_as_staff? %>
                                    <p class="card-text text-muted flex-grow-1">
                                        Locker was requested as student/staff and cannot be sent to checkout.
                                        If this request is valid, assign it now. If not, cancel the request
                                    </p>
                                <% else %>
                                    <p class="card-text text-muted flex-grow-1">
                                        Notify the user by email that their locker is approved and ready for payment.
                                    </p>
                                    <%= form_with model: @locker_rental do |f| %>
                                        <%= f.select :locker_id, @locker_select_options, { include_blank: 'Select a locker' }, { class: 'form-select mb-2', required: true } %>
                                        <%= f.date_field :owned_until, value: @locker_rental.owned_until || end_of_this_semester, class: 'form-control mb-2', id: 'owned_until_checkout' %>
                                        <div class="form-check mb-2 text-start">
                                          <%= check_box_tag 'locker_rental[indefinite]', '1', false, class: 'form-check-input', id: 'indefinite_checkout', data: { indefinite_target: 'owned_until_checkout' } %>
                                          <%= label_tag 'indefinite_checkout', 'Indefinite', class: 'form-check-label small' %>
                                        </div>
                                        <%= f.button name: 'locker_rental[state]', value: 'await_payment', class: 'btn btn-success w-100 mt-auto', data: { confirm: 'Send payment notification to the user?' } do %>
                                            <%= fa_icon 'paper-plane', text: 'Send to Checkout' %>
                                        <% end %>
                                    <% end %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                <% end %>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-info">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-info">
                                <%= @locker_rental.active? ? 'Move Locker' : 'Assign Now' %>
                            </h6>
                            <p class="card-text text-muted flex-grow-1">
                                Immediately assign or move a locker without requiring payment.
                            </p>
                            <%= form_with model: @locker_rental do |f| %>
                                <%= f.select :locker_id, @locker_select_options, { include_blank: 'Select a locker' }, { class: 'form-select mb-2', required: true } %>
                                <%= f.date_field :owned_until, value: @locker_rental.owned_until || end_of_this_semester, class: 'form-control mb-2', id: 'owned_until_assign' %>
                                <div class="form-check mb-2 text-start">
                                  <%= check_box_tag 'locker_rental[indefinite]', '1', @locker_rental.owned_until.nil?, class: 'form-check-input', id: 'indefinite_assign', data: { indefinite_target: 'owned_until_assign' } %>
                                  <%= label_tag 'indefinite_assign', 'Indefinite', class: 'form-check-label small' %>
                                </div>
                                <%= f.button name: 'locker_rental[state]', value: 'active', class: 'btn btn-info w-100 mt-auto', data: { confirm: 'Assign this locker immediately?' } do %>
                                    <%= @locker_rental.active? ? 'Move Locker' : 'Assign Now' %>
                                <% end %>
                            <% end %>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-danger">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-danger">
                                <%= fa_icon 'ban', text: (@locker_rental.active? ? 'End Rental' : 'Cancel Request') %>
                            </h6>
                            <p class="card-text text-muted flex-grow-1">
                                <% if @locker_rental.active? %>
                                    <%= t('lockers.actions.end_rental_description') %>
                                <% else %>
                                    <%= t('lockers.actions.cancel_request_description') %>
                                <% end %>
                            </p>
                            <%= form_with model: @locker_rental do |f| %>
                                <%= f.button name: 'locker_rental[state]', value: 'cancelled', class: 'btn btn-outline-danger w-100 mt-auto', data: { confirm: 'Are you sure you want to cancel this locker?' } do %>
                                    <% if @locker_rental.active? %>
                                        <%= fa_icon 'ban', text: 'End Rental' %>
                                    <% else %>
                                        <%= fa_icon 'times', text: 'Cancel Request' %>
                                    <% end %>
                                <% end %>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>
        <% else %>
            <div class="alert alert-secondary mb-0">This locker request has been finished and cannot be re-enabled.</div>
        <% end %>
    </div>
</div>

<%= vite_javascript_tag 'locker_rental_form', 'data-turbo-track': 'reload' %>
<%= vite_javascript_tag 'locker_admin', 'data-turbo-track': 'reload' %>