<div class="table-responsive">
    <table class="table table-striped table-sm" data-datatable>
        <% if local_assigns[:header_title] %>
            <caption class="text-center fs-3" align="top"><%= header_title %></caption>
        <% end %>
        <thead class="table-secondary">
            <tr>
                <th class="w-auto dt-center" data-type="num"><%= t('lockers.locker') %></th>
                <th><%= t('lockers.state.state') %></th>
                <th><%= t('lockers.rented_by') %></th>
                <th class="d-none d-md-table-cell">Requested as</th>
                <th class="d-none d-lg-table-cell">Requested on</th>
                <th class="d-none d-lg-table-cell"><%= t('lockers.assigned_on') %></th>
                <th><%= t('lockers.owned_until') %></th>
                <% if current_user.staff? %>
                    <th>Contacted</th>
                <% end %>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="align-middle">
            <% if locker_rentals.present? %>
                <% locker_rentals.each do |rental| %>
                    <tr>
                        <td class="dt-center">
                            <% if rental.locker.present? %>
                                <%= link_to "##{rental.locker.specifier}", rental.locker, class: 'btn btn-sm btn-outline-primary' %>
                            <% end %>
                        </td>
                        <td data-search="<%= rental.state %>" class="pe-1">
                            <% btn_class = { 'active' => 'btn-outline-success',
                                'reviewing' => 'btn-outline-secondary',
                                'await_payment' => 'btn-outline-info' }
                            %>
                            <%= link_to rental, class: "w-100 btn btn-sm #{btn_class[rental.state]}" do %>
                                <%= tag.i class: "fa #{rental.state_icon}" %> <%= t("lockers.state.#{rental.state}") %>
                                <% if rental.expired? %>
                                    <span class="text-danger"><i class="fa-solid fa-xmark"></i> Expired</span>
                                <% end %>
                            <% end %>
                        </td>
                        <td>
                            <%= link_to rental.rented_by.username, user_path(rental.rented_by.username) %>
                            <%= tag.span(rental.rented_by.role.humanize, class: 'badge text-bg-primary d-none d-md-inline-block') if rental.rented_by.staff? %>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <%= rental.requested_as.to_s.humanize %>
                        </td>
                        <td class="d-none d-lg-table-cell"><%= rental.created_at.to_date.to_formatted_s :long %></td>
                        <td class="d-none d-lg-table-cell"><%= rental.updated_at&.to_date&.to_formatted_s :long %></td>
                        <td><%= rental.owned_until&.to_date&.to_formatted_s(:long) || 'Indefinite' %></td>
                        <% if current_user.staff? %>
                            <td>
                                <%= form_with url: toggle_contacted_locker_rental_path(rental), method: :patch do %>
                                    <div class="form-check form-switch m-0">
                                        <%= check_box_tag :contacted, '1', rental.contacted_for_clearance,
                                              class: 'form-check-input',
                                              onchange: 'this.form.requestSubmit()' %>
                                    </div>
                                <% end %>
                            </td>
                        <% end %>
                        <td>
                            <%= link_to 'View', rental, class: 'btn btn-sm btn-primary' %>
                        </td>
                    </tr>
                <% end %>
            <% end %>
        </tbody>
    </table>
</div>
