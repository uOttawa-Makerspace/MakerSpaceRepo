<% provide :title, t('lockers.all_locker_rentals') %>

<h1 class="text-center"><%= t('lockers.all_locker_rentals') %></h1>
<p class="text-center"><%= t('lockers.rentals_index.intro') %></p>
<div class="container">
    <div class="row row-cols-md-4 gx-0">
        <% @own_locker_rentals.active.includes(:locker).find_each do |rental| %>
            <div class="card">
                <%= vite_image_tag 'images/locker/STEM_lockers.jpg', alt: '', class: 'card-img-top' %>
                <div class="card-body">
                    <p class="fs-5"><span class="badge text-bg-success"><%= t('lockers.rentals_index.active') %></span> <%= "#{t('lockers.locker')} ##{rental.locker.specifier}" %> </p>
                    <p><%= rental.owned_until ? t('lockers.rentals_index.until', date: l(rental.owned_until.to_date, format: :rental_date)) : t('lockers.indefinite') %></p>
                    <%= link_to t('lockers.rentals_index.view_details'), locker_rental_path(rental), class: 'btn btn-secondary' %>
                </div>
            </div>
        <% end %>

        <div class="card">
            <%= vite_image_tag 'images/locker/STEM_lockers.jpg', alt: '', class: 'card-img-top object-fit-cover' %>
            <div class="card-body">
                <p class="fs-3 card-title"><%= t('lockers.rentals_index.ceed_lockers') %></p>
                <% if @own_locker_rentals.reviewing.any? %>
                    <span class="badge text-bg-secondary"><%= t('lockers.rentals_index.under_review') %></span>
                <% elsif @own_locker_rentals.await_payment.any? %>
                    <span class="badge text-bg-info"><%= t('lockers.rentals_index.awaiting_payment') %></span>
                <% end %>
                <p class="card-text"><%= t('lockers.rentals_index.ceed_lockers_intro') %></p>
                <% if @own_locker_rentals.pending.any? %>
                    <%= link_to t('lockers.rentals_index.review_request'), locker_rental_path(@own_locker_rentals.pending.first), class: 'btn btn-primary stretched-link' %>
                <% else %>
                    <%= link_to new_locker_rental_path, class: 'btn btn-success stretched-link' do %>
                        <i class="fa-solid fa-plus"></i> <%= t('lockers.request_a_locker') %>
                    <% end %>
                <% end %>
            </div>
        </div>
    </div>
    
    <hr />
    <h2><%= t('lockers.rentals_index.history') %></h2>
    <%= render partial: 'rental_data_table',
               locals: { locker_rentals: @own_locker_rentals.includes(:locker, :rented_by).order(:state),
                   header_title: t('lockers.your_locker_requests'), hide_actions: true } %>
</div>
