<% provide(:title, @project_proposal.title.to_s) %>

<section class="row">
    <section class="col-lg-8 order-lg-first order-last">
        <% photos = @project_proposal.photos.to_a %>
        <% has_youtube = @project_proposal.youtube_link.present? %>
        <% has_media = has_youtube || photos.any? %>
        <% total_slides = photos.size + (has_youtube ? 1 : 0) %>

        <% if has_media %>
            <div id="proposalCarousel" class="carousel slide mb-3" data-bs-ride="false">
                <div class="carousel-inner rounded">
                    <% if has_youtube %>
                        <div class="carousel-item active">
                            <div class="carousel-slide-wrapper">
                                <div class="ratio ratio-16x9 w-100">
                                    <%= youtube_video(@project_proposal.youtube_link) %>
                                </div>
                            </div>
                        </div>
                    <% end %>

                    <% photos.each_with_index do |p, i| %>
                        <div class="carousel-item <%= 'active' if i == 0 && !has_youtube %>">
                            <div class="carousel-slide-wrapper">
                                <% if p.variable? %>
                                    <%= image_tag url_for(p.variant(:photo_slide_first)),
                                                class: 'carousel-main-image',
                                                alt: "#{@project_proposal.title} — image #{i + 1}" %>
                                <% else %>
                                    <%= image_tag url_for(p),
                                                class: 'carousel-main-image',
                                                alt: "#{@project_proposal.title} — image #{i + 1}" %>
                                <% end %>
                            </div>
                        </div>
                    <% end %>
                </div>

                <% if total_slides > 1 %>
                    <button class="carousel-control-prev" type="button"
                            data-bs-target="#proposalCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button"
                            data-bs-target="#proposalCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                <% end %>
            </div>

            <% if total_slides > 1 %>
                <div class="d-flex gap-1 flex-wrap mb-3" id="carousel-thumbnails">
                    <% slide_offset = 0 %>
                    <% if has_youtube %>
                        <button type="button"
                                class="carousel-thumbnail active"
                                data-bs-target="#proposalCarousel"
                                data-bs-slide-to="0"
                                aria-label="Video">
                            <img src="https://img.youtube.com/vi/<%= YoutubeID.from(@project_proposal.youtube_link) %>/default.jpg"
                                alt="Video thumbnail">
                        </button>
                        <% slide_offset = 1 %>
                    <% end %>

                    <% photos.each_with_index do |p, i| %>
                        <button type="button"
                                class="carousel-thumbnail <%= 'active' if i == 0 && !has_youtube %>"
                                data-bs-target="#proposalCarousel"
                                data-bs-slide-to="<%= i + slide_offset %>"
                                aria-label="Image <%= i + 1 %>">
                            <%= image_tag url_for(p.variable? ? p.variant(:photo_slide) : p),
                                        alt: "Thumbnail #{i + 1}" %>
                        </button>
                    <% end %>
                </div>
            <% end %>
        <% end %>

        <div class="card mb-3 shadow-sm border">
            <div class="card-header bg-body-tertiary fw-bold">
                <%= t('project_proposal.project_information') %>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-1"><b><%= t('project_proposal.possible_tech') %>:</b> <%= sanitize(@project_proposal.equipments) %></li>
                    <li class="mb-1"><b><%= t('project_proposal.project_type') %>:</b> <%= @project_proposal.project_type %></li>
                    <li class="mb-1"><b><%= t('project_proposal.expected_budget') %>:</b> <%= @project_proposal.prototype_cost.present? ? "$#{@project_proposal.prototype_cost}" : 'Not available' %></li>
                    <li class="mb-0"><b><%= t('project_proposal.expected_cost') %>:</b> <%= @project_proposal.project_cost.present? ? "$#{@project_proposal.project_cost}" : 'Not available' %></li>
                </ul>
            </div>
        </div>

        <div class="card mb-3 shadow-sm border">
            <div class="card-header bg-body-tertiary fw-bold"><%= t('project_proposal.client_information') %></div>
            <div class="card-body">
                <% if signed_in? %>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><b>Client:</b> <%= @project_proposal.client %></li>
                        <li class="mb-1"><b><%= t('project_proposal.client_type') %>:</b> <%= @project_proposal.client_type %></li>
                        <li class="mb-1"><b><%= t('project_proposal.client_interest') %>:</b> <%= @project_proposal.client_interest %></li>
                        <li class="mb-1"><b><%= t('project_proposal.client_background') %>:</b> <%= sanitize(@project_proposal.client_background) %></li>
                        <% if @project_proposal.supervisor_background.present? %>
                            <li class="mt-2 text-break">
                                <b>Supervisor Background:</b> <%= sanitize(@project_proposal.supervisor_background) %>
                            </li>
                        <% end %>
                    </ul>
                <% else %>
                    <div class="alert alert-info mb-0">
                        <%= link_to 'Sign in', login_path %> to view client info.
                    </div>
                <% end %>
            </div>
        </div>

        <% if @project_proposal.description.present? %>
            <div class="card mb-3 shadow-sm border">
                <div class="card-header bg-body-tertiary fw-bold"><%= t('project_proposal.project_background') %></div>
                <div class="card-body">
                    <div class="text-break"><%= sanitize(@project_proposal.description) %></div>
                </div>
            </div>
        <% end %>

        <% if @project_proposal.past_experiences.present? %>
            <div class="card mb-3 shadow-sm border">
                <div class="card-header bg-body-tertiary fw-bold"><%= t('project_proposal.past_attempts') %></div>
                <div class="card-body">
                    <% experiences = @project_proposal.past_experiences.split("|") %>
                    <% if experiences[0].present? %>
                        <p class="mb-2"><%= sanitize(experiences[0]) %></p>
                    <% end %>
                    <% if experiences[1].present? %>
                        <% experiences[1].split(',').each do |link| %>
                            <%= link_to link, link, target: '_blank', rel: 'noopener' %> <br>
                        <% end %>
                    <% end %>
                </div>
            </div>
        <% end %>

        <% if @linked_pp.present? %>
            <div class="card mb-3 shadow-sm border">
                <div class="card-header bg-body-tertiary fw-bold"><%= t('project_proposal.linked_proposal') %></div>
                <div class="card-body">
                    <%= link_to t('project_proposal.linked_proposal_button'), project_proposal_path(@linked_pp.slug), class: 'btn btn-primary btn-sm' %>
                </div>
            </div>
        <% end %>

        <% if @revisions.present? %>
            <div class="card mb-3 shadow-sm border">
                <div class="card-header bg-body-tertiary fw-bold">Revisions of this proposal</div>
                <div class="card-body">
                    <ul class="mb-0 ps-3">
                        <% @revisions.each do |revision| %>
                            <li><%= link_to revision.title, project_proposal_path(revision.slug) %></li>
                        <% end %>
                    </ul>
                </div>
            </div>
        <% end %>

        <% if @project_proposal.project_joins.present? %>
            <div class="card mb-3 shadow-sm border">
                <div class="card-header bg-body-tertiary fw-bold"><%= t('project_proposal.users_joined') %></div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <% @project_proposal.project_joins.find_each do |pj| %>
                            <% user_pj = User.find_by(id: pj.user_id)&.username %>
                            <% if user_pj %>
                                <%= link_to user_pj, user_path(user_pj), class: 'badge bg-body-tertiary text-body border p-2 text-decoration-none' %>
                            <% end %>
                        <% end %>
                    </div>
                </div>
            </div>
        <% end %>
    </section>

    <section id="info" class="col-lg-4">
        <div class="p-3 bg-body-tertiary border rounded shadow-sm mb-3">
            <h1 class="fs-3 fw-bold border-bottom pb-2 mb-3"><%= @project_proposal.title %></h1>

            <% if signed_in? && (@project_proposal.user_id == current_user.id || current_user.admin?) %>
                <%= link_to "<i class=\"fa-solid fa-pencil\"></i> #{t('project_proposal.edit_proposal')}".html_safe,
                            edit_project_proposal_path(@project_proposal), class: 'btn btn-secondary btn-sm w-100 mb-3' %>
            <% end %>

            <ul class="list-unstyled mb-3">
                <li class="text-body-secondary mb-1">
                    <%= t('project_proposal.proposed_by') %>:
                    <% if @project_proposal.user_id && @project_proposal.user.present? %>
                        <%= link_to @project_proposal.user.username, user_path(@project_proposal.user.username) %>
                    <% else %>
                        <strong class="text-body"><%= @project_proposal.username %></strong>
                    <% end %>
                </li>
                <li class="text-body-secondary mb-1">
                    <%= t('project_proposal.proposed_on') %>: <%= @project_proposal.created_at.strftime('%b %e, %Y') %>
                </li>
                <li class="text-body-secondary mb-2">
                    <% if signed_in? %>
                        <%= t('project_proposal.contact') %>: <%= mail_to @project_proposal.email %>
                    <% else %>
                        <%= link_to 'Sign in', login_path %> to view contact information
                    <% end %>
                </li>

                <% if signed_in? && current_user.admin? %>
                    <li class="text-body-secondary mb-2">
                        Validation:
                        <% if @project_proposal.approved? %>
                            <span class="badge text-bg-success"><%= t('project_proposal.validation.approved') %></span>
                        <% elsif @project_proposal.not_approved? %>
                            <span class="badge text-bg-danger"><%= t('project_proposal.validation.declined') %></span>
                        <% else %>
                            <span class="badge text-bg-warning"><%= t('project_proposal.validation.not_validated') %></span>
                        <% end %>
                    </li>
                <% end %>
            </ul>

            <% if @project_files.attached? %>
                <div class="mb-3 border-top pt-2">
                    <div class="fw-bold mb-1"><%= t('project_proposal.project_files') %></div>
                    <ul class="list-unstyled mb-0">
                        <% @project_files.each do |f| %>
                            <li class="small mb-1">
                                <i class="fa-regular fa-file-lines"></i>
                                <%= link_to f.filename.to_s, rails_blob_path(f, disposition: 'attachment') %>
                                <span class="text-body-secondary">(<%= (f.byte_size / 1024.0).round(1) %> KB)</span>
                            </li>
                        <% end %>
                    </ul>
                </div>
            <% end %>

            <% if @project_proposal.categories.any? %>
                <div class="mb-3 border-top pt-2">
                    <b class="d-block mb-2"><%= t('repository.categories') %></b>
                    <div class="d-flex flex-wrap gap-1">
                        <% @project_proposal.categories.each do |category| %>
                            <%= link_to category.name, category_path(slug: category.name.gsub(' ', '-').downcase), class: "badge bg-primary text-decoration-none" %>
                        <% end %>
                    </div>
                </div>
            <% end %>

            <div class="d-flex flex-wrap gap-2 border-top pt-3">
                <% if signed_in? %>
                    <%= link_to t('project_proposal.document_project'), new_repository_path(current_user.username, project_proposal_id: @project_proposal.id),
                                class: 'btn btn-success btn-sm flex-fill',
                                data: { confirm: 'This action will create a repository related to this project proposal' } %>

                    <% @project_join = find_project_join(current_user.id, @project_proposal.id) %>
                    <% if @project_join.present? %>
                        <%= button_to t('project_proposal.leave_project'), unjoin_project_proposal_project_proposals_path, method: :get,
                                      params: { project_proposal_id: @project_proposal.id, project_join_id: @project_join.id },
                                      class: 'btn btn-outline-danger btn-sm flex-fill', data: { confirm: 'Are you sure you want to leave this project?' } %>
                    <% else %>
                        <%= button_to t('project_proposal.join_project'), join_project_proposal_project_proposals_path, method: :get,
                                      params: { project_proposal_id: @project_proposal.id },
                                      class: 'btn btn-primary btn-sm flex-fill', data: { confirm: 'Are you sure you want to join this project?' } %>
                    <% end %>
                <% end %>
            </div>
        </div>

        <% if signed_in? && current_user.admin? %>
            <div class="p-3 bg-body-secondary border rounded shadow-sm mb-3">
                <h2 class="fs-5 fw-bold mb-3">Admin Review & Tools</h2>

                <div class="d-flex gap-2 mb-3">
                    <%= button_to "<i class=\"fa-solid fa-thumbs-up\"></i> #{t('project_proposal.admin.approve')}".html_safe, approve_project_proposals_path(id: @project_proposal.id),
                                  method: :post, class: 'btn btn-success btn-sm flex-fill', data: { confirm: 'Approve this project proposal?' } %>
                    <%= button_to "<i class=\"fa-solid fa-thumbs-down\"></i> #{t('project_proposal.admin.decline')}".html_safe, decline_project_proposals_path(id: @project_proposal.id),
                                  method: :post, class: 'btn btn-danger btn-sm flex-fill', data: { confirm: 'Decline this project proposal?' } %>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <%= button_to t('project_proposal.create_revision'), create_revision_project_proposals_path(old_project_proposal_id: @project_proposal.id),
                                  method: :post, class: 'btn btn-outline-success btn-sm flex-fill' %>
                    <%= button_to "<i class=\"fa-solid fa-trash\"></i> #{t('project_proposal.admin.delete')}".html_safe, project_proposal_path(@project_proposal),
                                  method: :delete, class: 'btn btn-outline-danger btn-sm flex-fill', data: { confirm: 'Delete this project proposal?' } %>
                </div>

                <%= form_with model: @project_proposal do |f| %>
                    <%= f.label :season, 'Active Semester:', class: 'form-label fw-semibold small mb-1' %>
                    <div class="input-group input-group-sm mb-2">
                        <%= f.select :season, ProjectProposal.seasons.keys.map {|s| [s.capitalize, s]}, { include_blank: 'Semester' }, { class: 'form-select', required: true } %>
                        <%= f.number_field :year, placeholder: 'Year', min: 1900, max: 2100, class: 'form-control', required: true %>
                        <%= f.submit "Set", class: 'btn btn-primary' %>
                    </div>
                    <% if @project_proposal.active_semester_label %>
                        <div class="small text-body-secondary">Currently active for <b><%= @project_proposal.active_semester_label %></b></div>
                    <% end %>
                <% end %>
            </div>
        <% end %>
    </section>
</section>

<%= vite_javascript_tag 'carousel_thumbnails', 'data-turbo-track': 'reload' %>