<section data-controller="launch-modal">
  <h2 class="text-center py-3"><b>Proficient Projects</b></h2>
  <div class="text-center">
    <div class="row mx-auto">

      <div class="col-md-12 accordion">
        <% @skills.each do |skill| %>
          <% next if skill.trainings.blank? %>
          <% skill.trainings.each do |training| %>
            <% next if training.proficient_projects.blank? %>
              <div class="card"  id="accordion-<%= training.id %>">
                  <div class="accordion-button card-header position-relative" id="header-<%= training.id %>">
                    <div class="col-4 float-end"></div>
                    <div class="col-4 text-center">
                      <button class="btn btn-link stretched-link" type="button" data-bs-toggle="collapse" data-bs-target="#training-<%= training.id %>" aria-expanded="false" aria-controls="training-<%= training.id %>"><%= training.localized_name %></button>
                    </div>
                    <div class="col-4">
                      <%= sanitize(training_status(training.id, current_user)) %>
                    </div>
                </div>

                <div id="training-<%= training.id %>" class="accordion-collapse collapse">
                  <div class="accordion-body">

                    <p>Proficient Projects finished : <%= training.awarded_proficient_projects(current_user).size %> / <%= training.proficient_projects.size %></p>

                    <div class="row">

                      <% training.proficient_projects_by_level.each do |pp| %>
                        <% opacity = @bought_project_ids.include?(pp.id) ? '' : 'w3-opacity-max' %>
                        <% project_items = @order_items_by_project.fetch(pp.id, []) %>
                        <div class="col-md-4 mb-5 mt-3 w3-hover-opacity <%= return_hover_and_text_colors(pp.level) %>" style="border-width:2px !important;">
                          <div class="<%= opacity %>">
                            <div class="py-3">
                              <div class="row">
                                <div class="col-3">
                                  <%= link_to 'Edit', edit_proficient_project_path(pp.id), class: 'btn btn-primary', style: 'opacity: 0.5' if current_user.admin? %>
                                </div>
                                <div class="col-6">
                                  <p><h6 class="text-center my-auto"><strong><%= pp.training.localized_name %></strong></h6></p>
                                </div>
                                <div class="col-3 float-end">
                                  <%= button_to 'Delete', proficient_project_path(pp.id), method: :delete, class: 'btn btn-danger float-end', style: 'opacity: 0.5', **confirmation_options(t('confirmations.proficient_projects.delete_learning_module')) if current_user.admin? %>
                                </div>
                              </div>
                            </div>
                            <% if pp.photos.present? %>
                              <% if project_items.any? { |item| ['In progress', 'Waiting for approval'].include?(item.status) } %>
                                <a href="<%= proficient_project_path(pp.id) %>">
                                  <div class="projects-image" style="background-image: url(<%= url_for(pp.photos.first.image) %>);">
                                  </div>
                                </a>
                              <% elsif project_items.any? { |item| item.status == 'Awarded' } %>
                                <div class="watermark">
                                  <a href="<%= proficient_project_path(pp.id) %>">
                                    <div class="projects-image" style="background-image: url(<%= url_for(pp.photos.first.image) %>);">
                                    </div>
                                  </a>
                                </div>
                              <% else %>
                                  <div 
                                    class="projects-image" 
                                    style="background-image: url(<%= url_for(pp.photos.first.image) %>);"
                                    data-action="click->launch-modal#openModal" 
                                    data-id="<%= pp.id %>" 
                                    data-title="<%= pp.title %>"
                                    data-name="proficient-project"
                                    data-url="/proficient_projects/<%= pp.id %>/proficient_project_modal/">
                                  </div>
                              <% end %>
                            <% end %>
                            <div>
                              <b class="float-end pt-2  text-info"><%= pp.cc.nil? || pp.cc.eql?(0) ? sanitize("<b class='text-success'>FREE</b>") : "#{pp.cc} Ccs" %></b>
                              <br />
                              <br />
                              <h6 class="fw-bold text-center"><strong><%= pp.title %></strong></h6>
                              <p><%= pp.level %></p>
                            </div>
                          </div>
                          <%= render '/proficient_projects/proficient_project_row', proficient_project: pp, order_item: @order_item, project_items: project_items, in_progress: @in_progress_project_ids.include?(pp.id), held_training_levels: @held_training_levels, training_requirements: @requirements_by_project.fetch(pp.id, []) %>
                        </div>
                      <% end %>

                    </div>
                    <br />
                  </div>
                </div>
              </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Proficient Project Modal -->
  <div class="modal" tabindex="-1" data-controller="launch-modal_controller" id="proficient-project-modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Preview: <span data-launch-modal-target="title"></span></h5>
          <button type="button" class="btn-close" data-action="click->launch-modal#close" aria-label="<%= t('common.close') %>">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body" id="proficient-project-body">

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-action="click->launch-modal#close">Close</button>
        </div>
      </div>
    </div>
  </div>

</section>
