<div class="well">
  <div class="col-xs-4">
    <% project_items.each do |order_item| %>
      <button type="button" class="btn disabled mb-2 pp-status-button "><%= order_item.status %></button>
    <% end %>
    <br />
    <% if project_items.any? { |item| ["In progress", "Awarded", "Waiting for approval"].include?(item.status) } %>
      <a href="<%= proficient_project_path(proficient_project.id) %>"><button type="button" class="btn btn-success mb-2 "><%= t('devprog.proficient_project.show') %></button></a>
    <% elsif in_progress %>
      <button type="button" class="btn btn-success disabled mb-2 "><%= t('devprog.proficient_project.added') %></button>
    <% elsif !current_user.has_requirements?(training_requirements, held_training_levels) %>
      <button type="button" class="btn btn-danger disabled mb-2 "><%= t('devprog.proficient_project.block') %></button>
    <% else %>
      <%= form_with model: order_item do |f| %>
        <div class="input-group">
          <%= f.hidden_field :quantity, value: 1 %>
          <div class="input-group-btn mx-auto mb-2">
            <%= f.hidden_field :proficient_project_id, value: proficient_project.id %>
            <%= f.submit t('devprog.proficient_project.add'), class: 'btn btn-secondary', id: 'cart-button' %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
