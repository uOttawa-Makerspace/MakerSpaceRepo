<%# The opening-hours calendar; the hours page shows a week with an all-day row. %>
<div id="calendar" class="styled-calendar" data-hours-calendar-target="calendar" <%= tag.attributes(data: calendar_texts_data) %>>
    <% if calendars.empty? %>
        <p class="text-muted text-center py-4">No open hours available // Aucune heure d'ouverture disponible</p>
    <% end %>
</div>
