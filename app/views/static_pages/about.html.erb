<% provide(:title, t('footer.about')) %>
<div>
    <div class="col-lg-7 mx-auto">
        <h1 class="text-primary mt-5"><%= t('static_pages.about.heading') %></h1>
        <hr />
        <p class="fs-4 fw-bold text-secondary"><%= t('static_pages.about.organization') %></p>
        <p><b><%= t('static_pages.about.offers') %></b></p>
        <ul class="fa-ul">
            <% %w[design business client sales experiential].each do |item| %>
            <li><i class="fa-li fa fa-angle-double-right" aria-hidden="true"></i> <%= t("static_pages.about.items.#{item}") %></li>
            <% end %>
        </ul>
    </div>
</div>
