<% locale = I18n.locale %>
<% days = Api::V1::ContactInfoSerializer::DAYS %>
<div id="opening-hours" class="my-4">
  <% contacts.each do |contact| %>
    <% next if contact[:opening_hours].empty? %>
    <h2 class="h4 mt-4"><%= contact[:name] %></h2>
    <% contact[:opening_hours].each do |period| %>
      <section class="mb-4">
        <% if period[:closed_all_week] %>
          <h3 class="h5"><%= period[:"target_#{locale}"].presence || period[:target_en] %></h3>
          <p class="fw-bold"><%= t('hours.tags.closed') %></p>
        <% else %>
          <table class="table table-sm w-auto">
            <caption class="caption-top fw-bold text-body"><%= period[:"target_#{locale}"].presence || period[:target_en] %></caption>
            <thead>
              <tr>
                <th scope="col"><%= t('hours.day') %></th>
                <th scope="col"><%= t('hours.times') %></th>
              </tr>
            </thead>
            <tbody>
              <% days.each do |day| %>
                <% hours = period[:days][day] %>
                <% next if hours[:status] == 'hidden' || (hours[:status] == 'open' && hours[:opening].blank? && hours[:closing].blank?) %>
                <tr>
                  <th scope="row"><%= t("hours.tags.#{day}") %></th>
                  <td><%= hours[:status] == 'closed' ? t('hours.tags.closed') : "#{hours[:opening]} - #{hours[:closing]}" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
        <% notes = period[:"notes_#{locale}"].presence || period[:notes_en] %>
        <% if notes.present? %>
          <div class="opening-hours-notes"><%= sanitize(notes) %></div>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
