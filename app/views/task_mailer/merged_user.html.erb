<% content_for :preheader do %>
    <%= t(".preheader") %>
<% end %>

<% content_for :team_name do %>
    <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
    <%= t(".why_received") %> <a href="https://makerepo.com" style="text-decoration: underline; color: #999999; font-size: 12px; text-align: center;">makerepo.com</a>.
<% end %>

<p><%= t("task_mailer.hello") %></p>
<p><%= t(".found_html", email: tag.b(params[:email])) %></p>
<p>
    <%= t(".merged") %>
    <%= t(".username_html", username: tag.b(params[:username])) %>
    <%= t(".verify") %>
</p>
<p><%= t(".no_action") %></p>
<p>
    <%= t(".reset_html", link: link_to(t(".reset_link"), forgot_password_url(email: params[:email]))) %>
</p>
<p>
    <%= t(".assistance") %>
</p>
