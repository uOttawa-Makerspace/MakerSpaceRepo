<% content_for :preheader do %>
  <%= t(".preheader") %>
<% end %>

<% content_for :why_received do %>
  <%= @locker_rental.locker ? t(".why_received_with_locker") : t(".why_received_without_locker") %>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("locker_mailer.shared.hello", name: @user.name) %></p>
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <% if @locker_rental.locker %>
    <% if @locker_rental.cancelled_at %>
      <%= t(".cancelled_on_html", specifier: @locker_rental.locker.specifier, date: l(@locker_rental.cancelled_at.to_date, format: :locker_mail)) %>
    <% else %>
      <%= t(".cancelled_html", specifier: @locker_rental.locker.specifier) %>
    <% end %>
  <% else %>
    <%= t(".rejected", date: l(@locker_rental.created_at, format: :locker_mail)) %>
  <% end %>
</p>
