<% content_for :preheader do %>
  <%= t(".preheader", id: @locker_rental.id) %>
<% end %>

<% content_for :why_received do %>
  <%= t(".why_received") %>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <% if @locker_rental.requested_as_student? %>
    <%= t(".request_student", course: @locker_rental.course_name&.name, section: @locker_rental.section_name, team: @locker_rental.team_name) %>
  <% else %>
    <%= t(".request") %>
  <% end %>
</p>
<br />
<a href="<%= locker_rental_url(@locker_rental) %>" target="_blank"><%= t(".view_request") %></a>
