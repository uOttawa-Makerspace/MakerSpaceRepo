<% content_for :preheader do %>
  <%= t(".preheader") %>
<% end %>

<% content_for :why_received do %>
  <%= t("locker_mailer.shared.requested_why_received") %>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("locker_mailer.shared.hello", name: @user.name) %></p>
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t(".body_html", specifier: @locker_rental.locker.specifier) %>
  <% if @locker_rental.owned_until.present? %>
    <br><%= t(".valid_until_html", date: @locker_rental.owned_until.to_date) %>
  <% end %>
</p>
