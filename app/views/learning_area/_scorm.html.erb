<% if current_user.admin? %>
    <div class="d-flex justify-content-between mb-3">
        <%= link_to t('learning_area.edit'), edit_learning_area_path(learning_module.id), class: 'btn btn-sm btn-primary' %>
    </div>
<% end %>

<% if learning_module.scorm_ready? %>
    <div class="mb-3">
        <%= vite_javascript_tag 'learning_modules_scorm', 'data-turbo-track': 'reload' %>

        <% if learning_module.shortcut_name.present? %>
            <div class="input-group mb-3">
                <span id="permalink" class="form-control"><%= shortcut_learning_area_url(learning_module.shortcut_name) %></span>
                <button onclick="copyField('#permalink', this)" class="btn btn-primary"><%= t('learning_area.scorm.copy_permalink') %></button>
            </div>
        <% end %>

        <button type="button" class="btn btn-outline-secondary mb-3 d-block mx-auto"
                onclick="this.parentElement.querySelector('iframe').requestFullscreen()">
            <i class="fa fa-expand"></i> <%= t('learning_area.scorm.fullscreen') %>
        </button>
        <noscript>
            <%= t('learning_area.scorm.javascript_needed') %>
        </noscript>
        <iframe src="<%= scorm_launch_learning_area_path(learning_module) %>"
                title="<%= learning_module.title %>"
                width="100%"
                height="680px"
                class="d-block border rounded"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads"
                allow="autoplay; fullscreen"
                allowfullscreen="true"
                data-launch-url="<%= scorm_launch_learning_area_path(learning_module) %>"
                data-completed-url="<%= completed_learning_module_track_index_path %>"
                data-learning-module-id="<%= learning_module.id %>"
                data-cmi="<%= (track&.scorm_state || {}).to_json %>"
        >
        </iframe>

        <div id="scorm-placeholder" style="display: none;" class="border rounded p-3">
            <p class="mb-0"><%= t('learning_area.scorm.open_elsewhere') %></p>
        </div>
    </div>

<% elsif learning_module.scorm_stalled? || learning_module.scorm_failed? %>
    <%= render 'scorm_problem', learning_module: %>

<% elsif learning_module.scorm_processing? || learning_module.scorm_pending? %>
    <div class="mb-3 alert alert-info d-flex align-items-center justify-content-between p-4 border rounded" role="alert" id="scorm-processing-container">
        <div class="d-flex align-items-center">
            <div class="spinner-border text-primary me-3" role="status" style="width: 2rem; height: 2rem;">
                <span class="visually-hidden"><%= t('learning_area.scorm.loading') %></span>
            </div>
            <div>
                <h5 class="alert-heading mb-1"><%= t('learning_area.scorm.processing_heading') %></h5>
                <p class="mb-0 text-muted"><%= t('learning_area.scorm.processing_text') %></p>
            </div>
        </div>
    </div>

    <script>
      // Poll every 3 seconds; once the extraction counts as stalled the server renders the problem instead
      setTimeout(() => {
        if (window.Turbo) {
          Turbo.visit(window.location.href, { action: 'replace' });
        } else {
          window.location.reload();
        }
      }, 3000);
    </script>
<% end %>

<% if learning_module.extract_valid_urls.present? %>
    <div class="border-top mt-3 pt-3">
        <% learning_module.extract_valid_urls.each do |url| %>
            <iframe width="100%" height="600px" src="<%= url %>" title="<%= learning_module.title %>" class="d-block border-0"></iframe>
        <% end %>
    </div>
<% end %>
