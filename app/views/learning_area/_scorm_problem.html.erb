<% if current_user.staff? %>
    <div class="mb-3 alert alert-danger p-3 border rounded" id="scorm-problem">
        <h5 class="alert-heading"><%= t(learning_module.scorm_failed? ? 'learning_area.scorm_problem.failed' : 'learning_area.scorm_problem.stalled') %></h5>
        <p class="mb-0"><%= learning_module.scorm_problem %></p>
        <% if learning_module.scorm_failed? %>
            <p class="mb-0 mt-2"><%= t('learning_area.scorm_problem.valid_package_html') %></p>
        <% end %>
        <% if current_user.admin? && learning_module.scorm_retryable? %>
            <%= button_to t('learning_area.scorm_problem.retry'), retry_scorm_learning_area_path(learning_module),
                          method: :post, class: 'btn btn-sm btn-primary mt-2' %>
        <% end %>
    </div>
<% else %>
    <div class="mb-3 alert alert-warning p-3 border rounded" id="scorm-problem">
        <p class="mb-0"><%= t('learning_area.scorm_problem.unavailable') %></p>
    </div>
<% end %>
