<%= form_with model: @learning_module,
    url: { controller: 'learning_area', action: @learning_module.persisted? ? 'update' : 'create' },
    class: 'useTurbo',
    data: { controller: 'learning-module-form' } do |f| %>
    <div class="mb-3">
        <%= f.label :title, t('learning_area.form.title'), for: 'repository_title', class: 'form-label' %>
        <%= f.text_field :title,
         id: 'repository_title',
         placeholder: t('learning_area.form.title_placeholder'),
         class: 'form-control' %>
    </div>

    <div class="mb-3">
        <%= f.trix_label :description, t('common.names.description'), for: 'redactor', class: 'form-label' %>
        <div class="form-text mb-1">
            <%= t('learning_area.form.wiki_hint_html') %>
        </div>
        <%= f.trix_editor :description,
            placeholder: t('learning_area.form.description_placeholder'),
            class: 'form-control',
            id: 'redactor' %>
    </div>

    <%= f.label :shortcut_name, t('learning_area.form.shortcut'), class: 'form-label' %>
    <div class="form-text mb-1">
        <%= t('learning_area.form.shortcut_hint') %>
    </div>
    <div class="input-group mb-3">
        <span class="input-group-text"><code>/learning_modules/s/</code></span>
        <%= f.text_field :shortcut_name, class: 'form-control', pattern: '[a-zA-Z0-9_]*', title: t('learning_area.form.shortcut_hint') %>
    </div>

    <div class="mb-3">
        <%= f.label :subskill, t('learning_area.form.subskill'), id: 'learning_module_subskill_label', class: 'form-label' %>
        <%= f.select :subskill,
            options_for_select(@subskills, @learning_module.subskill),
         { include_blank: t('learning_area.form.subskill_blank') },
         { class: 'form-select',
             data: { controller: 'tomselect' },
             aria: { labelledby: 'learning_module_subskill_label' } } %>
        <div class="form-text"><%= t('learning_area.form.subskill_hint') %></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <%= f.label :training_id, t('common.names.category'), class: 'form-label' %>
            <%= f.select :training_id, @training_categories, {}, { class: 'form-select' } %>
        </div>
        <div class="col-sm-6">
            <%= f.label :level, t('common.names.level'), class: 'form-label' %>
            <%= f.select :level, @training_levels, {}, { class: 'form-select' } %>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <%= f.check_box :scorm_enabled, class: 'form-check-input', role: 'switch',
                data: { learning_module_form_target: 'scormToggle', action: 'change->learning-module-form#toggleScorm' } %>
            <%= f.label :scorm_enabled, t('learning_area.form.scorm_toggle'), class: 'form-check-label' %>
        </div>
        <div class="form-text"><%= t('learning_area.form.scorm_toggle_hint_html') %></div>
    </div>

    <fieldset id="regular-files-section" data-learning-module-form-target="regularSection">
        <%# Include this to wipe out existing package %>
        <%= f.hidden_field :scorm_package, value: nil %>
        <div class="mb-3">
            <%= f.label :project_files, t('learning_area.form.project_files'), class: 'form-label' %>
            <%= f.file_field :project_files, multiple: true, class: 'form-control', aria: { label: t('common.names.project_files') } %>
            <div id="file-container"></div>
        </div>

        <div class="mb-3">
            <%= f.label :videos, t('learning_area.form.videos'), class: 'form-label' %>
            <%= f.file_field :videos, multiple: true, class: 'form-control', aria: { label: t('common.names.videos') } %>

            <div id="video-container" class="d-flex flex-column gap-1 mt-2">
                <% @learning_module.videos.each do |video| %>
                    <div class="video-item d-flex align-items-center gap-2 border rounded p-2">
                        <% if video.persisted? %>
                            <%= hidden_field_tag 'learning_module[videos][]', video.signed_id %>
                        <% elsif video.blob&.persisted? %>
                            <%= hidden_field_tag 'learning_module[videos][]', video.blob.signed_id %>
                        <% else %>
                            <%= hidden_field_tag 'learning_module[videos][]', nil %>
                        <% end %>
                        <i class="fa fa-file-video-o"></i>
                        <span class="small flex-grow-1"><%= video.filename %></span>
                        <span class="small"><%= t('learning_area.form.file_size_mb', size: (video.byte_size / 1.megabyte).round(1)) %></span>
                        <button type="button" class="btn btn-danger btn-sm video-remove" data-action="learning-module-form#removeVideo" aria-label="<%= t('common.names.remove_video') %>">&times;</button>
                    </div>
                <% end %>
            </div>
        </div>

        <div class="mb-3">
            <%= f.label :photos, t('learning_area.form.gallery'), class: 'form-label' %>
            <div class="input-group">
                <%= f.file_field :photos, multiple: true, class: 'form-control image-upload', aria: { label: t('common.names.select_pictures') } %>
                <button class="btn btn-success" type="button" id="new-photo-input" data-action="learning-module-form#addPhoto" aria-label="<%= t('common.names.add_image_input') %>">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2">
            <% @learning_module.photos.each do |photo| %>
                <%# Only render the HTML block if the photo actually exists on disk %>
                <% if photo.persisted? || photo.blob&.persisted? %>
                    <div class="image-item">
                        <% if photo.persisted? %>
                            <%= hidden_field_tag 'learning_module[photos][]', photo.signed_id %>
                        <% elsif photo.blob&.persisted? %>
                            <%= hidden_field_tag 'learning_module[photos][]', photo.blob.signed_id %>
                        <% end %>
                        <div class="bg-dark rounded" style="width: 80px; height: 80px;">
                            <%= image_tag photo,
                                          alt: t('common.names.existing_photo'),
                                          class: 'rounded',
                                          style: 'width: 80px; height: 80px; object-fit: cover;',
                                          loading: 'lazy' %>
                        </div>
                        <button type="button"
                                class="btn btn-danger image-remove w-100"
                                data-action="learning-module-form#removeImage"
                                aria-label="<%= t('common.names.remove_photo') %>"><i class="fa-solid fa-trash"></i></button>
                    </div>
                <% end %>
            <% end %>
        </div>

        <div id="dragndrop"
             class="border rounded-3 text-center py-4 mb-3"
             ondrop="dragndrop(event);"
             ondragover="dragover(event);">
            <i class="fa-solid fa-cloud-arrow-up fs-3"></i>
            <p class="mb-0 mt-1 small"><%= t('learning_area.form.drag_drop') %></p>
        </div>
    </fieldset>

    <fieldset id="scorm-section" class="mb-3" style="display: none;" data-learning-module-form-target="scormSection">
        <%# Retain existing attachment when no new file is chosen %>
        <% if @learning_module.scorm_package.attached? %>
            <% if @learning_module.scorm_package.persisted? %>
                <%= f.hidden_field :scorm_package, value: @learning_module.scorm_package.signed_id %>
            <% elsif @learning_module.scorm_package.blob&.persisted? %>
                <%= f.hidden_field :scorm_package, value: @learning_module.scorm_package.blob.signed_id %>
            <% end %>
        <% end %>

        <%= f.label :scorm_package, class: 'form-label' do %>
            <%= t('learning_area.form.scorm_package') %>
            <% if @learning_module.scorm_package.attached? && (@learning_module.scorm_package.persisted? || @learning_module.scorm_package.blob&.persisted?) %>
                <p><%= t('learning_area.form.download_current_html', link: link_to(@learning_module.scorm_package.filename, url_for(@learning_module.scorm_package))) %></p>
            <% end %>
        <% end %>
        <%= f.file_field :scorm_package,
           class: 'form-control',
           accept: '.zip',
           direct_upload: true,
           aria: { label: t('common.names.scorm_zip') }, required: !@learning_module.scorm_package.attached? %>
        <p class="form-text"><%= t('learning_area.form.scorm_upload_hint_html') %></p>
    </fieldset>

    <div class="text-center border-top pt-4">
        <%= f.submit t(@learning_module.persisted? ? 'learning_area.form.save' : 'learning_area.form.create'),
                 class: 'btn btn-primary px-4',
                 id: 'waiting-save-button',
                 data: { turbo_submits_with: t('learning_area.form.saving') } %>
        <p class="small text-muted mt-2 mb-0">
            <%= t('learning_area.form.large_upload_hint') %>
        </p>
    </div>

<% end %>