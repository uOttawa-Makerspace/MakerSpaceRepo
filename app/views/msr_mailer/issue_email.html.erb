<% content_for :preheader do %>
    <%= t(".preheader") %>
<% end %>

<% content_for :team_name do %>
    <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
    <%= t(".why_received") %> <a href="https://makerepo.com" style="text-decoration: underline; color: #999999; font-size: 12px; text-align: center;">makerepo.com</a>.
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("msr_mailer.account.hello", name: @name) %>
    <br />
    <%= t(".received") %>
</p>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
    <%= t(".reported_by_html", name: tag.b(@name)) %>
    <% if @account %>
        <br />
        <b><%= t(".account") %> </b> <%= @account.name %> (<%= @account.username %>, <%= @account.email %>)
    <% end %>
    <% if @share_email %>
        <br />
        <b><%= t(".contact_email") %> </b> <%= @contact_email %>
    <% end %>
    <br />
    <%= t(".subject_line_html", subject: tag.b(@subject)) %> <br>
    <%= @comments %>

    <% if @app_version.present? %>
        <br>
        <%= t(".app_version", version: @app_version) %>
    <% end %>
</p>
