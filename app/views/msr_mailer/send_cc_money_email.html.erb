<% claim_url = link_cc_to_user_cc_moneys_url(token: @hash) %>
<% content_for :preheader do %>
  <%= t('msr_mailer.send_cc_money_email.preheader') %>
<% end %>

<% content_for :team_name do %>
  <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
  <%= t('msr_mailer.send_cc_money_email.why_received_html', site_link: link_to('makerepo.com', 'https://makerepo.com', style: 'text-decoration: underline; color: #999999; font-size: 12px; text-align: center;')) %>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t('msr_mailer.send_cc_money_email.hello') %></p>
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t('msr_mailer.send_cc_money_email.bought_html', site_link: link_to('MakerRepo.com', 'https://makerepo.com')) %><br>
  <%= t('msr_mailer.send_cc_money_email.amount_html', cc: @cc) %><br>
  <%= t('msr_mailer.send_cc_money_email.link_html', link: link_to(t('msr_mailer.send_cc_money_email.link_text'), claim_url)) %><br>
  <%= t('msr_mailer.send_cc_money_email.copy_link', url: claim_url) %>
</p>
<table role="presentation" class="btn btn-primary" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; box-sizing: border-box; width: 100%;" width="100%">
  <tbody>
    <tr>
      <td align="left" style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding-bottom: 15px;" valign="top">
        <table role="presentation" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: auto;">
          <tbody>
            <tr>
              <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; border-radius: 5px; text-align: center; background-color: #e55426ff;" valign="top" align="center" bgcolor="#e55426ff">
                <a href="<%= claim_url %>" target="_blank" style="border: solid 1px #e55426ff; border-radius: 5px; box-sizing: border-box; cursor: pointer; display: inline-block; font-size: 14px; font-weight: bold; margin: 0; padding: 12px 25px; text-decoration: none; background-color: #e55426ff; border-color: #e55426ff; color: #ffffff;"><%= t('msr_mailer.send_cc_money_email.button') %></a>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>