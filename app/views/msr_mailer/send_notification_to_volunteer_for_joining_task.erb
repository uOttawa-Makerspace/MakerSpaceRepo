<% content_for :preheader do %>
  <%= t(".preheader") %>
<% end %>

<% content_for :team_name do %>
  <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
  <%= t(".why_received") %> <a href="https://makerepo.com" style="text-decoration: underline; color: #999999; font-size: 12px; text-align: center;">makerepo.com</a>.
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("msr_mailer.volunteer_task.hello") %></p>
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t(".joined_html", task: tag.b(@volunteer_task.title.capitalize)) %> <br />
  <%= t("msr_mailer.volunteer_task.check_html", link: link_to(t("msr_mailer.volunteer_task.here"), "https://makerepo.com/volunteer_tasks/#{@volunteer_task.id}")) %><br />
  <%= t("msr_mailer.volunteer_task.more_info", email: @email_staff) %>
</p>