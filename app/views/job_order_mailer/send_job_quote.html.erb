<% content_for :preheader do %>
  <%= t(".preheader") %>
<% end %>

<% content_for :team_name do %>
  <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
  <%= t(".why_received_html", locale: :fr, site_link: tag.a("makerepo.com", href: "https://makerepo.com", style: "text-decoration: underline; color: #999999; font-size: 12px; text-align: center;")) %>
  <br>
  <%= t(".why_received_html", locale: :en, site_link: tag.a("makerepo.com", href: "https://makerepo.com", style: "text-decoration: underline; color: #999999; font-size: 12px; text-align: center;")) %>
<% end %>

<!-- FRENCH SECTION -->
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("job_order_mailer.hello", locale: :fr) %></p>

<% if @reminder %>
  <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
    <%= t(".reminder", locale: :fr) %>
  </p>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t(".approved_html", id: @job_order.id, link: link_to(t(".page_link", locale: :fr), user_magic_approval_job_orders_url(token: @hash)), locale: :fr) %>
</p>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <strong><%= t(".pricing", locale: :fr) %></strong><br>
  <% @job_order.job_tasks.each do |task| %>
    - <%= task.title %>
    <% if task.job_service.present? %>
      (<%= task.job_service.name %>
      <% if task.job_service.job_service_group.present? %>
        - <%= task.job_service.job_service_group.name %>
      <% end %>)
    <% end %>

    <% base_fee = task.job_task_quote&.price.to_f %>
    <% task_price = task.job_task_quote&.service_price.to_f * (task.job_task_quote&.service_quantity || 0) %>
    <% total_task_price = base_fee + task_price %>

    : 
    <% if total_task_price > 0 %>
      <%= t(".amount", amount: number_to_currency(total_task_price, locale: :fr), locale: :fr) %>
      <small>(<%= t(".base_fee", amount: number_to_currency(base_fee, locale: :fr), locale: :fr) %>
        <% if task.job_task_quote&.service_quantity.present? %>
          <%= number_with_delimiter(task.job_task_quote.service_quantity, delimiter: "", locale: :fr) %> <%= task.job_service&.unit.presence || t(".unit", locale: :fr) %>
          ×
          <%= number_to_currency(task.job_task_quote.service_price || 0, locale: :fr) %>
        <% end %>)</small>
    <% else %>
      <%= t(".pending", locale: :fr) %>
    <% end %>
    <br>

    <% task.job_task_options.each do |opt| %>
      &nbsp;&nbsp;• <%= opt.job_option.name %>
      : <%= t(".amount", amount: number_to_currency(task.job_task_quote&.price_for_option(opt.job_option_id) || 0, locale: :fr), locale: :fr) %>
      <br>
    <% end %>
  <% end %>

  <% if @job_order.job_quote_line_items.any? %>
    <strong><%= t(".line_items", locale: :fr) %></strong><br>
    <% @job_order.job_quote_line_items.each do |item| %>
      - <%= item.description %>: <%= t(".amount", amount: number_to_currency(item.price, locale: :fr), locale: :fr) %>
      <br>
    <% end %>
  <% end %>

  <strong><%= t(".grand_total", locale: :fr) %></strong> <%= t(".amount", amount: number_to_currency(@job_order.total_price, locale: :fr), locale: :fr) %>
</p>

<% if @user_comments %>
  <div style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
    <strong><%= t("job_order_mailer.quote_notes", locale: :fr) %></strong>
    <%= simple_format(h(@user_comments), {}, sanitize: false) %>
  </div>
<% end %>

<!-- ENGLISH SECTION -->
<hr style="margin: 25px 0; border: none; border-top: 1px solid #dddddd;">

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("job_order_mailer.hello", locale: :en) %></p>

