<% content_for :preheader do %>
  <%= t(".preheader") %>
<% end %>

<% content_for :team_name do %>
  <%= t("layouts.mailer.makerrepo_team") %>
<% end %>

<% content_for :why_received do %>
  <%= t(".why_received_html", site_link: tag.a("makerepo.com", href: "https://makerepo.com", style: "text-decoration: underline; color: #999999; font-size: 12px; text-align: center;")) %>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;"><%= t("job_order_mailer.hello") %></p>
<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t(".body", id: @job_order.id) %>
</p>

<% if @job_order.user_comments.present? %>
  <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
    <%= t(".comments") %> <br/>
    <span style="font-style: italic"><%= @job_order.user_comments %></span>
  </p>
<% end %>

<p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">
  <%= t(".contact_html", contact: mail_to("makerspace@uottawa.ca"), id: @job_order.id) %>
</p>