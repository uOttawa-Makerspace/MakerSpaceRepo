<div class="comment">
  <div class="comment-upvote">
    <%= button_to '<i class="fa-solid fa-angle-up"></i>'.html_safe, vote_path(comment_id: params['comment_id'], voted: false, downvote: 'f'), method: :post, class: 'vote upvote btn btn-link p-0 text-decoration-none' %>
    
    <div class="upvote upvote-<%= params['comment_id'] %>">0</div>
    
    <%= button_to '<i class="fa-solid fa-angle-down"></i>'.html_safe, vote_path(comment_id: params['comment_id'], voted: false, downvote: 't'), method: :post, class: 'vote downvote btn btn-link p-0 text-decoration-none' %>
  </div>
  
  <div class="comment-header">
    <% 
       url = params['user_url'].to_s
       begin
         parsed_url = URI.parse(url)
         safe_url = parsed_url.is_a?(URI::HTTP) ? parsed_url.to_s : '#'
       rescue URI::InvalidURIError
         safe_url = '#'
       end
    %>

    <%= link_to safe_url do %>
      <div><%= params['username'] %><div class="rep"><%= params['rep'] %></div> </div>
    <% end %>
     
    <%= tag.div("#{time_ago_in_words(params['created_at'].to_datetime)} ago", class: 'time') %>
  </div>
  
  <div class="comment-content">
    <%= sanitize params['content'] %>
  </div>
</div>