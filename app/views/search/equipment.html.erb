<% provide(:title, params[:slug].slug_to_title(params[:slug])) %>
<section id="repositories-index">
  <div class="like-title"><%= yield(:title) %></div>
  <section class="repository-filter">
    <div class="sort"><%= t('search.equipment.sort_by') %></div>
    <nav>
      <% sort_type = params[:sort].present? ? t("search.sort_names.#{params[:sort]}", default: params[:sort].gsub('_', ' ').titleize) : t('search.equipment.sort.newest') %>
      <div id="filter-header" class="filter-header"><%= sort_type %> <i class="fa-solid fa-caret-down"></i> </div>
      <ul id="sort-filter" class="filter">
        <li><%= link_to t('search.equipment.sort.newest'), equipment_path(sort: :newest, slug: params[:slug]) %></li>
        <li><%= link_to t('search.equipment.sort.most_likes'), equipment_path(sort: :most_likes, slug: params[:slug]) %></li>
        <li><%= link_to t('search.equipment.sort.most_makes'), equipment_path(sort: :most_makes, slug: params[:slug]) %></li>
        <li><%= link_to t('search.equipment.sort.recently_updated'), equipment_path(sort: :recently_updated, slug: params[:slug]) %></li>
      </ul>
    </nav>
  </section>
  <section id="repositories-container">
  <% @repositories.each_with_index do |repository, i| %>
    <div class="repository-container">

      <div class="repo-display-wrapper" <%= "style=background-image:url('#{url_for(repository.photos.first.image) if repository.photos.first.present?}')" %> >
        <%= link_to '', repository_path(repository.user_username, repository.slug), class: 'link' %>
      </div>

      <div class="repo-info">
        <div class="start">
          <div class="likes"><i class="fa-solid fa-heart"></i><br><%= repository.like %></div>
          <div class="title"><%= link_to repository.title, repository_path(repository.user_username, repository.slug) %></div>
          <div><%= t('common.by') %> <%= link_to repository.user_username, user_path(repository.user_username) %></div>
          <div><%= t('common.time_ago', time: time_ago_in_words(repository.created_at)) %></div>
        </div>
      </div>
    </div>
  <% end %>
  </section>
</section>
