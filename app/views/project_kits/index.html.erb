<% provide(:title, 'Project Kits') %>

<section class="p-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center mb-4">
        <h2><b>Your Kits</b></h2>
      </div>
    </div>
    <div class="text-center">
      <% if @kits.blank? %>
        <p class="text-center">
          Some Proficient Projects might include kits that will be used to complete it. <br />
          You have no kits. <br />
          Please check our <%= link_to 'projects', proficient_projects_path %> and add some items to your cart.
        </p>
      <% else %>
        <div class="apple_pagination text-center mb-3">
          <% if @pagy.count > 0 %>
            <small class="text-muted d-block mb-2">
              Displaying project kits <b><%= @pagy.from %></b> - <b><%= @pagy.to %></b> of <b><%= @pagy.count %></b> in total
            </small>
          <% end %>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
        <div class="">
          <table class="table table-responsive table-striped">
          <thead class="table-primary">
            <tr>
              <th>Kit</th>
              <th>Date</th>
              <th>Delivery Status</th>
            </tr>
          </thead>
            <tbody>
            <% @kits.each do |kit| %>
              <tr>
                <td><p><%= kit.proficient_project.title %></p></td>
                <td><p><%= kit.created_at.strftime('%Y/%m/%d') %></p></td>
                <td><p><%= kit.delivered? ? 'Delivered' : 'Not yet delivered' %></p></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
    <% if current_user.staff? %>
      <hr>
      <h2 class="text-center">All Kits</h2>
      <div class="text-center">
        <% if @all_kits.blank? %>
          <p class="text-center">
            No kits were bought.
          </p>
        <% else %>
          <div class="apple_pagination text-center mb-3">
            <% if @pagy_all && @pagy_all.count > 0 %>
              <small class="text-muted d-block mb-2">
                Displaying project kits <b><%= @pagy_all.from %></b> - <b><%= @pagy_all.to %></b> of <b><%= @pagy_all.count %></b> in total
              </small>
            <% end %>
            <%== @pagy_all.series_nav(:bootstrap) if @pagy_all && @pagy_all.pages > 1 %>
          </div>

          <div class="table-responsive">
            <table class="table table-striped">
            <thead class="table-primary">
              <tr>
                <th>User</th>
                <th>Kit</th>
                <th>Date</th>
                <th>Delivery Status</th>
                <th>Mark delivered</th>
                <th>Delete</th>
              </tr>
          </thead>
              <tbody>
              <% @all_kits.each do |kit| %>
                <tr>
                  <td><p> <%= link_to kit.user.name, user_path(kit.user.username) if kit.user %></p></td>
                  <td><p><%= kit.proficient_project.title %></p></td>
                  <td><p><%= kit.created_at.strftime('%Y/%m/%d') %></p></td>
                  <td><p><%= kit.delivered? ? 'Delivered' : 'Not yet delivered' %></p></td>
                    <% if !kit.delivered? %>
                      <td>
                        <%= button_to 'Mark Delivered', project_kit_mark_delivered_path(kit.id), method: :get, data: { confirm: 'Are you sure? This show the kit as delivered' }, class: 'btn btn-primary' %>
                      </td>
                    <td>
                      <%= button_to 'Delete', project_kit_path(kit.id), method: :delete, data: { confirm: 'Are you sure? This will delete the kit' }, class: 'btn btn-danger' %>
                    </td>
                    <% else %>
                     <td>
                       <p>Marked</p>
                     </td>
                    <td>Kit has already been delivered</td>
                    <% end %>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>


