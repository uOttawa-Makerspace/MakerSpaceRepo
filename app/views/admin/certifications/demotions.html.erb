<section>
  <div class="text-center">
    <h2 class="py-3 fw-bold"><%= t('admin_area.certifications.demotions') %></h2>
    <div class="mb-5 text-center mx-auto">
      <%= form_with url: demotions_admin_certifications_path, method: :get do %>
        <div class="w-auto d-inline-block text-center">
          <%= text_field_tag :search, params[:search], placeholder: t('admin_area.certifications.search_placeholder'), class: 'form-control col-md-12 search_bar text-center' %>
        </div>
      <% end %>
    </div>
    <%= render 'table_demotions' %>
  </div>
</section>
