<div class="modal-header">
  <h2 class="text-center"><%= t('admin_area.certifications.demote_heading_html', training: certification.training.localized_name, level: certification.level) %></h2>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
</div>
<div class="modal-body">
  <%= form_for certification, url: admin_certification_path(certification) do |f| %>
    <div class="row">
      <div class="col-md-12">
        <%= f.hidden_field :active, value: false %>
        <div class="mb-3 text-center">
          <%= f.text_field :demotion_reason, placeholder: t('admin_area.certifications.reason_placeholder'), class: 'form-control', required: true %>
        </div>
      </div>
    </div>
    <div class="col-lg-12 text-center">
      <%= f.submit t('admin_area.certifications.demote'), class: 'btn btn-danger btn-xl text-uppercase' %>
    </div>
  <% end %>
</div>