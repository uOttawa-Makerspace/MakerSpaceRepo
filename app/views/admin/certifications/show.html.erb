<div class="container">
    <div class="row align-items-start">
        <div class="col-4 py-3 px-my-5">
            <p><%= t('admin_area.certifications.image_placeholder') %></p>
        </div>
        <div class="col-8 py-3 px-my-5">
            <h1><%= @certification.training_session.training.localized_name %></h1>
            <h4 class="my-3 fw-bold"><%= t('admin_area.certifications.badge_owner', name: @earner.name) %></h4>
            <h5 class="my-3"><%= t("badges.show.issued_by", date: issued_date(@certification.created_at.to_date)) %></h5>
            <p><%= @certification.training_session.training.description %></p>

            <a class="my-4 text-decoration-underline" href="https://www.uottawa.ca/faculty-engineering/"><%= t('admin_area.certifications.learn_more') %></a>

            <div class="my-5">
                <h5><%= t('admin_area.certifications.skills') %></h5>
                <p><%= @certification.training_session.training.list_of_skills %></p>
            </div>
        </div> 
        <%# <%= render "badge_icon", width: 200, height: 200, level: :two %> %>

    </div>
</div>
