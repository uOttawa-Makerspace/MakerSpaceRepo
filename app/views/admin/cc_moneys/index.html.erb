<section>
  <div class="text-center pb-4">
    <h2 class="fw-bold py-3"><%= t('admin_pages.cc_moneys.title') %></h2>
    <p><%= t('admin_pages.cc_moneys.intro') %></p>
    <table class="table table-striped mb-5">
      <thead class="table-primary">
        <tr class="text-center">
          <th><%= t('admin_pages.cc_moneys.id') %></th>
          <th><%= t('admin_pages.cc_moneys.cc') %></th>
          <th><%= t('admin_pages.cc_moneys.bought') %></th>
          <th><%= t('admin_pages.cc_moneys.buyer_email') %></th>
          <th><%= t('admin_pages.cc_moneys.resend_claim') %></th>
          <th><%= t("admin.cc_money_purchase_email.heading") %></th>
        </tr>
      </thead>
      <% @cc_moneys.each do |cc_money| %>
        <tr>
          <td><%= cc_money.id %></td>
          <td><%= cc_money.cc %></td>
          <td><%= l(cc_money.created_at, format: :short) %></td>
          <td><%= cc_money.purchaser_email %></td>
          <td>
            <%= form_with url: admin_cc_money_claim_email_path(cc_money), class: "input-group" do |f| %>
              <%= f.email_field :email, placeholder: t("admin_pages.cc_moneys.buyer_email"), class: "form-control", required: true %>
              <%= f.submit t("admin_pages.cc_moneys.resend"), class: "btn btn-primary" %>
            <% end %>
            <% if (resend = cc_money.latest_claim_email_resend) %>
              <small class="text-muted"><%= t("admin.cc_money_claim_email.last_resend",
                                              email: resend.email,
                                              admin: resend.admin.username,
                                              at: l(resend.created_at, format: :short)) %></small>
            <% end %>
          </td>
          <td>
            <%= form_with url: admin_cc_money_purchase_email_path(cc_money), method: :patch, class: "input-group" do |f| %>
              <%= f.email_field :email, placeholder: t("admin.cc_money_purchase_email.placeholder"), class: "form-control", required: true %>
              <%= f.submit t("admin.cc_money_purchase_email.submit"), class: "btn btn-outline-primary" %>
            <% end %>
            <% if (correction = cc_money.latest_email_correction) %>
              <small class="text-muted"><%= t("admin.cc_money_purchase_email.last_correction",
                                              old: correction.old_email || t("admin.cc_money_purchase_email.no_old_email"),
                                              new: correction.new_email,
                                              admin: correction.admin.username,
                                              at: l(correction.created_at, format: :short)) %></small>
            <% end %>
          </td>
        </tr>
      <% end %>
    </table>
  </div>
</section>
