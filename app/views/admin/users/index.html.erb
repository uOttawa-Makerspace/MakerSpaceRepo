<% provide(:title, t('admin_area.users.index.title')) %>

<section>
  <div class="setting-title"><%= t('admin_area.users.index.title') %></div>
  <br>
  <div>
    <%= form_with url: search_admin_users_path, method: :get, class: 'input-group' do |f| %>
      <%= label_tag :filter, t('common.names.search_by'), class: 'visually-hidden' %>
      <%= select_tag 'filter', options_for_select(admin_user_search_filters), prompt: t('admin_area.users.index.search_by_prompt'), class: 'form-select form-control' %>
      <%= label_tag 'q', t('admin_area.users.index.search_users'), class: 'visually-hidden' %>
      <%= text_field_tag 'q', params[:q], placeholder: t('admin_area.users.index.search_placeholder'), class: 'form-control' %>
      <div class="input-group-append">
        <%= submit_tag t('common.names.search'), class: 'btn btn-primary form-control' %>
      </div>
    <% end %>
  </div>
  <br>
  <div>
    <% if params[:p] == "signed_in_users" %>
      <table>
        <td><h2><%= t('admin_area.users.index.signed_in_heading') %></h2></td>
        <td class="end"><%= link_to t('admin_area.users.index.show_new_users'), p: 'new_users' %></td>
      </table>

      <div class="locations">
        <table class="locations table table-striped">
          <% if params[:location].nil? %>
            <td class="current">
          <% else %>
            <td>
          <% end %>
          <%= link_to t('admin_area.users.index.all_locations'), sort: params[:sort], direction: params[:direction], p: params[:p] %></td>
          <% PiReader.distinct.pluck(:pi_location).compact.sort.each do |pi_location| %>
            <% if params[:location] == pi_location %>
              <td class="current">
            <% else %>
              <td>
            <% end %>
            <%= link_to pi_location, sort: params[:sort], direction: params[:direction], p: params[:p], location: pi_location %></td>
          <% end %>
        </table>
      </div>
    <% elsif params[:p] == "new_users" || params[:p].nil? %>
      <table>
        <td><h2><%= t('admin_area.users.index.newest_heading') %></h2></td>
        <td class="end"><%= link_to t('admin_area.users.index.show_signed_in'), p: 'signed_in_users' %></td>
      </table>
    <% end %>
    <% if !@users.any? %>
      <p style="color:gray;text-align:center;padding-top:15px;"><%= t('admin_area.users.index.no_users') %></p>
    <% else %>
      <% direction = params[:direction] == 'asc' ? 'desc' : 'asc' %>
      <table class="admin-table table table-striped" id="admin-index">
        <thead>
        <th>
          <%= link_to t('admin_area.users.columns.username'), sort: 'username', direction: direction, p: params[:p], location: params[:location] %>
          <% if params[:sort] == "username" %>
            <i class="fa-solid fa-sort-<%= direction %>"></i>
          <% end %>
        </th>
        <th>
          <%= link_to t('admin_area.users.columns.name'), sort: 'name', direction: direction, p: params[:p], location: params[:location] %>
          <% if params[:sort] == "name" %>
            <i class="fa-solid fa-sort-<%= direction %>"></i>
          <% end %>
        </th>
        <th>
          <%= link_to t('admin_area.users.columns.signed_in'), sort: 'lab_sessions.sign_in_time', direction: direction, p: params[:p], location: params[:location] %>
          <% if params[:sort] == "lab_sessions.sign_in_time" %>
            <i class="fa-solid fa-sort-<%= direction %>"></i>
          <% end %>
        </th>
        <th>
          <%= link_to t('admin_area.users.columns.joined'), sort: 'users.created_at', direction: direction, p: params[:p], location: params[:location] %>
          <% if params[:sort] == "users.created_at" %>
            <i class="fa-solid fa-sort-<%= direction %>"></i>
          <% end %>
        </th>
        <th><%= t('admin_area.users.columns.view') %></th>
        </thead>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.username.to_s, admin_user_path(user) %></td>
            <td><%= user.name %></td>
            <td>
              <% user_sessions = LabSession.where(user_id: user.id) %>
              <% if user_sessions.present? %>
                <%= t('admin_area.time_ago', time: time_ago_in_words(user_sessions.last.sign_in_time)) %>
              <% else %>
                -
              <% end %>
            </td>
            <td><%= t('admin_area.time_ago', time: time_ago_in_words(user.created_at)) %></td>
            <td class="link-table"><%= link_to '<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>'.html_safe, admin_user_path(user), aria: { label: t('common.names.view_user') } %></td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <!-- pagination code starts -->
    <% page_number = params[:page].present? ? Integer(params[:page]) : 1 %>
    <table class="pagination">
      <tr>
        <td>
          <% if page_number > 1 %>
            <%= link_to t('admin_area.previous_page'), page: page_number - 1, p: params[:p], sort: params[:sort], direction: params[:direction] %>
          <% end %>
        </td>
        <td>
          <% if page_number < @total_pages.to_i %>
            <%= link_to t('admin_area.next_page'), page: page_number + 1, p: params[:p], sort: params[:sort], direction: params[:direction] %>
          <% end %>
        </td>
      </tr>
    </table>
  </div>
</section>
