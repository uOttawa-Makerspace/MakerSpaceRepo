<% provide(:title, t('admin_area.users.show.title')) %>

<section id="user-show-admin">
  <div id="user-info">
      <div class="user-avatar">
        <%= image_tag @edit_admin_user.display_avatar, class: 'edit-avatar', alt: t('common.names.avatar') %>
        <% if @all_sessions.where("sign_out_time > ?", Time.zone.now).present? %>
          <div class="status-online">
            <i class="fa-regular fa-circle-check"></i>
            <%= t('admin_area.users.show.signed_in') %>
          </div>
        <% else %>
          <div class="status-offline">
            <i class="fa-regular fa-circle-xmark"></i>
            <%= t('admin_area.users.show.signed_out') %>
          </div>
        <% end %>
      </div>
      <div class="fullname">
        <%= @edit_admin_user.name.to_s %>
      </div>
      <div class="username">
        <%= @edit_admin_user.username %>
      </div>
      <div class="user-info account-state">
        <% if @edit_admin_user.deactivated? %>
          <i class="fa-solid fa-user-slash"></i> <%= t('admin.users.show.deactivated_on', date: l(@edit_admin_user.deactivated_at.to_date, format: :long)) %>
          <%= button_to t('admin.users.show.reactivate'), admin_user_activation_path(@edit_admin_user), method: :post, **confirmation_options(t('confirmations.users.reactivate', name: @edit_admin_user.name)), class: 'btn btn-success btn-sm' %>
        <% else %>
          <i class="fa-solid fa-user-check"></i> <%= t('admin.users.show.active') %>
          <% if @edit_admin_user.deactivatable_by?(current_user) %>
            <%= button_to t('admin.users.show.deactivate'), admin_user_activation_path(@edit_admin_user), method: :delete, **confirmation_options(t('confirmations.users.deactivate', name: @edit_admin_user.name)), class: 'btn btn-danger btn-sm' %>
          <% end %>
        <% end %>
      </div>
      <% if @edit_admin_user.gender.present? %>
        <div class="user-info">
          <i class="fa-solid fa-transgender"></i> <%= @edit_admin_user.gender %>
        </div>
      <% end %>
      <% if @edit_admin_user.faculty.present? %>
        <div class="user-info">
          <i class="fa-solid fa-book"></i> <%= t('admin_area.users.show.faculty', faculty: @edit_admin_user.faculty) %>
        </div>
      <% end %>
      <% if @edit_admin_user.use.present? %>
        <div class="user-info">
          <i class="fa-regular fa-sticky-note"></i> <%= t('admin_area.users.show.use', use: @edit_admin_user.use) %>
        </div>
      <% end %>
      <div class="user-info">
        <i class="fa-solid fa-envelope"></i>
        <%= mail_to @edit_admin_user.email %>
      </div>
      <% if @edit_admin_user.url.to_s.match?(%r{\Ahttps?://}i) %>
        <div class="user-info">
          <i class="fa-solid fa-link"></i>
          <%= link_to @edit_admin_user.url.sub(%r{\Ahttps?://}i, '').to_s, @edit_admin_user.url %>
        </div>
      <% end %>
      <% if @edit_admin_user.location.present? %>
      <div class="user-info">
        <i class="fa-solid fa-location-arrow"></i>
        <%= link_to @edit_admin_user.location, "http://maps.google.com/?q=#{@edit_admin_user.location}" %>
      </div>
      <% end %>
      <div class="user-info">
        <i class="fa-solid fa-calendar"></i> <%= t('admin_area.users.show.joined_on', date: l(@edit_admin_user.created_at, format: :admin_date)) %>
      </div>
  </div>
  <div id="user-show-admin" class="certifications">
    <hr>
    <div class="title"><%= t('admin_area.users.show.certifications') %></div>
    <% if @edit_admin_user.certifications.present? %>
      <div><%= t('admin_area.users.show.certified_for') %></div>
      <div id="cert-container">
        <% @edit_admin_user.certifications.each do |certification| %>
          <span class="certification"><%= certification.training.localized_name %></span>
        <% end %>
      </div>
    <% else %>
      <div><%= t('admin_area.users.show.no_certifications') %></div>
    <% end %>
  </div>
  <div id="user-show-admin" class="sessions">
    <hr>
    <div class="title"><%= t('admin_area.users.show.lab_statistics') %></div>
    <div id="user-info">
      <% if @all_sessions.present? %>
        <div class="user-info">
          <% if @all_sessions.first.sign_out_time > Time.zone.now %>
            <i class="fa-regular fa-calendar-check"></i> <%= t('admin_area.users.show.in_lab') %>
          <% elsif (@all_sessions.first.sign_out_time < (Time.zone.now - 7.days)) %>
            <i class="fa-regular fa-calendar-check"></i> <%= t('admin_area.users.show.last_seen_on', date: l(@all_sessions.first.sign_out_time, format: :admin_date)) %>
          <% else %>
            <i class="fa-regular fa-calendar-check"></i> <%= t('admin_area.users.show.last_seen_ago', time: time_ago_in_words(@all_sessions.first.sign_out_time)) %>
          <% end %>
        </div>
        <div class="user-info">
            <i class="fa-regular fa-calendar-plus"></i> <%= t('admin_area.users.show.visits', number: @all_sessions.count) %>
        </div>
        <div class="user-info">
            <i class="fa-regular fa-clock"></i> <%= t('admin_area.users.show.average_time', minutes: @average_time) %>
        </div>
        <div class="subtitle"><%= t('admin_area.users.show.recent_sessions') %></div>
        <table class="admin-table table table-striped">
          <thead class="table-primary">
            <th><%= t('admin_area.users.show.sign_in_time') %></th>
            <th><%= t('admin_area.users.show.sign_out_time') %></th>
            <th><%= t('admin_area.users.show.time_spent') %></th>
            <th><%= t('admin_area.users.show.location') %></th>
          </thead>
          <% @all_sessions.limit(10).each do |session| %>
            <% if session.sign_out_time > Time.zone.now %>
              <tr class="current-session">
                <td><%= l(session.sign_in_time, format: :admin_date_seconds) %></td>
                <td><%= t('admin_area.users.show.current_session') %></td>
                <td><%= t('admin_area.users.show.minutes_so_far', minutes: ((Time.zone.now - session.sign_in_time) / 60).round) %></td>
                <td><%= PiReader.find_by_mac(session.mac_address).try(:pi_location) %></td>
              </tr>
             <% else %>
              <tr>
                <td><%= l(session.sign_in_time, format: :admin_date_seconds) %></td>
                <td><%= l(session.sign_out_time, format: :admin_date_seconds) %></td>
                <td><%= t('admin_area.users.show.minutes', minutes: ((session.sign_out_time - session.sign_in_time) / 60).round) %></td>
                <td><%= PiReader.find_by_mac(session.mac_address).try(:pi_location) %></td>
              </tr>
            <% end %>
          <% end %>
        </table>
      <% else %>
        <div class="user-info">
          <i class="fa-regular fa-calendar-times"></i> <%= t('admin_area.users.show.never_seen') %>
        </div>
      <% end %>
    </div>
  </div>
</section>
</div>
