<% provide(:title, t('admin_area.users.edit.title')) %>

<section>
  <%= form_for @edit_admin_user, url: { controller: 'admin/users', action: 'update' }, html: { class: 'edit_admin_user' } do |f| %>
    <%= link_to t('admin_area.users.edit.view_user_html'), admin_user_path(@edit_admin_user), class: 'edit-user-link' %>
    <div class="setting-title"><%= t('admin_area.users.edit.heading', username: @edit_admin_user.username_in_database) %></div>
    <br>

    <!-- BASIC INFO -->
    <div class="p-3 bg-body-tertiary rounded border flex-fill mb-4 mt-4">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-envelope-at-fill text-info me-2 fs-5"></i>
      <h6 class="m-0 fw-bold"><%= t('admin_area.users.edit.details') %></h6>
    </div>
    <div class="mb-3">
      <%= f.label :name, t('settings.profile.full_name'), class: 'form-label' %>
      <%= f.text_field :name, class: 'form-control profile-text', autofocus: true %>
      <% if @edit_admin_user.errors[:name].any? %>
        <div class="text-danger small mt-1"><%= @edit_admin_user.errors[:name].first %></div>
      <% end %>
    </div>

    <%= f.label :username, class: 'form-label profile-label' %>
    <%= f.text_field :username, class: 'profile-text' %>
    <% if @edit_admin_user.errors[:username].any? %>
      <div class="text-danger small mt-1"><%= @edit_admin_user.errors[:username].first %></div>
    <% end %>
    <%= f.label :gender, class: 'form-label profile-label' %>
    <%= f.text_field :gender, class: 'profile-text' %>

    <%= f.label :student_id, t('users.new.form.student_id'), class: ['form-label', ('required' if @edit_admin_user.student?)] %>
    <%# No browser pattern: stored ids come in many lengths, and the model decides which are valid %>
    <%= f.text_field :student_id, { class: 'form-control', inputmode: 'numeric', autocomplete: 'off' } %>
    <br>
    <%= f.label :faculty, t('users.new.form.faculty'), class: 'form-label' %>
    <% faculty_options = [
          [t('users.new.form.arts'), 'Arts'],
          [t('users.new.form.law'), 'Law'], [t('users.new.form.education'), 'Education'],
          [t('users.new.form.engineering'), 'Engineering'], [t('users.new.form.health_sciences'), 'Health Sciences'],
          [t('users.new.form.medicine'), 'Medicine'], [t('users.new.form.science'), 'Science'],
          [t('users.new.form.social_sciences'), 'Social Sciences'], [t('users.new.form.telfer'), 'Telfer School of Management']
        ] %>
    <%# Keep a stored faculty that is not one of the options, so saving another field does not blank it %>
    <% current_faculty = @edit_admin_user.faculty_in_database %>
    <% faculty_options.unshift([current_faculty, current_faculty]) if current_faculty.present? && faculty_options.none? { |_, value| value == current_faculty } %>
    <%= f.select :faculty, faculty_options, { prompt: t('users.new.form.choose.faculty') }, { class: 'form-select profile-select' } %>
    <%= f.label :year_of_study, t('users.new.form.year_of_study'), class: 'form-label' %>
    <%= f.select :year_of_study, year_of_study_options(@edit_admin_user), { selected: @edit_admin_user.current_year_of_study, prompt: t('users.new.form.choose.default') }, class: 'form-select profile-select' %>

    <%= f.label :use, t('admin_area.users.edit.use'), class: 'form-label profile-label' %>
    <%= f.text_field :use, class: 'profile-text' %>
    
    <%= f.label :rfid, t('admin_area.users.edit.rfid'), class: 'form-label profile-label' %>
    <%= f.select :rfid, rfid_options_list(@rfids, @edit_admin_user), {}, { class: 'profile-select form-select form-control'} %>

    <%= f.submit t('admin_area.users.edit.update_user'), class: 'btn btn-primary' %>

    </div>

<% end %> <!--Close main form-->

    <!--Edit Email Form-->
    <div class="p-3 bg-body-tertiary rounded border flex-fill mb-4 mt-4">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-envelope-at-fill text-info me-2 fs-5"></i>
      <h6 class="m-0 fw-bold"><%= t('admin_area.users.edit.change_email') %></h6>
    </div>

    <%= form_tag change_email_admin_user_path(@edit_admin_user), method: :patch do %>
      <div class="mb-2">
        <%= label_tag :new_email, t('admin_area.users.edit.new_email'), class: 'form-label small text-muted' %>
        <%= email_field_tag :new_email, '', { class: 'form-control form-control-sm', placeholder: t('admin_area.users.edit.email_placeholder'), required: true } %>
      </div>

      <div class="mb-3">
        <%= label_tag :confirm_new_email, t('admin_area.users.edit.confirm_email'), class: 'form-label small text-muted' %>
        <%= email_field_tag :confirm_new_email, '', { class: 'form-control form-control-sm', placeholder: t('admin_area.users.edit.email_placeholder'), required: true } %>
      </div>

      <%= submit_tag t('admin_area.users.edit.update_email'), class: 'btn btn-primary' %>
    <% end %>
  </div>
</section>
