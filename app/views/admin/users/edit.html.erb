<% provide(:title, 'Edit user') %>

<section>
  <%= form_for @edit_admin_user, url: { controller: 'admin/users', action: 'update' }, html: { class: 'edit_admin_user' } do |f| %>
    <%= link_to "<i class=\"fa-solid fa-magnifying-glass\"></i> View user".html_safe, admin_user_path(@edit_admin_user), class: 'edit-user-link' %>
    <div class="setting-title">Editing user: <%= @edit_admin_user.username %></div>
    <br>

    <!-- BASIC INFO -->
    <div class="p-3 bg-body-tertiary rounded border flex-fill mb-4 mt-4">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-envelope-at-fill text-info me-2 fs-5"></i>
      <h6 class="m-0 fw-bold">Edit User Details</h6>
    </div>
    <div class="mb-3">
      <%= f.label :name, t('settings.profile.full_name'), class: 'form-label' %>
      <%= f.text_field :name, class: 'form-control profile-text', autofocus: true %>
      <% if @edit_admin_user.errors[:name].any? %>
        <div class="text-danger small mt-1"><%= @edit_admin_user.errors[:name].first %></div>
      <% end %>
    </div>

    <%= f.label :username, class: 'form-label profile-label' %>
    <%= f.text_field :username, class: 'profile-text' %>
    <% if @edit_admin_user.errors[:username].any? %>
      <div class="text-danger small mt-1"><%= @edit_admin_user.errors[:username].first %></div>
    <% end %>
    <%= f.label :gender, class: 'form-label profile-label' %>
    <%= f.text_field :gender, class: 'profile-text' %>

    <%= f.label :student_id, t('users.new.form.student_id'), class: 'form-label' %>
    <%= f.text_field :student_id, { class: 'form-control', inputmode: 'numeric', autocomplete: 'off', minlength: '9', maxlength: '9', pattern: '[0-9]{9}', title: '9 digit number' } %>
    <br>
    <%= f.label :faculty, t('users.new.form.faculty'), class: 'form-label' %>
    <%= f.select :faculty, [
          [t('users.new.form.arts'), 'Arts'],
          [t('users.new.form.law'), 'Law'], [t('users.new.form.education'), 'Education'],
          [t('users.new.form.engineering'), 'Engineering'], [t('users.new.form.health_sciences'), 'Health Sciences'],
          [t('users.new.form.medicine'), 'Medicine'], [t('users.new.form.science'), 'Science'],
          [t('users.new.form.social_sciences'), 'Social Sciences'], [t('users.new.form.telfer'), 'Telfer School of Management']
        ], { prompt: t('users.new.form.choose.faculty') }, { class: 'form-select profile-select' } %>
    <%= f.label :year_of_study, t('users.new.form.year_of_study'), class: 'form-label' %>
    <%= f.select :year_of_study, (1..10).to_a.map { |n| [n, n] }, { prompt: t('users.new.form.choose.default') }, class: 'form-select profile-select' %>

    <%= f.label :use, class: 'form-label profile-label' %>
    <%= f.text_field :use, class: 'profile-text' %>
    
    <%= f.label :rfid, class: 'form-label profile-label' %>
    <%= f.select :rfid, rfid_options_list(@rfids, @edit_admin_user), {}, { class: 'profile-select form-select form-control'} %>

    <%= f.submit 'Update User', class: 'btn btn-primary' %>

    </div>

<% end %> <!--Close main form-->

    <!--Edit Email Form-->
    <div class="p-3 bg-body-tertiary rounded border flex-fill mb-4 mt-4">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-envelope-at-fill text-info me-2 fs-5"></i>
      <h6 class="m-0 fw-bold">Change Email</h6>
    </div>

    <%= form_tag change_email_admin_user_path(@edit_admin_user), method: :patch do %>
      <div class="mb-2">
        <%= label_tag :new_email, 'New Email Address', class: 'form-label small text-muted' %>
        <%= email_field_tag :new_email, '', { class: 'form-control form-control-sm', placeholder: 'name@example.com', required: true } %>
      </div>

      <div class="mb-3">
        <%= label_tag :confirm_new_email, 'Confirm Email', class: 'form-label small text-muted' %>
        <%= email_field_tag :confirm_new_email, '', { class: 'form-control form-control-sm', placeholder: 'name@example.com', required: true } %>
      </div>

      <%= submit_tag 'Update Email', class: 'btn btn-primary' %>
    <% end %>
  </div>
</section>
