<style>
 <% @space_list.each do |space| %>
 .btn-outline-space-<%= space.id %> {
   --bs-btn-color: var(--bs-body-color);
   --bs-btn-border-color: <%= space.assigned_color_hex %>;
   --bs-btn-hover-color: <%= space.assigned_color_text %>;
   --bs-btn-hover-bg: <%= space.assigned_color_hex %>;
   --bs-btn-hover-border-color: <%= space.assigned_color_hex %>;
   --bs-btn-active-color: <%= space.assigned_color_text %>;
   --bs-btn-active-bg: <%= space.assigned_color_hex %>;
   --bs-btn-active-border-color: <%= space.assigned_color_hex %>;
 }
 <% end %>
</style>
