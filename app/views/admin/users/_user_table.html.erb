<thead class="table-primary">
  <tr class="text-center">
    <th><%= t('admin_area.users.columns.name') %></th>
    <th><%= t('admin_area.users.columns.username') %></th>
    <th><%= t('admin_area.users.columns.email') %></th>
    <th><%= t('admin_area.users.columns.spaces') %></th>
    <th><%= t('admin_area.users.columns.role') %></th>
  </tr>
</thead>
<%# Passed as partial local (users and user_spaces)%>
<% users.each do |admin| %>
  <tr>
    <td><%= admin.name %></td>
    <td><%= link_to admin.username, user_url(admin.username) %></td>
    <td><%= admin.email %></td>
    <td>
      <div class="row row-cols-lg-2 justify-content-center">
        <% @space_list.each do |space| %>
          <%# use check_box_tag, not check_box, to avoid sending a 'ghost value'. In this case we do want values to be left out%>
          <% button_id = "space-#{space.name.parameterize.underscore}-#{admin.id}" %>
          <%= check_box_tag "spaces[#{admin.id}][]", space.id, (user_spaces[admin.id].include? space.id),
                            form: space_form_id, class: 'btn-check set-user-space-button', id: button_id,
                            data: { user_id: admin.id, space_id: space.id } %>
          <%= label_tag button_id, space.name, class: "btn btn-outline-primary btn-outline-space-#{space.id}" %>
      <% end %>
      </div>
    </td>
    <td>
      <%# Add padding to the label to fill the table cell. Yes you can put inputs inside labels %>
      <label>
        <%# include the user ID %>
        <input type="checkbox" name="user_ids[]" value="<%= admin.id %>" form="<%= role_form_id %>"/>
        <%= admin.role.humanize %>
      </label>
    </td>
  </tr>
<% end %>
<tr>
  <td colspan="3"></td>
  <td colspan="1">
    <%= form_tag set_role_admin_users_path, method: :patch, id: space_form_id do %>
      <%= submit_tag t('admin_area.users.roles.change_spaces'), class: 'btn btn-primary' %>
    <% end %>
  </td>
  <td colspan="1">
    <%= form_tag set_role_admin_users_path, method: :patch, id: role_form_id do %>
      <div class="input-group">
        <%= select_tag(:role, options_for_select(@roles.map { |r| [r.humanize, r] }), class: 'form-control form-select', aria: { label: t('common.names.role') }) %>
        <%= submit_tag t('admin_area.users.roles.commit'), id: 'change-button', class: 'btn btn-primary form-control' %>
      </div>
    <% end %>
  </td>
</tr>
<%= render 'space_button_styles' %>
