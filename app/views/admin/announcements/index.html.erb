<div class="text-center">
  <br />
  <h2 class="fw-bold"><%= t('admin_pages.announcements.title') %></h2>

  <%= link_to t('admin_pages.announcements.new'), new_admin_announcement_path, class: 'btn btn-primary m-1' %>

  <br><br>

  <% if !@announcements.blank? %>
    <input type="text" id="query" onkeyup="findSession('sessions-table')" placeholder="<%= t('admin_pages.announcements.find_placeholder') %>" class="form-control mx-auto">

    <br />

    <div class="table-responsive">
      <table class="table sessions-table  table-striped">
        <thead class="table-primary">
          <tr>
            <th><%= t('admin_pages.announcements.date_submitted') %> <span onclick="sortTable('sessions-table', 0, true)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('admin_pages.common.description') %> <span onclick="sortTable('sessions-table', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('admin_pages.announcements.public') %><span onclick="sortTable('sessions-table', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('admin_pages.announcements.active') %><span onclick="sortTable('sessions-table', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('admin_pages.announcements.created_by') %><span onclick="sortTable('sessions-table', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('admin_pages.announcements.dismissed_by') %><span onclick="sortTable('sessions-table', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th class="action-header"><%= t('admin_pages.common.action') %></th>
          </tr>
        </thead>
        <tbody>
        <% @announcements.each do |a| %>
          <tr>
            <td>
              <%= a.created_at.strftime('%m/%e/%Y (%b)') %>
              <br>
              <%= a.created_at.strftime('%I:%M %p').downcase %>
            </td>

            <td>
              <%= a.description %>
            </td>

            <td>
              <%= return_public(a.public_goal) %>
            </td>

            <td>
              <%= return_active(a) %>
            </td>

            <td class = "username">
              <%= link_to a.user.name.titleize, user_path(a.user.username) %>
              <br />
            </td>


            <td>
              <% dismissers = a.announcement_dismisses.map { |dismiss| dismiss.user.username } %>
              <span data-bs-toggle="tooltip" title="<%= dismissers.size > 5 ? t('admin_pages.announcements.and_more', names: dismissers.take(5).join(', ')) : dismissers.join(', ') %>"><%= t('admin_pages.announcements.dismissed_by_count', who: dismissers.any? ? t('admin_pages.announcements.dismissed_users', count: dismissers.size) : t('admin_pages.announcements.dismissed_no_one')) %>
              </span>
            </td>
            <td class="action-cell">
              <%= link_to t('admin_pages.common.edit'), edit_admin_announcement_path(a.id), class: 'btn btn-primary d-block w-100 btn-sm' if current_user.staff? %>
              <%= link_to t('admin_pages.common.show'), admin_announcement_path(a.id), class: 'btn btn-info d-block w-100 btn-sm my-2' %>
              <%= button_to t('admin_pages.common.delete'), { controller: :announcements, action: :destroy, id: a.id }, method: :delete,
                                                                                                  **confirmation_options(t('confirmations.announcements.delete')),
                                                                                                  class: 'btn btn-danger btn-sm d-block w-100 me-0' %>
            </td>

          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="m-5">
      <%= t('admin_pages.announcements.empty') %>
    </div>
    <br>
  <% end %>
</div>
