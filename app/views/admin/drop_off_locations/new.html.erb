<section>
  <div class="text-center pb-4">
    <h2 class="fw-bold py-3"><%= t('admin_pages.drop_off_locations.new_title') %></h2>
    <div class="float-end">
      <%= link_to t('admin_pages.common.back'), admin_drop_off_locations_path %>
    </div>
    <br />
    <%= form_for @new_location, url: { controller: 'admin/drop_off_locations', action: 'create' } do |f| %>
      <div class="container">
        <div class="row text-center">
          <div class="col-md-12 form-group">
            <%= t('admin_pages.drop_off_locations.name') %> <%= f.text_field :name, placeholder: t('admin_pages.drop_off_locations.placeholder'), class: 'form-control', required: true %>
          </div>

          <div class="col-md-12 form-group my-1">
            <%= f.submit t('admin_pages.drop_off_locations.create'), class: 'btn btn-secondary btn-xl' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>