<% provide(:title, t('admin_pages.settings.page_title')) %>

<section>
  <br><br>
  <div class="row">
    <div class="col-md-6">
      <h5><%= t('admin_pages.settings.category_options') %></h5><hr>
      <%= form_for @cat_option, url: { controller: 'admin/settings', action: 'add_category' } do |f| %>
        <%= f.label :name, t('admin_pages.settings.add_category'), class: 'form-label profile-label' %>
        <%= f.text_field :name, class: 'profile-text' %>
        <%= f.submit t('admin_pages.common.add'), class: 'btn btn-primary' %>
      <% end %>
      <br>
      <%= form_for @cat_option, url: { controller: 'admin/settings', action: 'remove_category' } do |f| %>
        <%= label_tag :remove_category, t('admin_pages.settings.remove_category'), class: 'form-label profile-label' %>
        <%= select_tag :remove_category, options_from_collection_for_select(CategoryOption.show_options, :id, :name), class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_category') %>
        <%= f.submit t('admin_pages.common.remove'), class: 'btn btn-primary' %>
      <% end %>
      <br><br>
    </div>
    <div class="col-md-6">
      <h5><%= t('admin_pages.settings.area_options') %></h5><hr>
      <%= form_for @area_option, url: { controller: 'admin/settings', action: 'add_area' } do |f| %>
        <%= f.label :name, t('admin_pages.settings.add_area'), class: 'form-label profile-label' %>
        <%= f.text_field :name, class: 'profile-text' %>
        <%= f.submit t('admin_pages.common.add'), class: 'btn btn-primary' %>
      <% end %>
      <br>
      <%= form_for @area_option, url: { controller: 'admin/settings', action: 'remove_area' } do |f| %>
        <%= label_tag :remove_area, t('admin_pages.settings.remove_area'), class: 'form-label profile-label' %>
        <%= select_tag :remove_area, options_from_collection_for_select(AreaOption.show_options, :id, :name), class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_area') %>
        <%= f.submit t('admin_pages.common.remove'), class: 'btn btn-primary' %>
      <% end %>
      <br><br>
    </div>
    <div class="col-md-6">
      <h5><%= t('admin_pages.settings.equipment_options') %></h5><hr><br>
      <%= form_for @equip_option, url: { controller: 'admin/settings', action: 'add_equipment' } do |f| %>
        <%= f.label :name, t('admin_pages.settings.add_equipment'), class: 'form-label profile-label' %>
        <%= f.text_field :name, class: 'profile-text' %>
        <%= f.submit t('admin_pages.common.add'), class: 'btn btn-primary' %>
      <% end %>
      <br>
      <%= form_for @equip_option, url: { controller: 'admin/settings', action: 'remove_equipment' } do |f| %>
        <%= label_tag :remove_equipment, t('admin_pages.settings.remove_equipment'), class: 'form-label profile-label' %>
        <%= select_tag :remove_equipment, options_from_collection_for_select(EquipmentOption.show_options, :id, :name), class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_equipment') %>
        <%= f.submit t('admin_pages.common.remove'), class: 'btn btn-primary' %>
      <% end %>
      <br>
      <%= form_for @equip_option, url: { controller: 'admin/settings', action: 'rename_equipment' } do |f| %>
        <%= label_tag :rename_equipment, t('admin_pages.settings.rename_equipment'), class: 'form-label profile-label' %>
        <%= select_tag :rename_equipment, options_from_collection_for_select(EquipmentOption.show_options, :id, :name), class: 'profile-select form-select', include_blank: t('admin_pages.settings.select') %>
        <%= f.text_field :name, class: 'profile-text', id: 'rename_equipment_text', aria: { label: t('common.names.new_equipment_name') } %>
        <%= f.submit t('admin_pages.common.rename'), class: 'btn btn-primary' %>
      <% end %>
      <br><br>
    </div>
    <div class="col-md-6">
      <h5><%= t('admin_pages.settings.card_reader_options') %></h5><hr>
      <br>
      <%= form_for @pi_option, url: { controller: 'admin/settings', action: 'remove_pi' } do |f| %>
        <%= label_tag :remove_pi, t('admin_pages.settings.remove_card_reader'), class: 'form-label profile-label' %>
        <%= select_tag :remove_pi, options_from_collection_for_select(PiReader.all, :id, :pi_mac_with_location), class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_card_reader') %>
        <%= f.submit t('admin_pages.common.remove'), class: 'btn btn-primary' %>
      <% end %>
      <br><br>
    </div>
    <div class="col-md-6">
      <div class="mb-5">
        <h5><%= t('admin_pages.settings.processed_email') %></h5><hr/>
        <p><%= t('admin_pages.settings.processed_placeholders') %></p>
        <%= form_for @job_order_processed_message, url: update_job_order_processed_admin_settings_path do |f| %>
          <%= f.trix_editor :message, class: 'repo form-control mb-2', style: 'height: auto!important;', aria: { label: t('common.names.job_order_processed_message') } %>

          <%= f.submit t('admin_pages.common.update'), class: 'btn btn-primary' %>
        <% end %>
      </div>
      <div>
        <h5><%= t('admin_pages.settings.print_failed_email') %></h5><hr/>
        <p><%= t('admin_pages.settings.print_failed_placeholders') %></p>
        <%= form_for @print_failed_message, url: update_print_failed_message_admin_settings_path do |f| %>
          <%= f.trix_editor :message, class: 'repo form-control mb-2', style: 'height: auto!important;', aria: { label: t('common.names.print_failed_message') } %>
          <%= f.submit t('admin_pages.common.update'), class: 'btn btn-primary' %>
        <% end %>
      </div>
    </div>
    <div class="col-md-6">
      <h5><%= t('admin_pages.settings.course_options') %></h5><hr>
      <%= form_with url: { controller: 'admin/settings', action: 'add_course' }, class: 'mb-4' do |f| %>
        <%= label_tag :create_course_name, t('admin_pages.settings.create_course'), class: 'form-label profile-label' %>
        <%= f.text_field :name, id: 'create_course_name', class: 'profile-text', placeholder: t('admin_pages.settings.unique_placeholder') %>
        <%= f.submit t('admin_pages.common.create'), class: 'btn btn-primary' %>
      <% end %>
      <%= form_with url: { controller: 'admin/settings', action: 'remove_course' }, class: 'mb-4', method: :delete do |f| %>
        <%= label_tag :remove_course_id, t('admin_pages.settings.remove_course'), class: 'form-label profile-label' %>
        <%= select_tag :id, options_from_collection_for_select(CourseName.all.order(:name), :id, :name), id: 'remove_course_id', class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_course') %>
        <%= f.submit t('admin_pages.common.remove'), class: 'btn btn-primary' %>
      <% end %>
      <%= form_with url: { controller: 'admin/settings', action: 'rename_course' }, class: 'mb-4', method: :patch do |f| %>
        <%= label_tag :rename_course_id, t('admin_pages.settings.rename_course'), class: 'form-label profile-label' %>
        <%= select_tag :id, options_from_collection_for_select(CourseName.all.order(:name), :id, :name), id: 'rename_course_id', class: 'profile-select form-select', include_blank: t('admin_pages.settings.select_course') %>
        <%= f.text_field :name, class: 'profile-text', placeholder: t('admin_pages.settings.unique_placeholder') %>
        <%= f.submit t('admin_pages.common.rename'), class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</section>
