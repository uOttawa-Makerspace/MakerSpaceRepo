<div class="text-center">
  <br />
  <h2 class="fw-bold">University Programs</h2>
  <%= link_to 'Download University Programs', admin_uni_programs_current_programs_path, class: 'btn btn-primary m-3' %>
  <div class="mb-3">
    <%= form_tag admin_uni_programs_import_programs_path, method: :post, multipart: true, class: 'w-100' do %>
    <p>Upload CSV file to update programs. Programs missing from the file are marked inactive and no longer offered on the sign-up and profile forms</p>
    <div class="input-group mb-3">
      <%= file_field_tag :file, style: 'display: inline;', class: 'form-control', accept: 'text/csv', aria: { label: t('common.names.programs_file') } %>
      <%= submit_tag 'Import File', class: 'btn btn-primary' %>
    </div>
    <%= check_box_tag :allow_new_programs, '1', false, class: 'form-check-input' %>
    <%= label_tag :allow_new_programs, 'Allow introducing new faculties', class: 'form-check-label' %>
    <% end %>
  </div>
  <hr/>
  <% if @uni_programs.empty? %>
  <h2>No Programs...</h2>
  <% end %>
  <%# This shows duplicated programs under multiple faculties/levels, intentional %>
  <% @uni_programs.group_by { |x| x['faculty'] }.each do |faculty, rest| %>
  <div class="mb-5 accordion">
    <div class="card">
      <div class="card-header position-relative">
        <h2 class="mb-0 text-center" id="accordion-<%= faculty.gsub(/[ ()]/, '') %>-heading">
          <button class="btn btn-link stretched-link" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-<%= faculty.gsub(/[ ()]/, '') %>" aria-expanded="false">
            <%= faculty %> - <%= rest.count %> programs
          </button>
        </h2>
      </div>
      <div id="accordion-<%= faculty.gsub(/[ ()]/, '') %>" class="collapse" aria-labelledby="accordion-<%= faculty.gsub(/[ ()]/, '') %>-heading">
        <% if faculty == "Engineering" then %>
        <% rest.group_by { |x| x['department'] }.each { |department, rest| %>
        <div class="mb-5 accordion">
          <div class="card">
            <div class="card-header position-relative">
              <h2 class="mb-0 text-center" id="accordion-<%= department.gsub(/[ ()]/, '') %>-heading">
                <button class="btn btn-link stretched-link" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-<%= department.gsub(/[ ()]/, '') %>" aria-expanded="true">
                  <%= department %> - <%= rest.count %> programs
                </button>
              </h2>
            </div>
            <div id="#accordion-<%= department.gsub(/[ ()]/, '') %>" class="show" aria-labelledby="accordion-<%= department.gsub(/[ ()]/, '') %>-heading">
              <table class="mb-5 table table-striped text-center">
                <thead>
                  <th>Program</th>
                  <th>Level</th>
                </thead>
                <% rest.sort_by { |x| x['program'] }.each do |program| %>
                <tr>
                  <td><%= program['program'] %></td>
                  <td><%= program['level'] %></td>
                </tr>
                <% end %>
              </table>
            </div>
          </div>
        </div>
      <% } else %>
      <table class="mb-5 table table-striped text-center">
        <thead>
          <th>Program</th>
          <th>Level</th>
        </thead>
        <% rest.sort_by { |x| x['program'] }.each do |program| %>
        <tr>
          <td><%= program['program'] %></td>
          <td><%= program['level'] %></td>
        </tr>
        <% end %>
      </table>
      <% end %>
    </div>
  </div>
</div>
<% end %>

  <% if @retired_programs.any? %>
  <hr/>
  <section class="mb-5">
    <h2><%= t('admin.retired_programs.heading') %></h2>
    <p><%= t('admin.retired_programs.note') %></p>
    <table class="table table-striped text-center">
      <thead>
        <th><%= t('admin.retired_programs.program') %></th>
        <th><%= t('admin.retired_programs.level') %></th>
        <th><%= t('admin.retired_programs.faculty') %></th>
      </thead>
      <% @retired_programs.each do |program| %>
      <tr>
        <td><%= program.program %></td>
        <td><%= program.level %></td>
        <td><%= program.faculty %></td>
      </tr>
      <% end %>
    </table>
  </section>
  <% end %>

</div>
