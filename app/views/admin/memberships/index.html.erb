<div class="container mt-5">
  <h1><%= t('admin_pages.memberships.title') %></h1>

  <table class="table table-striped mt-4">
    <thead>
      <tr>
        <th scope="col"><%= t('admin_pages.memberships.id') %></th>
        <th scope="col"><%= t('admin_pages.memberships.title_en') %></th>
        <th scope="col"><%= t('admin_pages.memberships.title_fr') %></th>
        <th scope="col"><%= t('admin_pages.memberships.internal_price') %></th>
        <th scope="col"><%= t('admin_pages.memberships.external_price') %></th>
        <th scope="col"><%= t('admin_pages.memberships.duration') %></th>
        <th scope="col"><%= t('admin_pages.common.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% MembershipTier.order(:id).each do |tier| %>
        <tr>
          <%= form_with model: tier, url: admin_membership_path(tier), method: :patch, local: true do |f| %>
            <% disabled = tier.hidden %>
            <td><%= tier.id %></td>
            <td><%= f.text_field :title_en, class: "form-control", disabled: disabled %></td>
            <td><%= f.text_field :title_fr, class: "form-control", disabled: disabled %></td>
            <td><%= f.number_field :internal_price, class: "form-control", step: 0.01, disabled: disabled %></td>
            <td><%= f.number_field :external_price, class: "form-control", step: 0.01, disabled: disabled %></td>
            <td><%= f.number_field :duration, class: "form-control", step: 1, disabled: disabled %></td>
            <td>
                <%= f.submit t("admin_pages.common.save"), class: "btn btn-primary btn-sm", disabled: disabled %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
