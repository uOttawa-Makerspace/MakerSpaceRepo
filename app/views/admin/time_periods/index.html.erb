<div class="text-center">
  <br />
  <h2 class="fw-bold"><%= t('admin_pages.time_periods.title') %></h2>

  <%= link_to t('admin_pages.time_periods.new'), new_admin_time_period_path, class: 'btn btn-primary m-1' %>

  <br><br>

  <% if !@time_periods.blank? %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead class="table-primary">
        <tr>
          <th><%= t('admin_pages.common.name') %></th>
          <th><%= t('admin_pages.time_periods.start_date') %></th>
          <th><%= t('admin_pages.time_periods.end_date') %></th>
          <th><%= t('admin_pages.common.actions') %></th>
        </tr>
        </thead>
        <tbody>
        <% @time_periods.each do |t| %>
          <tr>

            <td>
              <%= t.name %>
            </td>

            <td>
              <%= t.start_date&.strftime('%m/%e/%Y') %>
            </td>

            <td>
              <%= t.end_date&.strftime('%m/%e/%Y') %>
            </td>
            <td class="action-cell">
              <%= link_to t('admin_pages.common.edit'), edit_admin_time_period_path(t.id), class: 'btn btn-primary d-block w-100 btn-sm mb-2' %>
              <%= button_to t('admin_pages.common.delete'), { controller: :time_periods, action: :destroy, id: t.id }, method: :delete,
                                                                                                 **confirmation_options(t('confirmations.time_periods.delete')),
                                                                                                 class: 'btn btn-danger btn-sm d-block w-100 me-0' %>
            </td>

          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-warning">
      <%= t('admin_pages.time_periods.empty') %>
    </div>
    <br>
  <% end %>
</div>
