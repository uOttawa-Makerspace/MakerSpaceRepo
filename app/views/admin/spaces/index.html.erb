<section>
  <h2 class="fw-bold py-3 text-center"><%= link_to t('admin_area.spaces.manager'), admin_spaces_path %></h2>
  <br>

  <h2><%= t('admin_area.spaces.index.select') %> </h2>
  <div class="list-group">
    <% Space.all.each do |space| %>
      <%= button_to t('admin_area.spaces.index.edit', space: space.name), edit_admin_space_path(id: space.id), method: :get, class: 'list-group-item list-group-item-action' %>
    <% end %>
  </div>
  <br>
  <h3><%= t('admin_area.spaces.index.create_heading') %> </h3>
  <%= form_for admin_spaces_path, url: { action: 'create', controller: 'admin/spaces' } do |f| %>
    <div class="mb-3">
      <%= label_tag :space_params_name, t('admin_area.spaces.index.space_name'), class: 'visually-hidden' %>
      <%= text_field_tag 'space_params[name]', nil, placeholder: t('admin_area.spaces.unique_name'), class: 'form-control' %>
    </div>
    <%= submit_tag t('admin_area.spaces.index.create'), class: 'btn btn-primary' %>
  <% end %>
  <br></br>
</section>
