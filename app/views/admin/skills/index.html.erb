<section>
  <div class="text-center pb-4">
    <h2 class="py-3 fw-bold"><%= t('admin_area.skills.manager') %></h2>

    <%= form_with url: { controller: 'admin/skills', action: 'create' } do |f| %>
      <div class="container">
        <div class="row text-center">
          <div class="col-md-12 form-group input-group">
            <span class="input-group-text"><%= t('admin_area.skills.name') %></span>
            <%= f.text_field :name, placeholder: t('admin_area.skills.skill_type_placeholder'), class: 'form-control', required: true %>
            <%= f.submit t('admin_area.skills.create'), class: 'btn btn-secondary btn-xl' %>
          </div>
        </div>
      </div>
    <% end %>
    <br />
    <table class="table table-striped mb-5">
      <thead class="table-primary">
        <tr class="text-center">
          <th><%= t('admin_area.skills.skill_type') %></th>
          <th><%= t('admin_area.skills.action') %></th>
        </tr>
      </thead>

      <% @skills.each do |skill| %>
        <tr>
          <td><%= skill.name %></td>
          <td>
          <%= link_to t('admin_area.skills.edit'), edit_admin_skill_path(skill.id), class: 'btn btn-primary' %>
          </td>
        </tr>
      <% end %>
    </table>
  </div>
</section>
