<section>
  <div class="text-center pb-4">
    <h2 class="py-3 fw-bold"><%= t('admin_area.skills.new') %></h2>
    <div class="float-end">
      <%= link_to t('admin_area.skills.back'), admin_skills_path %>
    </div>
    <br />
    <%= form_for @new_skill, url: { controller: 'admin/skills', action: 'create' } do |f| %>
      <div class="container">
        <div class="row text-center">
          <div class="col-md-12 form-group">
            <%= t('admin_area.skills.name_label') %> <%= f.text_field :name, placeholder: t('admin_area.skills.skill_type_placeholder'), class: 'form-control', required: true %>
          </div>

          <div class="col-md-12 form-group my-1">
            <%= f.submit t('admin_area.skills.create'), class: 'btn btn-secondary btn-xl' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>