<div class="table-responsive">
  <table class="table m-0 sessions-table" data-datatable>
    <thead class="table-primary">
      <tr>
        <th><%= t('admin_pages.keys.key_number') %></th>
        <th><%= t('admin_pages.keys.key_type') %></th>
        <th><%= t('admin_pages.keys.keycode') %></th>
        <th><%= t('admin_pages.common.space') %></th>
        <th><%= t('admin_pages.common.user') %></th>
        <th><%= t('admin_pages.common.supervisor') %></th>
        <th><%= t('admin_pages.common.email') %></th>
        <% if show_status %>
          <th><%= t('admin_pages.common.status') %></th>
        <% end %>
        <th><%= t('admin_pages.keys.certifications') %></th>
        <th><%= t('admin_pages.common.actions') %></th>
      </tr>
    </thead>

    <tbody>
      <% keys.each do |key| %>
        <tr>
          <td><%= key.number %></td>
          <td><%= t(key.key_type, scope: 'admin_pages.keys.key_types') %></td>
          <td><%= key.get_keycode %></td>
          <td>
            <%= key.key_type_regular? ? key.space.name : t('admin_pages.common.not_applicable') %>
          </td>
          <td><%= staff_user_link(key.display_user, target: '_blank', rel: 'noopener') %></td>
          <td><%= staff_user_link(key.display_supervisor, target: '_blank', rel: 'noopener') %></td>
          <td><%= key.display_user&.email %></td>
          <% if show_status %>
            <td>
              <%= t(key.status, scope: 'admin_pages.keys.statuses') %>
              <% unless key.additional_info.blank? %>
                - <%= sanitize(key.additional_info.truncate(30)) %>
              <% end %>
            </td>
          <% end %>
          <td>
            <% certification = key.key_request && key.display_user.key_certification %>
            <% if certification %>
              <%= t('admin_pages.keys.staff_files_count', attached: certification.get_key_certs_attached, total: KeyCertification::NUMBER_OF_STAFF_FILES) %><br>
              <%= t('admin_pages.keys.supervisor_files_count', attached: certification.get_supervisor_certs_attached, total: KeyCertification::NUMBER_OF_SUPERVISOR_FILES) %>
            <% else %>
              <%= t('admin_pages.keys.staff_files_count', attached: 0, total: KeyCertification::NUMBER_OF_STAFF_FILES) %><br>
              <%= t('admin_pages.keys.supervisor_files_count', attached: 0, total: KeyCertification::NUMBER_OF_SUPERVISOR_FILES) %>
            <% end %>
            <% if key.display_user.present? %>
              <% if key.key_request.present? %>
                <% if key.key_request.status_approved? %>
                  <%= t('admin_pages.keys.form_done') %>
                <% else %>
                  <span class="fw-bold text-danger"><%= t('admin_pages.keys.form_missing') %></span>
                  <%= link_to t('admin_pages.keys.pending'), key_request_path(key.key_request) %>
                <% end %>
              <% else %>
                <%= t('admin_pages.keys.form_missing') %>
              <% end %>
            <% end %>
          </td>
          <td>
            <%= link_to t('admin_pages.common.show'), admin_key_path(key.id), class: 'w-100 py-1 mb-1 btn btn-secondary' %>
            <%= link_to t('admin_pages.common.edit'), edit_admin_key_path(key.id), class: 'w-100 py-1 mb-1 btn btn-primary' %>
            <%= link_to t('admin_pages.keys.revoke'), admin_key_revoke_path(key.id), class: 'w-100 py-1 mb-1 btn btn-warning' if key.status_held? %>
            <%= link_to t('admin_pages.keys.assign'), admin_key_assign_path(key.id), class: 'w-100 py-1 mb-1 btn btn-success' if key.status_inventory? %>
            <%= button_to t('admin_pages.common.delete'), admin_key_path(key.id), method: :delete, class: 'w-100 py-1 btn btn-danger', **confirmation_options(t('confirmations.keys.delete')) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
