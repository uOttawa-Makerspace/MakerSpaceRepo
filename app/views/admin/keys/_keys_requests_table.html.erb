<div class="table-responsive">
  <table class="<%= "table text-center m-0 #{table_name}" %>">
    <thead class="table-primary">
    <tr>
      <th><%= t('admin_pages.common.user') %><span onclick="sortTable('<%= table_name %>', 0)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.space') %><span onclick="sortTable('<%= table_name %>', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.supervisor') %><span onclick="sortTable('<%= table_name %>', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.email') %><span onclick="sortTable('<%= table_name %>', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.keys.student_number') %><span onclick="sortTable('<%= table_name %>', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.phone_number') %><span onclick="sortTable('<%= table_name %>', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.keys.emergency_contact') %><span onclick="sortTable('<%= table_name %>', 6)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.keys.certifications') %><span onclick="sortTable('<%= table_name %>', 7)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.actions') %></th>
    </tr>
    </thead>
    <tbody>
      <% key_requests.each do |key_request| %>
        <tr>
          <td><%= staff_user_link(key_request.display_user, target: '_blank', rel: 'noopener') %></td>
          <td><%= key_request.space.name %></td>
          <td><%= staff_user_link(key_request.display_supervisor, target: '_blank', rel: 'noopener') %></td>
          <td><%= key_request.display_user&.email %></td>
          <td><%= key_request.student_number %></td>
          <td><%= key_request.phone_number %></td>
          <td>
            <%= key_request.emergency_contact %>
            <%= key_request.emergency_contact_relation %>
            <%= key_request.emergency_contact_phone_number %>
          </td>
          <td>
            <% certification = key_request.display_user&.key_certification %>
            <% if certification %>
              <%= t('admin_pages.keys.staff_files_count', attached: certification.get_key_certs_attached, total: KeyCertification::NUMBER_OF_STAFF_FILES) %><br>
              <%= t('admin_pages.keys.supervisor_files_count', attached: certification.get_supervisor_certs_attached, total: KeyCertification::NUMBER_OF_SUPERVISOR_FILES) %>
            <% else %>
              <%= t('admin_pages.keys.staff_files_count', attached: 0, total: KeyCertification::NUMBER_OF_STAFF_FILES) %><br>
              <%= t('admin_pages.keys.supervisor_files_count', attached: 0, total: KeyCertification::NUMBER_OF_SUPERVISOR_FILES) %>
            <% end %>
          </td>
          <td>
            <%= link_to t('admin_pages.common.show'), key_request_path(key_request.id), class: 'w-100 py-1 mb-1 btn btn-secondary' %>
            <%= button_to t('admin_pages.keys.approve'), approve_key_request_admin_keys_path(id: key_request.id), class: 'w-100 py-1 mb-1 btn btn-success', method: :patch if key_request.status_waiting_for_approval? %>
            <% if key_request.status_waiting_for_approval? %>
              <%= render KeyRequestDenyFormComponent.new(key_request: key_request, input_class: 'form-control-sm mb-1', button_class: 'w-100 py-1 btn btn-danger') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>