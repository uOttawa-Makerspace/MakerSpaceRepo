<div class="table-responsive">
  <table class="<%= "table text-center m-0 #{table_name}" %>">
    <thead class="table-primary">
    <tr>
      <th>User<span onclick="sortTable('<%= table_name %>', 0)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Space<span onclick="sortTable('<%= table_name %>', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Supervisor<span onclick="sortTable('<%= table_name %>', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Email<span onclick="sortTable('<%= table_name %>', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Student/Employee #<span onclick="sortTable('<%= table_name %>', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Phone Number<span onclick="sortTable('<%= table_name %>', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Emergency Contact<span onclick="sortTable('<%= table_name %>', 6)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Certifications<span onclick="sortTable('<%= table_name %>', 7)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th>Actions</th>
    </tr>
    </thead>
    <tbody>
      <% key_requests.each do |key_request| %>
        <tr>
          <td><%= staff_user_link(key_request.display_user, target: '_blank', rel: 'noopener') %></td>
          <td><%= key_request.space.name %></td>
          <td><%= staff_user_link(key_request.display_supervisor, target: '_blank', rel: 'noopener') %></td>
          <td><%= key_request.display_user&.email %></td>
          <td><%= key_request.student_number %></td>
          <td><%= key_request.phone_number %></td>
          <td>
            <%= key_request.emergency_contact %>
            <%= key_request.emergency_contact_relation %>
            <%= key_request.emergency_contact_phone_number %>
          </td>
          <td>
            <% certification = key_request.display_user&.key_certification %>
            <% if certification %>
              <%= certification.get_key_certs_attached %>/<%= KeyCertification::NUMBER_OF_STAFF_FILES %> (staff)<br>
              <%= certification.get_supervisor_certs_attached %>/<%= KeyCertification::NUMBER_OF_SUPERVISOR_FILES %> (supervisor)
            <% else %>
              0/<%= KeyCertification::NUMBER_OF_STAFF_FILES %> (staff)<br>
              0/<%= KeyCertification::NUMBER_OF_SUPERVISOR_FILES %> (supervisor)
            <% end %>
          </td>
          <td>
            <%= link_to 'Show', key_request_path(key_request.id), class: 'w-100 py-1 mb-1 btn btn-secondary' %>
            <%= button_to 'Approve', approve_key_request_admin_keys_path(id: key_request.id), class: 'w-100 py-1 mb-1 btn btn-success', method: :patch if key_request.status_waiting_for_approval? %>
            <% if key_request.status_waiting_for_approval? %>
              <%= form_with url: deny_key_request_admin_keys_path(id: key_request.id), method: :patch, data: { confirm: 'Are you sure you want to deny this key request?' } do |f| %>
                <%= f.label :denial_reason, 'Reason for denying (optional)', for: "denial_reason_#{key_request.id}", class: 'visually-hidden' %>
                <%= f.text_field :denial_reason, id: "denial_reason_#{key_request.id}", maxlength: KeyRequest::MAX_DENIAL_REASON_LENGTH, placeholder: 'Reason (optional)', class: 'form-control form-control-sm mb-1' %>
                <%= f.submit 'Deny', class: 'w-100 py-1 btn btn-danger' %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>