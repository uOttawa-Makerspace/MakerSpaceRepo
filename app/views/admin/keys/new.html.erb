<% if @key.errors.any? %>
  <div id="error_explanation">
    <h2><%= t('admin_pages.keys.errors_heading', count: @key.errors.count) %></h2>

    <ul>
      <% @key.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<section>
  <h2 class="mb-3 fw-bold py-3 text-center"><%= t('admin_pages.keys.new_title') %></h2>

  <%= form_for @key, url: { controller: 'admin/keys', action: 'create' } do |f| %>
    <div class="row">
      <div class="col-xl-6 offset-xl-3 col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12">
        <div class="mb-3">
          <%= f.label :key_type, for: 'key-type-select', class: 'form-label' %>
          <%= f.select :key_type, options_for_select(Key.key_types.map { |k, _v| [t(k, scope: 'admin_pages.keys.key_types'), k] }), {}, { class: 'form-control form-select', id: 'key-type-select' } %>
        </div>
        <div class="mb-3">
          <%= f.label :number, t('admin_pages.keys.key_number_lower'), class: 'form-label' %>
          <%= f.text_field :number, class: 'form-control', required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :space_id, for: 'space-select', class: 'form-label' %>
          <%= f.select :space_id, @space_select, { prompt: t('admin_pages.keys.choose_space') }, { class: 'form-control', id: 'space-select', aria: { label: t('common.names.space') } } %>
        </div>
        <div class="mb-3" style="display: none;">
          <%= f.label :custom_keycode, for: 'custom-keycode', class: 'form-label' %>
          <%= f.text_field :custom_keycode, class: 'form-control', id: 'custom-keycode' %>
        </div>
        <div class="mb-3">
          <%= f.label :status, t('admin_pages.common.status'), for: 'status-select', class: 'form-label' %>
          <%= f.select :status, options_for_select(Key.statuses.except(:held).map { |k, _v| [t(k, scope: 'admin_pages.keys.statuses'), k] }), {}, { class: 'form-control form-select', id: 'status-select' } %>
        </div>
        <div class="mb-4">
          <%= f.label :supervisor_id, t('admin_pages.keys.supervisor_optional'), for: 'supervisor-select', class: 'form-label' %>
          <%= f.select :supervisor_id, User.where(role: 'admin').order(name: :asc).pluck(:name, :id), { prompt: t('admin_pages.keys.choose_supervisor') }, { class: 'form-control', id: 'supervisor-select', aria: { label: t('common.names.supervisor') } } %>
        </div>
        <div class="mb-5" id="notes-container">
          <%= f.trix_label :additional_info, t('admin_pages.keys.notes_optional'), class: 'form-label' %>
          <%= f.trix_editor :additional_info, class: 'form-control' %>
        </div>

        <div class="text-center">
          <%= f.submit t('admin_pages.keys.create'), class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  <% end %>
</section>