<section>
  <div class="mb-3 py-3 text-center">
  <h2 class="fw-bold"><%= t('admin_pages.keys.assign_title', number: @key.number) %></h2>
  <p class="fs-4"><%= @key.get_keycode %> - <%= t(@key.key_type, scope: 'admin_pages.keys.key_types') %></p>
  </div>

  <%= form_with model: @key, url: { controller: 'admin/keys', action: 'assign_key' } do |f| %>
    <div class="row">
      <div class="col-xl-6 offset-xl-3 col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12">
        <div class="mb-3">
          <%= f.label :supervisor_id, t('admin_pages.common.supervisor'), class: 'form-label' %>
          <%= f.select :supervisor_id, options_for_select(@admin_options, selected: @user.id), { prompt: t('admin_pages.keys.choose_supervisor') }, { class: 'form-control', id: 'supervisor-select', aria: { label: t('common.names.supervisor') } } %>
        </div>
        <div class="mb-3">
          <%= f.label :user_id, t('admin_pages.common.user'), class: 'form-label' %>
          <%= f.select :user_id, options_for_select(@staff_options), { prompt: t('admin_pages.keys.choose_user') }, { class: 'form-control', id: 'key-request-select', aria: { label: t('common.names.user') } } %>
        </div>
        <div class="mb-5">
          <%= label_tag :deposit_amount, t('admin_pages.keys.deposit_amount'), class: 'form-label' %>
          <%= number_field_tag :deposit_amount, 0, { class: 'form-control', required: true, step: 0.01, min: 0, max: 999.99 } %>
        </div>

        <div class="text-center">
          <%= f.submit t('admin_pages.keys.assign_key'), class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  <% end %>
</section>
