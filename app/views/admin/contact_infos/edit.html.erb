<section>
  <h2 class="text-center py-3 fw-bold"><%= t('admin_pages.contact_infos.edit_title') %></h2>
  <div class="my-3">
    <div class="row">
      <div class="col-lg-12">
        <%= form_for @contact_info, url: { controller: 'contact_infos', action: 'update', local: true }, html: { class: 'needs-validation', novalidate: 'novalidate' } do |f| %>
          <div class="row">
            <div class="col-md-12">
              <div class="mb-3 text-center form-floating">
                <%= f.text_field :name, placeholder: t('admin_pages.contact_infos.name_placeholder'), class: 'form-control', required: true %>
                <%= f.label :name, t('admin_pages.contact_infos.name_label'), class: 'form-label' %>
              </div>

              <div class="mb-3 text-center">
                <%= f.label :space_id, t('admin_pages.contact_infos.associated_space'), id: 'contact_info_space_label', class: 'form-label' %>
                <%= f.select :space_id, options_from_collection_for_select(Space.all, :id, :name, selected: @contact_info.space_id.nil? ? nil : @contact_info.space_id), {}, { class: 'form-select form-control', required: true, aria: { labelledby: 'contact_info_space_label' } } %>
              </div>

              <div class="mb-3 text-center">
                <%= f.label :url, t('admin_pages.contact_infos.url_label'), class: 'form-label' %>
                <%= f.text_field :url, placeholder: t('admin_pages.contact_infos.url_placeholder'), class: 'form-control' %>
                <%= f.label :url, t('admin_pages.contact_infos.url_label'), class: 'form-label' %>
              </div>

              <div class="mb-3 text-center form-floating">
                <%= f.email_field :email, placeholder: t('admin_pages.contact_infos.email_placeholder'), class: 'form-control', required: true %>
                <%= f.label :email, t('admin_pages.common.email'), class: 'form-label' %>
              </div>

              <div class="mb-3 text-center form-floating">
                <%= f.text_field :address, placeholder: t('admin_pages.contact_infos.address_placeholder'), class: 'form-control' %>
                <%= f.label :address, t('admin_pages.common.address'), class: 'form-label' %>
              </div>

              <div class="mb-3 text-center form-floating">
                <%= f.text_field :phone_number, placeholder: t('admin_pages.contact_infos.phone_placeholder'), class: 'form-control' %>
                <%= f.label :phone_number, t('admin_pages.common.phone_number'), class: 'form-label' %>
              </div>

              <div class="mb-3">
                <%= f.label :show_hours, t('admin_pages.contact_infos.show_open_hours'), class: 'form-check-label' %>
                <%= f.check_box(:show_hours, class: 'form-check-input') %>
              </div>

              <div class="mb-3" id="openingHours">
                <div class="alert alert-warning my-3">
                  <%= t('admin_pages.contact_infos.hours_deprecated') %>
                </div>

                <%= render partial: 'opening_hour_form', locals: { f: } %>
                <%# Should not be submit if title is kept blank, used as a template for new hours%>
                <div id="newOpeningHourSubForm" hidden>
                  <%= render partial: 'opening_hour_form', locals: { f:, child_index: 'CHILDINDEX', models: [OpeningHour.new] } %>
                </div>
              </div>
              <a id="addNewOpeningHour" class="btn btn-outline-success"><%= t('admin_pages.contact_infos.new_opening_hour') %></a>
            </div>

            <div class="col-lg-12 text-center">
              <%= f.submit t('admin_pages.contact_infos.submit_edit'), class: 'btn btn-secondary btn-xl' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
