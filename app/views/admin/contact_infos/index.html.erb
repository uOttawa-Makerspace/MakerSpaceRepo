<section>
  <div class="text-center">

    <h2 class="py-3 fw-bold"><%= t('admin_pages.contact_infos.index_title') %></h2>

    <%= link_to t('admin_pages.contact_infos.new'), new_admin_contact_info_path, class: 'btn btn-primary m-3' %>

    <% if !@contact_infos.blank? %>

      <div class="table-responsive">
        <table class="table sessions-table table-striped">
        <thead class="table-primary">
          <tr>
            <th><%= t('admin_pages.common.name') %></th>
            <th><%= t('admin_pages.common.email') %></th>
            <th><%= t('admin_pages.common.address') %></th>
            <th><%= t('admin_pages.common.phone_number') %></th>
            <th><%= t('admin_pages.contact_infos.show_hours') %></th>
            <th class="action-header"><%= t('admin_pages.common.action') %></th>
          </tr>
        </thead>
          <tbody>
          <% @contact_infos.each do |a| %>
            <tr>
              <td>
                <%= a.name %>
              </td>

              <td>
                <%= a.email %>
              </td>

              <td>
                <%= a.address %>
              </td>

              <td>
                <%= a.phone_number %>
              </td>

              <td>
                <%= a.show_hours ? t('admin_pages.common.yes') : t('admin_pages.common.no') %>
              </td>

              <td class="action-cell">
                <%= link_to t('admin_pages.common.edit'), edit_admin_contact_info_path(a.id), class: 'btn btn-primary d-block w-100 btn-sm mt-0' %>
                <%= button_to t('admin_pages.common.delete'), { controller: :contact_infos, action: :destroy, id: a.id }, method: :delete,
                                                                                                    **confirmation_options(t('confirmations.contact_infos.delete')),
                                                                                                    class: 'btn btn-danger btn-sm d-block w-100 me-0 my-2' %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="m-3">
        <%= t('admin_pages.contact_infos.empty') %>
      </div>
    <% end %>
  </div>
</section>
