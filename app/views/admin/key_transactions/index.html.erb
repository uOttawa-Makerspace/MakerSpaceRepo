<% provide(:title, t('admin_pages.key_transactions.title')) %>
<section>
  <h2 class="m-0 fw-bold py-4 text-center"><%= t('admin_pages.key_transactions.title') %></h2>

  <div class="d-flex flex-row gap-2 justify-content-center mb-4">
    <%= link_to t('admin_pages.keys.management'), admin_keys_path, class: 'btn btn-primary' %>
    <%= link_to t('admin_pages.keys.key_requests'), requests_admin_keys_path, class: 'btn btn-primary' %>
  </div>

  <div class="accordion" id="keysAccordion">
    <div class="accordion-item">
      <h2 class="accordion-header" id="returned">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
          <%= t('admin_pages.key_transactions.returned') %>
        </button>
      </h2>
      <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="returned" data-bs-parent="#keysAccordion">
        <div class="accordion-body">
          <%= render partial: 'admin/key_transactions/key_transaction_table', locals: { key_transactions: @key_transactions.returned, show_edit: false, table_name: 'key-request-returned' } %>
        </div>
      </div>
    </div>
    <div class="accordion-item">
      <h2 class="accordion-header" id="currently-held">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
          <%= t('admin_pages.key_transactions.currently_held') %>
        </button>
      </h2>
      <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="currently-held" data-bs-parent="#keysAccordion">
        <div class="accordion-body">
          <%= render partial: 'admin/key_transactions/key_transaction_table', locals: { key_transactions: @key_transactions.not_returned, show_edit: false, table_name: 'key-request-held' } %>
        </div>
      </div>
    </div>
    <div class="accordion-item">
      <h2 class="accordion-header" id="deposit-refund">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
          <%= t('admin_pages.key_transactions.awaiting_refund') %>
        </button>
      </h2>
      <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="deposit-refund" data-bs-parent="#keysAccordion">
        <div class="accordion-body">
          <%= render partial: 'admin/key_transactions/key_transaction_table', locals: { key_transactions: @key_transactions.awaiting_deposit_return, show_edit: true, table_name: 'key-request-refund' } %>
        </div>
      </div>
    </div>
    <div class="accordion-item">
      <h2 class="accordion-header" id="all">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
          <%= t('admin_pages.key_transactions.all') %>
        </button>
      </h2>
      <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="all" data-bs-parent="#keysAccordion">
        <div class="accordion-body">
          <%= render partial: 'admin/key_transactions/key_transaction_table', locals: { key_transactions: @key_transactions, show_edit: false, table_name: 'key-request-all' } %>
        </div>
      </div>
    </div>
  </div>
</section>