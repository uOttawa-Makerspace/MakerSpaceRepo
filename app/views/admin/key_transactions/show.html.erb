<section class="w-75 mx-auto">
  <h2 class="m-0 fw-bold py-4 text-center"><%= t('admin_pages.key_transactions.show_title', id: @key_transaction.id) %></h2>

  <div class="mb-5">
    <h4 class="mb-3"><%= t('admin_pages.key_transactions.information') %></h4>
    <h6><span class="fw-bold"><%= t('admin_pages.key_transactions.label_key') %></span> <%= link_to @key_transaction.key.get_keycode, admin_key_path(@key_transaction.key.id), target: '_blank', rel: 'noopener' unless @key_transaction.key.nil? %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.keys.label_user') %></span> <%= link_to @key_transaction.user.name, user_path(@key_transaction.user.username), target: '_blank', rel: 'noopener' unless @key_transaction.user.nil? %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.keys.label_supervisor') %></span> <%= link_to @key_transaction.key.supervisor.name, user_path(@key_transaction.key.supervisor.username), target: '_blank', rel: 'noopener' unless @key_transaction.key.supervisor.nil? %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.key_transactions.label_key_given_on') %></span> <%= @key_transaction.created_at.strftime('%Y-%m-%d') %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.key_transactions.label_deposit_amount') %></span> $<%= @key_transaction.deposit_amount %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.key_transactions.label_return_date') %></span> <%= @key_transaction.return_date.nil? ? t('admin_pages.common.not_returned') : @key_transaction.return_date %></h6>
    <h6><span class="fw-bold"><%= t('admin_pages.key_transactions.label_deposit_return_date') %></span> <%= @key_transaction.deposit_return_date.nil? ? t('admin_pages.common.not_returned') : @key_transaction.deposit_return_date %></h6>
  </div>
</section>