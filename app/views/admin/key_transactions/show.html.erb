<section class="container py-4">
  <div class="mb-5">
    <h4 class="mb-3">Key Transaction Information</h4>
    <h6>
      <span class="fw-bold">Key:</span>
      <%= link_to @key_transaction.key.get_keycode, admin_key_path(@key_transaction.key.id), target: '_blank', rel: 'noopener' unless @key_transaction.key.nil? %>
    </h6>
    <h6>
      <span class="fw-bold">Holder:</span>
      <% if @key_transaction.holder.is_a?(User) %>
        <%= link_to @key_transaction.holder.name, user_path(@key_transaction.holder.username), target: '_blank', rel: 'noopener' %>
      <% elsif @key_transaction.holder.is_a?(ExternalContact) %>
        <%= @key_transaction.holder.name %> <span class="badge bg-warning text-dark">External Contact</span> — <%= @key_transaction.holder.email %>
      <% else %>
        Unassigned
      <% end %>
    </h6>
    <h6>
      <span class="fw-bold">Supervisor:</span>
      <%= link_to @key_transaction.key.supervisor.name, user_path(@key_transaction.key.supervisor.username), target: '_blank', rel: 'noopener' unless @key_transaction.key&.supervisor.nil? %>
    </h6>
    <h6><span class="fw-bold">Key Given On:</span> <%= @key_transaction.created_at.strftime('%Y-%m-%d') %></h6>
    <h6><span class="fw-bold">Deposit Amount:</span> $<%= @key_transaction.deposit_amount %></h6>
    <h6><span class="fw-bold">Return Date:</span> <%= @key_transaction.return_date.presence || 'Not Returned' %></h6>
  </div>
</section>