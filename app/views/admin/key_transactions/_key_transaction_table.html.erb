<div class="table-responsive">
  <table class="<%= "table text-center m-0 #{table_name}" %>">
    <thead class="table-primary">
    <tr>
      <th><%= t('admin_pages.key_transactions.key') %><span onclick="sortTable('<%= table_name %>', 0)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.user') %><span onclick="sortTable('<%= table_name %>', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.supervisor') %><span onclick="sortTable('<%= table_name %>', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.key_transactions.key_given_on') %><span onclick="sortTable('<%= table_name %>', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.key_transactions.deposit_amount') %><span onclick="sortTable('<%= table_name %>', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.key_transactions.return_date') %><span onclick="sortTable('<%= table_name %>', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.key_transactions.deposit_return_date') %><span onclick="sortTable('<%= table_name %>', 6)"><i class="fa-solid fa-arrow-down"></i></span></th>
      <th><%= t('admin_pages.common.actions') %></th>
    </tr>
    </thead>

    <tbody>
    <% key_transactions.each do |kt| %>
      <tr>
        <td><%= link_to kt.key.get_keycode, admin_key_path(kt.key.id) if kt.key %></td>
        <td><%= link_to kt.user.name, user_path(kt.user.username) if kt.user %></td>
        <td><%= link_to kt.key.supervisor.name, user_path(kt.key.supervisor.username) if kt.key&.supervisor %></td>
        <td><%= kt.created_at.strftime('%Y-%m-%d') %></td>
        <td data-sort-as="<%= kt.deposit_amount %>">$<%= kt.deposit_amount %></td>
        <td><%= kt.return_date.nil? ? t('admin_pages.common.not_returned') : kt.return_date %></td>
        <td><%= kt.deposit_return_date.nil? ? t('admin_pages.common.not_returned') : kt.deposit_return_date %></td>
        <td>
          <%= link_to t('admin_pages.common.show'), admin_key_transaction_path(id: kt.id), class: 'w-100 py-1 btn btn-primary' %>
          <%= link_to t('admin_pages.key_transactions.return_deposit'), edit_admin_key_transaction_path(id: kt.id), class: 'w-100 py-1 btn btn-primary' if show_edit %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>