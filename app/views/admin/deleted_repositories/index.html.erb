<% provide(:title, 'Deleted Repositories') %>
<section>
  <div class="text-center pb-4">
    <h2 class="fw-bold py-3">Deleted Repositories</h2>

    <% if @repositories.empty? %>
      <p>No repository has been deleted.</p>
    <% else %>
      <table class="table table-striped mb-5">
        <thead class="table-primary">
          <tr class="text-center">
            <th>Title</th>
            <th>Owner</th>
            <th>Action</th>
          </tr>
        </thead>
        <% @repositories.each do |repository| %>
          <tr>
            <td><%= repository.title %></td>
            <td><%= repository.owner&.username || 'Deleted account' %></td>
            <td>
              <%= button_to 'Restore', admin_deleted_repository_restoration_path(repository),
                            class: 'btn btn-primary', data: { confirm: 'Restore this repository?' } %>
            </td>
          </tr>
        <% end %>
      </table>
      <% if @pagy.pages > 1 %>
        <nav class="d-flex justify-content-center"><%== @pagy.series_nav(:bootstrap) %></nav>
      <% end %>
    <% end %>
  </div>
</section>
