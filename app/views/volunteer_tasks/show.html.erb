<section class="page-contents">
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1"><%= @volunteer_task.title.capitalize %></h2>
        <span class="badge bg-primary me-2"><%= @volunteer_task.category.capitalize %></span>
        <span class="badge bg-secondary"><%= @volunteer_task.space.name.capitalize %></span>
      </div>
      <% if current_user.staff? %>
        <%= link_to edit_volunteer_task_path(@volunteer_task), class: 'btn btn-outline-primary' do %>
          <i class="fa fa-pencil me-1"></i> Edit / Assign Volunteers
        <% end %>
      <% end %>
    </div>

    <!-- Description & Media Card (Dark-Mode Adaptive) -->
    <div class="card task-details-card shadow-sm p-4 mb-4">
      <div class="d-flex align-items-center mb-3">
        <h5 class="fw-bold mb-0 me-3">Task Details</h5>
        <div class="d-inline-flex align-items-center px-2 py-1 bg-dark bg-opacity-25 rounded border border-secondary border-opacity-25">
          <%= vite_image_tag 'images/cc.png', alt: 'CC', class: 'ccs me-1', id: 'myCcBlack', style: 'width: 18px; height: 18px;' %>
          <strong class="me-2"><%= @volunteer_task.cc %> CC</strong>
          <span class="text-muted small">(<%= @volunteer_task.hours %> hours)</span>
        </div>
      </div>

      <p class="lead fs-6 mb-3" style="white-space: pre-line;"><%= @volunteer_task.description %></p>

      <% if @photos.present? && @photos.first.image.attached? %>
        <hr class="opacity-25 my-3">
        <div id="show-photo" class="mb-3">
          <%= image_tag @photos.first.image, alt: 'Volunteer Task Main image', class: 'img-fluid rounded border border-secondary border-opacity-25', data: { width: @photos.first.try(:width), height: @photos.first.try(:height) } %>
        </div>
        <div id="photo-slide" class="d-flex gap-2">
          <% @photos.each do |p| %>
            <%= image_tag p.image, alt: 'Volunteer Task Thumbnail', class: 'img-thumbnail rounded', style: 'width: 80px; height: 80px; object-fit: cover;', data: { width: p.width, height: p.height } %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Assignment Banner & Actions -->
    <% if @volunteer_task.volunteer_task_joins.active.pluck(:user_id).include?(current_user.id) %>
      <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
        <div>
          <i class="fa fa-check-circle me-2"></i><strong>You are assigned to this volunteer task.</strong>
        </div>
        <div>
          <% if @volunteer_task_request.blank? %>
            <%= link_to create_request_volunteer_task_requests_path(id: @volunteer_task.id),
                        class: 'btn btn-success btn-sm fw-bold',
                        data: { confirm: 'This will submit this task for completion review. Are you sure it is finished?' } do %>
              <i class="fa fa-send me-1"></i> Submit Task as Complete
            <% end %>
          <% else %>
            <span class="badge bg-warning text-dark"><i class="fa fa-clock-o me-1"></i> Completion Under Review</span>
          <% end %>
        </div>
      </div>
    <% elsif @volunteer_task.status == "completed" %>
      <div class="alert alert-secondary mb-4">
        <i class="fa fa-flag-checkered me-2"></i> This task has been marked as completed.
      </div>
    <% else %>
      <% unless current_user.staff? %>
        <div class="alert alert-info mb-4">
          <i class="fa fa-info-circle me-2"></i> Volunteers are assigned to tasks by space managers based on skills, certifications, and availability.
        </div>
      <% end %>
    <% end %>

    <!-- Meta Information Cards -->
    <div class="row g-4">
      <div class="col-md-6">
        <div class="card task-details-card shadow-sm p-3 h-100">
          <h6 class="fw-bold text-muted mb-3 text-uppercase">Team Assignment</h6>
          <div class="mb-3">
            <strong>Responsible Staff:</strong>
            <div class="mt-1">
              <% @volunteer_task.volunteer_task_joins.active.where('volunteer_task_joins.user_type = ? OR volunteer_task_joins.user_type = ?', 'Staff', 'Admin').find_each do |staff_join| %>
                <%= link_to staff_join.user.name.titleize, user_path(staff_join.user.username), class: 'badge bg-primary text-decoration-none me-1' %>
              <% end %>
            </div>
          </div>
          <div>
            <strong>Assigned Volunteers:</strong>
            <div class="mt-1">
              <% if @volunteer_task.volunteer_task_joins.active.where(user_type: 'Volunteer').exists? %>
                <% @volunteer_task.volunteer_task_joins.active.where(user_type: 'Volunteer').find_each do |volunteer_join| %>
                  <%= link_to volunteer_join.user.name.titleize, user_path(volunteer_join.user.username), class: 'badge bg-secondary text-decoration-none me-1' %>
                <% end %>
              <% else %>
                <span class="text-muted small">No volunteers assigned yet</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card task-details-card shadow-sm p-3 h-100">
          <h6 class="fw-bold text-muted mb-3 text-uppercase">Certifications & Requirements</h6>
          <% if @required_trainings.present? %>
            <ul class="mb-0 ps-3">
              <% @required_trainings.find_each do |rt| %>
                <li class="mb-1"><strong><%= rt.training.localized_name.capitalize %></strong></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0 small">No prerequisite certifications needed for this task.</p>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</section>

<%= render 'layouts/photoswipe' %>
