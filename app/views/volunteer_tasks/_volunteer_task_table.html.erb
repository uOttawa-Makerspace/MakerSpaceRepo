<div>
  <h3 class="fw-bold mb-3"><%= title %></h3>

  <div class="input-group w-50 mx-auto mb-4">
    <input type="text" id="query-<%= type %>" onkeyup="findSession('<%= type %>-table', id='query-<%= type %>')"
           placeholder="Find by: date, title, description, ..." class="form-control search-task-input mx-auto">
    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
  </div>

  <div class="table-responsive">
    <table class="table <%= type %>-table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th class="action-header text-center">Action</th>
          <th>CC/Hours <span onclick="sortTable('<%= type %>-table', 1)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Category <span onclick="sortTable('<%= type %>-table', 2)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Title <span onclick="sortTable('<%= type %>-table', 3)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Status <span onclick="sortTable('<%= type %>-table', 4)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Certifications Needed <span onclick="sortTable('<%= type %>-table', 5)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Space <span onclick="sortTable('<%= type %>-table', 6)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Responsible Staff <span onclick="sortTable('<%= type %>-table', 7)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Assigned Volunteers <span onclick="sortTable('<%= type %>-table', 8)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <th>Date Submitted <span onclick="sortTable('<%= type %>-table', 9)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <% if current_user.staff? %>
            <th>Created by <span onclick="sortTable('<%= type %>-table', 10)" role="button"><i class="fa-solid fa-arrow-down small text-muted"></i></span></th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% local_pagy = local_assigns[:pagy] || @pagy %>
        <%== local_pagy.series_nav(:bootstrap) if local_pagy && local_pagy.pages > 1 %>
        <% volunteer_tasks.each do |vt| %>
          <tr>
            <td class="action-cell text-center" style="min-width: 110px;">
              <%= link_to 'Show', volunteer_task_path(vt.id), class: 'btn btn-info btn-sm w-100 mb-1' %>
              <% if current_user.staff? %>
                <%= link_to 'Edit', edit_volunteer_task_path(vt.id), class: 'btn btn-outline-primary btn-sm w-100 mb-1' %>
                <%= button_to 'Delete', { controller: :volunteer_tasks, action: :destroy, id: vt.id }, method: :delete,
                              data: { confirm: 'Are you sure that you want to delete this volunteer task? If you delete it, it will also delete all the volunteer hours related to it.' },
                              class: 'btn btn-outline-danger btn-sm w-100' %>
              <% end %>
            </td>

            <td>
              <%= vite_image_tag 'images/cc.png', alt: 'CC', class: 'ccs me-1', id: 'myCcBlack', style: 'width: 16px; height: 16px;' %>
              <strong><%= vt.cc %></strong>
              <div class="small text-muted"><%= vt.hours %> hrs</div>
            </td>

            <td>
              <span class="badge bg-secondary"><%= vt.category.capitalize %></span>
            </td>

            <td class="fw-semibold">
              <%= vt.title %>
            </td>

            <td>
              <% if vt.status == "open" %>
                <span class="badge bg-success">Open</span>
              <% else %>
                <span class="badge bg-secondary"><%= vt.status.capitalize %></span>
              <% end %>
            </td>

            <td>
              <% if vt.require_trainings.present? %>
                <% vt.require_trainings.find_each do |rt| %>
                  <span class="badge bg-dark border border-secondary mb-1"><%= rt.training.localized_name.capitalize %></span><br/>
                <% end %>
              <% else %>
                <span class="text-muted small">None</span>
              <% end %>
            </td>

            <td>
              <%= vt.space.name.capitalize %>
            </td>

            <td class="username">
              <% vt.volunteer_task_joins.active.where('volunteer_task_joins.user_type = ? OR volunteer_task_joins.user_type = ?',
                                                      'Staff', 'Admin').find_each do |staff_joins| %>
                <%= link_to staff_joins.user.name.titleize, user_path(staff_joins.user.username), class: 'text-decoration-none' %>
                <br />
              <% end %>
            </td>

            <td class="username">
              <% if vt.volunteer_task_joins.active.where(user_type: 'Volunteer').exists? %>
                <% vt.volunteer_task_joins.active.where(user_type: 'Volunteer').find_each do |volunteer_joins| %>
                  <%= link_to volunteer_joins.user.name.titleize, user_path(volunteer_joins.user.username), class: 'text-decoration-none' %>
                  <br />
                <% end %>
              <% else %>
                <span class="text-muted small">Unassigned</span>
              <% end %>
            </td>

            <td class="small">
              <%= vt.created_at.strftime('%m/%d/%Y') %>
              <div class="text-muted"><%= vt.created_at.strftime('%I:%M %p').downcase %></div>
            </td>

            <% if current_user.staff? %>
              <td class="username small">
                <%= link_to vt.user.name.titleize, user_path(vt.user.username), class: 'text-decoration-none' %>
              </td>
            <% end %>

          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
