<%
  in_progress_tasks      = @your_volunteer_tasks.reject { |vt| vt.status == 'completed' }
  completed_pool_tasks   = @your_volunteer_tasks.select { |vt| vt.status == 'completed' }
  completed_requests     = @completed_task_requests || []
  total_completed_count  = completed_requests.size + completed_pool_tasks.size

  completed_hours_total  = completed_requests.sum { |r| r.volunteer_task&.hours || 0 } + completed_pool_tasks.sum(&:hours)
  completed_cc_total     = completed_requests.sum { |r| r.volunteer_task&.cc || 0 } + completed_pool_tasks.sum(&:cc)

  total_hours_value      = in_progress_tasks.sum(&:hours) + completed_hours_total
  total_cc_value         = in_progress_tasks.sum(&:cc) + completed_cc_total

  # Auto-activate Completed tab if user has no in-progress tasks but has completed tasks
  default_tab = in_progress_tasks.empty? && total_completed_count.positive? ? 'completed' : 'active'
%>

<div class="py-3 py-md-4">
  <!-- Top Navigation & Header -->
  <div class="row align-items-center justify-content-between mb-4 g-3">
    <div class="col-12 col-md-auto">
      <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item">
            <%= link_to volunteer_tasks_path, class: "text-decoration-none text-body-secondary" do %>
              <i class="fa-solid fa-hand-holding-heart me-1"></i>Volunteer Tasks
            <% end %>
          </li>
          <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">My Assigned Tasks</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-body-emphasis mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-list-check text-primary"></i>
        <span>My Assigned Tasks</span>
      </h1>
      <p class="text-body-secondary small mb-0 mt-1">Track your active assignments, review prerequisites, and submit completed tasks for verification.</p>
    </div>
    <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
      <%= link_to transcript_volunteers_path, class: "btn btn-outline-primary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center", target: "_blank", rel: "noopener" do %>
        <i class="fa-solid fa-file-lines"></i>
        <span>Print Transcript / Certificate</span>
      <% end %>
      <%= link_to my_stats_volunteers_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center" do %>
        <i class="fa-solid fa-chart-line"></i>
        <span>My Stats</span>
      <% end %>
      <%= link_to volunteer_tasks_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center shadow-sm" do %>
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Explore Available Tasks</span>
      <% end %>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row g-3 mb-4">
    <!-- Active Tasks -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">In Progress</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= in_progress_tasks.size %></h2>
          </div>
          <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-spinner"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Completed Tasks -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Completed</h6>
            <h2 class="fw-bold text-success mb-0"><%= total_completed_count %></h2>
          </div>
          <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Potential / Total Hours -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Total Hours</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= total_hours_value %></h2>
          </div>
          <div class="rounded-circle bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-regular fa-clock"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Potential / Total CCs -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Total CCs</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= total_cc_value %></h2>
          </div>
          <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-coins"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tasks Table Card with Segmented Tabs -->
  <div class="card border rounded-3 shadow-sm bg-body">
    <div class="card-header bg-body-tertiary border-bottom p-3 p-md-4">
      <ul class="nav nav-pills gap-2" id="myTasksTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-semibold d-inline-flex align-items-center gap-2 <%= 'active' if default_tab == 'active' %>"
                  id="active-tasks-tab"
                  data-bs-toggle="pill"
                  data-bs-target="#active-tasks-pane"
                  type="button"
                  role="tab"
                  aria-controls="active-tasks-pane"
                  aria-selected="<%= default_tab == 'active' %>">
            <i class="fa-solid fa-spinner text-primary"></i>
            <span>In Progress Tasks</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1">
              <%= in_progress_tasks.size %>
            </span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-semibold d-inline-flex align-items-center gap-2 <%= 'active' if default_tab == 'completed' %>"
                  id="completed-tasks-tab"
                  data-bs-toggle="pill"
                  data-bs-target="#completed-tasks-pane"
                  type="button"
                  role="tab"
                  aria-controls="completed-tasks-pane"
                  aria-selected="<%= default_tab == 'completed' %>">
            <i class="fa-solid fa-circle-check text-success"></i>
            <span>Completed Tasks</span>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1">
              <%= total_completed_count %>
            </span>
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="myTasksTabContent">
      <!-- 1. Active / In Progress Pane -->
      <div class="tab-pane fade <%= 'show active' if default_tab == 'active' %>" id="active-tasks-pane" role="tabpanel" aria-labelledby="active-tasks-tab" tabindex="0">
        <% if in_progress_tasks.present? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-body-secondary border-bottom">
                <tr class="text-body-secondary small text-uppercase">
                  <th class="ps-3 ps-md-4 py-3" scope="col">Task Details</th>
                  <th class="py-3" scope="col">Space</th>
                  <th class="py-3" scope="col">CC &amp; Hours</th>
                  <th class="py-3" scope="col">Prerequisites</th>
                  <th class="py-3" scope="col">Status</th>
                  <th class="py-3" scope="col">Assigned Date</th>
                  <th class="pe-3 pe-md-4 py-3 text-end" scope="col">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% in_progress_tasks.each do |vt| %>
                  <% req = vt.volunteer_task_requests.where(user_id: current_user.id).not_processed.last %>
                  <tr>
                    <!-- Title & Category -->
                    <td class="ps-3 ps-md-4 py-3">
                      <div class="d-flex flex-column gap-1">
                        <div>
                          <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle text-uppercase small">
                            <%= vt.category.to_s.capitalize %>
                          </span>
                        </div>
                        <%= link_to vt.title.to_s.capitalize, volunteer_task_path(vt.id), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" %>
                      </div>
                    </td>

                    <!-- Space Badge -->
                    <td class="py-3">
                      <% if vt.space&.name&.downcase&.include?("makerspace") %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                          <i class="fa-solid fa-cube"></i>
                          <span><%= vt.space.name.capitalize %></span>
                        </span>
                      <% else %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                          <i class="fa-solid fa-industry"></i>
                          <span><%= vt.space&.name&.capitalize || "General" %></span>
                        </span>
                      <% end %>
                    </td>

                    <!-- CC & Hours Badges -->
                    <td class="py-3">
                      <div class="d-inline-flex flex-column gap-1">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-solid fa-coins text-warning"></i>
                          <span><%= vt.cc %> CC</span>
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-regular fa-clock text-primary"></i>
                          <span><%= vt.hours %> hrs</span>
                        </span>
                      </div>
                    </td>

                    <!-- Prerequisites -->
                    <td class="py-3">
                      <% if vt.require_trainings.present? %>
                        <div class="d-flex flex-wrap gap-1">
                          <% vt.require_trainings.each do |rt| %>
                            <span class="badge bg-body-secondary text-body border border-secondary-subtle small d-inline-flex align-items-center gap-1">
                              <i class="fa-solid fa-award text-secondary"></i>
                              <span><%= rt.training&.localized_name&.capitalize %></span>
                            </span>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle small">
                          <i class="fa-solid fa-check me-1"></i>None
                        </span>
                      <% end %>
                    </td>

                    <!-- Status Badge -->
                    <td class="py-3">
                      <% if req.present? %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-solid fa-hourglass-half text-warning"></i>
                          <span>Under Review</span>
                        </span>
                      <% else %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-solid fa-circle-play text-success"></i>
                          <span>In Progress</span>
                        </span>
                      <% end %>
                    </td>

                    <!-- Assigned Date -->
                    <td class="py-3">
                      <div class="text-body-emphasis small fw-medium">
                        <i class="fa-regular fa-calendar text-secondary me-1"></i>
                        <%= vt.created_at.strftime('%b %d, %Y') %>
                      </div>
                      <div class="text-body-secondary small">
                        <%= vt.created_at.strftime('%I:%M %p') %>
                      </div>
                    </td>

                    <!-- Actions -->
                    <td class="pe-3 pe-md-4 py-3 text-end">
                      <div class="d-inline-flex flex-column flex-sm-row gap-1 justify-content-end">
                        <%= link_to volunteer_task_path(vt.id), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" do %>
                          <i class="fa-solid fa-eye"></i>
                          <span>Details</span>
                        <% end %>

                        <% if req.blank? %>
                          <%= link_to create_request_volunteer_task_requests_path(id: vt.id),
                                      class: "btn btn-sm btn-success fw-semibold d-inline-flex align-items-center justify-content-center gap-1 shadow-sm text-white",
                                      data: { turbo_confirm: "Submit this task as completed for staff review?", confirm: "Submit this task as completed for staff review?" } do %>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Submit Complete</span>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-folder-open"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Active Tasks In Progress</h5>
            <p class="text-body-secondary small mb-4">You do not currently have any uncompleted tasks in progress.</p>
            <%= link_to volunteer_tasks_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" do %>
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Explore Available Tasks</span>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- 2. Completed Tasks Pane -->
      <div class="tab-pane fade <%= 'show active' if default_tab == 'completed' %>" id="completed-tasks-pane" role="tabpanel" aria-labelledby="completed-tasks-tab" tabindex="0">
        <% if completed_requests.present? || completed_pool_tasks.present? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-body-secondary border-bottom">
                <tr class="text-body-secondary small text-uppercase">
                  <th class="ps-3 ps-md-4 py-3" scope="col">Completed Task</th>
                  <th class="py-3" scope="col">Space</th>
                  <th class="py-3" scope="col">Completion Date</th>
                  <th class="py-3" scope="col">Credits &amp; Hours</th>
                  <th class="py-3" scope="col">Status</th>
                  <th class="pe-3 pe-md-4 py-3 text-end" scope="col">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% completed_requests.each do |req| %>
                  <% vt = req.volunteer_task %>
                  <% next if vt.blank? %>
                  <tr>
                    <!-- Task Title & Category -->
                    <td class="ps-3 ps-md-4 py-3">
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                          <i class="fa-solid fa-check"></i>
                        </div>
                        <div>
                          <%= link_to vt.title.to_s.capitalize, volunteer_task_path(vt.id), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" %>
                          <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle small mt-1">
                            <%= vt.category.to_s.capitalize %>
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Space -->
                    <td class="py-3">
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                        <%= vt.space&.name || "Makerspace" %>
                      </span>
                    </td>

                    <!-- Completion Date -->
                    <td class="py-3">
                      <div class="text-body-emphasis small fw-medium">
                        <i class="fa-regular fa-calendar text-secondary me-1"></i>
                        <%= req.updated_at.strftime('%b %d, %Y') %>
                      </div>
                      <div class="text-body-secondary small">
                        <%= req.updated_at.strftime('%I:%M %p') %>
                      </div>
                    </td>

                    <!-- Rewards -->
                    <td class="py-3">
                      <div class="d-inline-flex flex-column gap-1">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-solid fa-coins text-warning"></i>
                          <span>+<%= vt.cc %> CC</span>
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                          <i class="fa-regular fa-clock text-primary"></i>
                          <span><%= vt.hours %> hrs</span>
                        </span>
                      </div>
                    </td>

                    <!-- Status -->
                    <td class="py-3">
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Approved &amp; Verified</span>
                      </span>
                    </td>

                    <!-- Actions -->
                    <td class="pe-3 pe-md-4 py-3 text-end">
                      <div class="d-inline-flex gap-1 justify-content-end">
                        <%= link_to volunteer_task_path(vt.id), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
                          <i class="fa-solid fa-eye"></i>
                          <span>Details</span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>

                <% completed_pool_tasks.each do |vt| %>
                  <tr>
                    <td class="ps-3 ps-md-4 py-3">
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                          <i class="fa-solid fa-check"></i>
                        </div>
                        <div>
                          <%= link_to vt.title.to_s.capitalize, volunteer_task_path(vt.id), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" %>
                          <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle small mt-1"><%= vt.category %></span>
                        </div>
                      </div>
                    </td>
                    <td class="py-3">
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle small"><%= vt.space&.name || "Makerspace" %></span>
                    </td>
                    <td class="py-3 small text-body-secondary">
                      <%= vt.updated_at.strftime('%b %d, %Y') %>
                    </td>
                    <td class="py-3">
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small">+<%= vt.cc %> CC</span>
                    </td>
                    <td class="py-3">
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">Completed</span>
                    </td>
                    <td class="pe-3 pe-md-4 py-3 text-end">
                      <%= link_to volunteer_task_path(vt.id), class: "btn btn-sm btn-outline-secondary" do %>
                        <span>Details</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
              <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <h5 class="fw-bold text-body-emphasis">No Completed Tasks Yet</h5>
            <p class="text-body-secondary small mb-3">When your completed task submissions are reviewed and approved, they will appear here.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
