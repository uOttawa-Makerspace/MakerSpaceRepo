<%
  total_tasks       = @your_volunteer_tasks.size
  completed_tasks   = @your_volunteer_tasks.count { |vt| vt.status == 'completed' }
  in_progress_tasks = total_tasks - completed_tasks
  total_cc_value    = @your_volunteer_tasks.sum(&:cc)
  total_hours_value = @your_volunteer_tasks.sum(&:hours)
%>

<div class="py-3 py-md-4">
  <!-- Top Navigation & Header -->
  <div class="row align-items-center justify-content-between mb-4 g-3">
    <div class="col-12 col-md-auto">
      <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item">
            <%= link_to volunteer_tasks_path, class: "text-decoration-none text-body-secondary" do %>
              <i class="fa-solid fa-hand-holding-heart me-1"></i>Volunteer Tasks
            <% end %>
          </li>
          <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">My Assigned Tasks</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-body-emphasis mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-list-check text-primary"></i>
        <span>My Assigned Tasks</span>
      </h1>
      <p class="text-body-secondary small mb-0 mt-1">Track your active assignments, review prerequisites, and submit completed tasks for verification.</p>
    </div>
    <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
      <%= link_to my_stats_volunteers_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center" do %>
        <i class="fa-solid fa-chart-line"></i>
        <span>My Stats</span>
      <% end %>
      <%= link_to volunteer_tasks_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-center shadow-sm" do %>
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Explore Available Tasks</span>
      <% end %>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row g-3 mb-4">
    <!-- Active Tasks -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">In Progress</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= in_progress_tasks %></h2>
          </div>
          <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-spinner"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Completed Tasks -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Completed</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= completed_tasks %></h2>
          </div>
          <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Potential / Total Hours -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Task Hours</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= total_hours_value %></h2>
          </div>
          <div class="rounded-circle bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-regular fa-clock"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Potential / Total CCs -->
    <div class="col-6 col-lg-3">
      <div class="card border rounded-3 shadow-sm bg-body h-100">
        <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between gap-2">
          <div>
            <h6 class="text-body-secondary text-uppercase fw-semibold small mb-1">Total CCs</h6>
            <h2 class="fw-bold text-body-emphasis mb-0"><%= total_cc_value %></h2>
          </div>
          <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center p-3 fs-4 flex-shrink-0">
            <i class="fa-solid fa-coins"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tasks Table Card -->
  <div class="card border rounded-3 shadow-sm bg-body">
    <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4 d-flex align-items-center justify-content-between">
      <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
        <i class="fa-solid fa-clipboard-list text-primary"></i>
        <span>Assigned Tasks List</span>
      </h5>
      <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle rounded-pill">
        <%= total_tasks %> <%= "task".pluralize(total_tasks) %>
      </span>
    </div>

    <% if @your_volunteer_tasks.present? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-body-secondary border-bottom">
            <tr class="text-body-secondary small text-uppercase">
              <th class="ps-3 ps-md-4 py-3" scope="col">Task Details</th>
              <th class="py-3" scope="col">Space</th>
              <th class="py-3" scope="col">CC & Hours</th>
              <th class="py-3" scope="col">Prerequisites</th>
              <th class="py-3" scope="col">Status</th>
              <th class="py-3" scope="col">Assigned Date</th>
              <th class="pe-3 pe-md-4 py-3 text-end" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @your_volunteer_tasks.each do |vt| %>
              <% req = vt.volunteer_task_requests.where(user_id: current_user.id).not_processed.last %>
              <tr>
                <!-- Title & Category -->
                <td class="ps-3 ps-md-4 py-3">
                  <div class="d-flex flex-column gap-1">
                    <div>
                      <span class="badge bg-body-secondary text-body-secondary border border-secondary-subtle text-uppercase small">
                        <%= vt.category.to_s.capitalize %>
                      </span>
                    </div>
                    <%= link_to vt.title.to_s.capitalize, volunteer_task_path(vt.id), class: "fw-bold text-body-emphasis text-decoration-none d-block lh-sm" %>
                  </div>
                </td>

                <!-- Space Badge -->
                <td class="py-3">
                  <% if vt.space&.name&.downcase&.include?("makerspace") %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                      <i class="fa-solid fa-cube"></i>
                      <span><%= vt.space.name.capitalize %></span>
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2 small">
                      <i class="fa-solid fa-industry"></i>
                      <span><%= vt.space&.name&.capitalize || "General" %></span>
                    </span>
                  <% end %>
                </td>

                <!-- CC & Hours Badges -->
                <td class="py-3">
                  <div class="d-inline-flex flex-column gap-1">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                      <i class="fa-solid fa-coins text-warning"></i>
                      <span><%= vt.cc %> CC</span>
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                      <i class="fa-regular fa-clock text-primary"></i>
                      <span><%= vt.hours %> hrs</span>
                    </span>
                  </div>
                </td>

                <!-- Prerequisites -->
                <td class="py-3">
                  <% if vt.require_trainings.present? %>
                    <div class="d-flex flex-wrap gap-1">
                      <% vt.require_trainings.each do |rt| %>
                        <span class="badge bg-body-secondary text-body border border-secondary-subtle small d-inline-flex align-items-center gap-1">
                          <i class="fa-solid fa-award text-secondary"></i>
                          <span><%= rt.training&.localized_name&.capitalize %></span>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                      <i class="fa-solid fa-check me-1"></i>None
                    </span>
                  <% end %>
                </td>

                <!-- Status Badge -->
                <td class="py-3">
                  <% if vt.status == "completed" %>
                    <span class="badge bg-secondary-subtle text-body-secondary border border-secondary-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                      <i class="fa-solid fa-circle-check text-secondary"></i>
                      <span>Completed</span>
                    </span>
                  <% elsif req.present? %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                      <i class="fa-solid fa-hourglass-half text-warning"></i>
                      <span>Under Review</span>
                    </span>
                  <% else %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                      <i class="fa-solid fa-circle-play text-success"></i>
                      <span>In Progress</span>
                    </span>
                  <% end %>
                </td>

                <!-- Assigned Date -->
                <td class="py-3">
                  <div class="text-body-emphasis small fw-medium">
                    <i class="fa-regular fa-calendar text-secondary me-1"></i>
                    <%= vt.created_at.strftime('%b %d, %Y') %>
                  </div>
                  <div class="text-body-secondary small">
                    <%= vt.created_at.strftime('%I:%M %p') %>
                  </div>
                </td>

                <!-- Actions -->
                <td class="pe-3 pe-md-4 py-3 text-end">
                  <div class="d-inline-flex flex-column flex-sm-row gap-1 justify-content-end">
                    <%= link_to volunteer_task_path(vt.id), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" do %>
                      <i class="fa-solid fa-eye"></i>
                      <span>Details</span>
                    <% end %>

                    <% if vt.status != "completed" && req.blank? %>
                      <%= link_to create_request_volunteer_task_requests_path(id: vt.id),
                                  class: "btn btn-sm btn-success fw-semibold d-inline-flex align-items-center justify-content-center gap-1 shadow-sm text-white",
                                  data: { turbo_confirm: "Submit this task as completed for staff review?", confirm: "Submit this task as completed for staff review?" } do %>
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Submit Complete</span>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3">
        <div class="rounded-circle bg-body-secondary text-body-secondary d-inline-flex align-items-center justify-content-center p-4 fs-1 mb-3">
          <i class="fa-solid fa-folder-open"></i>
        </div>
        <h5 class="fw-bold text-body-emphasis">No Assigned Tasks</h5>
        <p class="text-body-secondary small mb-4">You currently do not have any tasks assigned to you.</p>
        <%= link_to volunteer_tasks_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" do %>
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>Explore Available Tasks</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
