<div class="py-3 py-md-4">
  <!-- Top Navigation & Header -->
  <div class="row align-items-center justify-content-between mb-4 g-3">
    <div class="col-12 col-md-auto">
      <nav aria-label="<%= t('common.names.breadcrumb') %>" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item">
            <%= link_to volunteer_tasks_path, class: "text-decoration-none text-body-secondary" do %>
              <i class="fa-solid fa-hand-holding-heart me-1"></i><%= t('volunteer_area.shared.volunteer_tasks') %>
            <% end %>
          </li>
          <li class="breadcrumb-item active text-primary fw-medium" aria-current="page"><%= t('volunteer_area.tasks.form.new_breadcrumb') %></li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-body-emphasis mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-circle-plus text-primary"></i>
        <span><%= t('volunteer_area.tasks.form.new_title') %></span>
      </h1>
      <p class="text-body-secondary small mb-0 mt-1"><%= t('volunteer_area.tasks.form.new_subtitle') %></p>
    </div>
    <div class="col-12 col-md-auto">
      <%= link_to volunteer_tasks_path, class: "btn btn-outline-secondary w-100 w-md-auto d-inline-flex align-items-center justify-content-center gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span><%= t('volunteer_area.shared.back_to_tasks') %></span>
      <% end %>
    </div>
  </div>

  <%= form_for @new_volunteer_task, url: volunteer_tasks_path, html: { id: 'volunteerForm', class: 'needs-validation', multipart: true } do |f| %>
    <div class="row g-3 g-md-4">

      <!-- LEFT COLUMN: Primary Details & Media (Desktop: 8 cols, Mobile: 12 cols) -->
      <div class="col-12 col-lg-8">
        <div class="d-flex flex-column gap-3 gap-md-4">

          <!-- Section 1: Overview -->
          <div class="card border rounded-3 shadow-sm bg-body">
            <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4">
              <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
                <i class="fa-solid fa-clipboard-list text-primary"></i>
                <span><%= t('volunteer_area.shared.task_overview') %></span>
              </h5>
            </div>
            <div class="card-body p-3 p-md-4">
              <div class="row g-3">
                <!-- Task Title -->
                <div class="col-12">
                  <%= f.label :title, class: 'form-label fw-semibold text-body' do %>
                    <%= t('volunteer_area.tasks.form.title') %> <span class="text-danger">*</span>
                  <% end %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-heading"></i>
                    </span>
                    <%= f.text_field :title, placeholder: t('volunteer_area.tasks.form.title_placeholder'), class: 'form-control form-control-lg', required: true %>
                    <div class="invalid-feedback"><%= t('volunteer_area.tasks.form.title_missing') %></div>
                  </div>
                </div>

                <!-- Category -->
                <div class="col-12 col-sm-6">
                  <%= f.label :category, class: 'form-label fw-semibold text-body' do %>
                    <%= t('volunteer_area.tasks.form.category') %> <span class="text-danger">*</span>
                  <% end %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-tags"></i>
                    </span>
                    <%= f.select :category, options_for_select(task_category_options(@tasks_categories), @tasks_categories[2]), { prompt: t('volunteer_area.tasks.form.category_prompt') }, { class: 'form-select', required: true } %>
                  </div>
                </div>

                <!-- Space -->
                <div class="col-12 col-sm-6">
                  <%= f.label :space_id, class: 'form-label fw-semibold text-body' do %>
                    <%= t('volunteer_area.shared.space_location') %> <span class="text-danger">*</span>
                  <% end %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-location-dot"></i>
                    </span>
                    <%= f.collection_select :space_id, @spaces, :id, ->(s) { s.name.capitalize }, { prompt: t('volunteer_area.tasks.form.space_prompt') }, { class: 'form-select', required: true } %>
                  </div>
                </div>

                <!-- Description -->
                <div class="col-12">
                  <%= f.label :description, class: 'form-label fw-semibold text-body' do %>
                    <%= t('volunteer_area.tasks.form.description') %> <span class="text-danger">*</span>
                  <% end %>
                  <%= f.text_area :description, rows: 5, placeholder: t('volunteer_area.tasks.form.description_placeholder_new'), class: 'form-control', required: true %>
                  <div class="invalid-feedback"><%= t('volunteer_area.tasks.form.description_missing') %></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: Certifications & Photos -->
          <div class="card border rounded-3 shadow-sm bg-body">
            <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4">
              <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
                <i class="fa-solid fa-paperclip text-primary"></i>
                <span><%= t('volunteer_area.tasks.form.requirements_attachments') %></span>
              </h5>
            </div>
            <div class="card-body p-3 p-md-4">
              <div class="row g-3">
                <!-- Certifications -->
                <div class="col-12">
                  <%= label_tag :task_certifications, class: 'form-label fw-semibold text-body d-flex align-items-center gap-2' do %>
                    <i class="fa-solid fa-award text-warning"></i>
                    <span><%= t('volunteer_area.tasks.form.required_certifications') %></span>
                  <% end %>
                  <p class="text-body-secondary small mb-2"><%= t('volunteer_area.tasks.form.certifications_hint_new_html') %></p>
                  <%= select_tag :certifications_id, options_from_collection_for_select(@certifications, 'id', 'localized_name'), multiple: true, id: 'task_certifications', class: 'form-select', size: 4 %>
                </div>

                <!-- Photos -->
                <div class="col-12">
                  <%= label_tag :task_images, class: 'form-label fw-semibold text-body d-flex align-items-center gap-2' do %>
                    <i class="fa-solid fa-images text-info"></i>
                    <span><%= t('volunteer_area.tasks.form.reference_images') %></span>
                  <% end %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-upload"></i>
                    </span>
                    <%= file_field_tag 'images[]', multiple: true, accept: 'image/png,image/jpeg,image/gif,image/svg+xml,image/x-icon', class: 'form-control', id: 'task_images' %>
                  </div>
                  <div class="form-text text-body-secondary mt-1">
                    <%= t('volunteer_area.tasks.form.images_hint_new') %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: Metrics, Status, Assignments & Actions (Desktop: 4 cols, Mobile: 12 cols) -->
      <div class="col-12 col-lg-4">
        <div class="d-flex flex-column gap-3 gap-md-4">

          <!-- Section 3: Task Settings & Parameters -->
          <div class="card border rounded-3 shadow-sm bg-body">
            <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4">
              <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders text-primary"></i>
                <span><%= t('volunteer_area.tasks.form.settings') %></span>
              </h5>
            </div>
            <div class="card-body p-3 p-md-4">
              <div class="row g-3">
                <!-- Status Switcher -->
                <div class="col-12">
                  <label class="form-label fw-semibold text-body mb-2"><%= t('volunteer_area.tasks.form.initial_status') %></label>
                  <div class="btn-group w-100" role="group" aria-label="<%= t('common.names.task_status') %>">
                    <%= f.radio_button :status, 'open', class: 'btn-check', id: 'status_open', checked: true %>
                    <label class="btn btn-outline-success d-flex align-items-center justify-content-center gap-2 py-2" for="status_open">
                      <i class="fa-solid fa-lock-open"></i> <%= t('volunteer_area.tasks.form.open') %>
                    </label>

                    <%= f.radio_button :status, 'completed', class: 'btn-check', id: 'status_completed' %>
                    <label class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" for="status_completed">
                      <i class="fa-solid fa-check"></i> <%= t('volunteer_area.shared.completed') %>
                    </label>
                  </div>
                </div>

                <div class="col-12"><hr class="my-1 border-secondary-subtle"></div>

                <!-- Joins Capacity -->
                <div class="col-12">
                  <%= f.label :joins, t('volunteer_area.tasks.form.capacity'), class: 'form-label fw-semibold text-body' %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-users"></i>
                    </span>
                    <%= f.number_field :joins, min: 1, value: 1, class: 'form-control', required: true %>
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle"><%= t('volunteer_area.tasks.form.people') %></span>
                  </div>
                </div>

                <!-- Hours -->
                <div class="col-12 col-sm-6 col-lg-12">
                  <%= f.label :hours, t('volunteer_area.tasks.form.hours'), class: 'form-label fw-semibold text-body' %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-regular fa-clock"></i>
                    </span>
                    <%= f.number_field :hours, step: '0.01', min: '0', placeholder: '0.00', class: 'form-control' %>
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle"><%= t('volunteer_area.tasks.form.hrs') %></span>
                  </div>
                </div>

                <!-- CCs -->
                <div class="col-12 col-sm-6 col-lg-12">
                  <%= f.label :cc, t('volunteer_area.tasks.form.cc'), class: 'form-label fw-semibold text-body' %>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle">
                      <i class="fa-solid fa-coins"></i>
                    </span>
                    <%= f.number_field :cc, min: '0', placeholder: '0', class: 'form-control' %>
                    <span class="input-group-text bg-body-secondary text-body-secondary border-secondary-subtle"><%= t('volunteer_area.tasks.form.ccs') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 4: Assignments -->
          <div class="card border rounded-3 shadow-sm bg-body">
            <div class="card-header bg-body-tertiary border-bottom py-3 px-3 px-md-4">
              <h5 class="card-title fw-bold mb-0 text-body-emphasis d-flex align-items-center gap-2">
                <i class="fa-solid fa-user-group text-primary"></i>
                <span><%= t('volunteer_area.tasks.form.initial_team') %></span>
              </h5>
            </div>
            <div class="card-body p-3 p-md-4">
              <div class="row g-3">
                <!-- Staff Responsible -->
                <div class="col-12">
                  <%= label_tag :staff_id, class: 'form-label fw-semibold text-body d-flex align-items-center gap-2' do %>
                    <i class="fa-solid fa-user-tie text-body-secondary"></i>
                    <span><%= t('volunteer_area.tasks.form.staff_lead') %></span>
                  <% end %>
                  <%= select_tag :staff_id, options_from_collection_for_select(User.all.staff, 'id', 'name'), prompt: t('volunteer_area.tasks.form.staff_lead_prompt'), class: 'form-select' %>
                  <div class="form-text text-body-secondary small"><%= t('volunteer_area.tasks.form.staff_lead_hint') %></div>
                </div>

                <!-- Volunteer Assignee -->
                <div class="col-12">
                  <%= label_tag :volunteer_id, class: 'form-label fw-semibold text-body d-flex align-items-center gap-2' do %>
                    <i class="fa-solid fa-hand-holding-heart text-body-secondary"></i>
                    <span><%= t('volunteer_area.tasks.form.assign_volunteer') %></span>
                  <% end %>
                  <%= select_tag :volunteer_id, options_from_collection_for_select(User.all.volunteers, 'id', 'name'), prompt: t('volunteer_area.tasks.form.assign_volunteer_prompt'), class: 'form-select' %>
                  <div class="form-text text-body-secondary small"><%= t('volunteer_area.tasks.form.assign_volunteer_hint') %></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 5: Action Card -->
          <div class="card border rounded-3 shadow-sm bg-body-tertiary">
            <div class="card-body p-3 p-md-4">
              <div class="d-grid gap-2">
                <%= f.button type: :submit, class: 'btn btn-primary btn-lg fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm' do %>
                  <i class="fa-solid fa-circle-check"></i>
                  <span><%= t('volunteer_area.shared.create_task') %></span>
                <% end %>
                <%= link_to volunteer_tasks_path, class: 'btn btn-outline-secondary d-flex align-items-center justify-content-center' do %>
                  <%= t('volunteer_area.shared.cancel') %>
                <% end %>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  <% end %>
</div>
