<% active_membership = user.memberships.active.order(end_date: :desc).first %>
<% if active_membership %>
    <%= link_to memberships_path, class: "d-flex align-items-center gap-2 my-3 text-black fw-normal btn btn-light rounded-pill glow", style: "width: fit-content;" do %>
        <% if active_membership.membership_tier.title_en.downcase.include?('faculty') %>
            <i class="fa-solid fa-building-columns text-primary fs-5"></i>
            Engineering membership!
        <% else %>
            <i class="fa-solid fa-circle-check text-primary fs-5"></i>
            Membership expires <%= l(active_membership.end_date.to_date, format: :long) %>
        <% end %>
    <% end %>
<% else %>
    <%= link_to memberships_path, class: "d-flex align-items-center gap-2 my-3 text-black fw-normal btn btn-light rounded-pill", style: "width: fit-content;" do %>
        <i class="fa-solid fa-circle-xmark text-muted fs-5"></i>
        No active membership
    <% end %>
<% end %>
