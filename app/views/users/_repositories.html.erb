<% if params[:show] == 'repositories' && @repositories.empty? %>
    <%= tag.div(t('.none_repositories', username: @repo_user.username), class: 'empty-repo') %>
<% elsif params[:show] == 'makes' && @makes.empty? %>
    <%= tag.div(t('.none_makes', username: @repo_user.username), class: 'empty-repo') %>
<% elsif params[:show] == 'projects_assigned' && @joined_projects.empty? %>
    <%= tag.div(t('.none_joined_projects', username: @repo_user.username), class: 'empty-repo') %>
<% else %>
    <div class="apple_pagination text-center mb-3">
        <% if @pagy && @pagy.count > 0 %>
            <small class="text-muted d-block mb-2">
                <%= t('.displaying_html', from: @pagy.from, to: @pagy.to, total: @pagy.count) %>
            </small>
        <% end %>
        <%== @pagy.series_nav(:bootstrap) if @pagy && @pagy.pages > 1 %>
    </div>
<% end %>
<%# The joined projects tab lists the joined proposals. The other tabs show their cards in a row, left out when neither their list nor the joined projects have anything. %>
<% repos = params[:show] == 'makes' ? @makes : @repositories %>
<% if params[:show] == 'projects_assigned' %>
    <% @joined_projects.each do |joined_project| %>
        <% project_proposal = joined_project.project_proposal %>
        <div class="repository-container">
            <div class="repo-display-wrapper" <%= "style=background-image:url('#{url_for(project_proposal.photos.first) if project_proposal.photos.attached?}')" %> >
                <%= link_to '', project_proposal_path(project_proposal), class: 'link' %>
            </div>
            <div class="repo-info">
                <div class="start">
                    <div class="title">
                        <%= link_to project_proposal.title, project_proposal_path(project_proposal) %>
                    </div>
                    <div>
                        <% if project_proposal.has_user %>
                            <%= t('common.by') %> <%= link_to project_proposal.user.username, user_path(project_proposal.user.username) %>
                        <% else %>
                            <%= t('.by_deleted_user') %>
                        <% end %>
                    </div>
                    <div>
                        <%= t('common.time_ago', time: time_ago_in_words(project_proposal.created_at)) %>
                    </div>
                </div>
            </div>
        </div>
    <% end %>
<% elsif repos.present? || @joined_projects.exists? %>
    <div class="row">
        <% repos.each do |repository| %>
            <div class="col-md-4 col-lg-4 g-2">
                <%= render 'repositories/repository_card', repository: repository %>
            </div>
        <% end %>
    </div>
<% end %>
