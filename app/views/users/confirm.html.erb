<% provide(:title, t('email_links.confirm.title')) %>

<div class="container py-5" style="max-width: 36rem;">
  <h2 class="mb-3"><%= t('email_links.confirm.heading') %></h2>
  <p><%= t('email_links.confirm.body') %></p>
  <p class="text-muted small"><%= t('email_links.nothing_changes') %></p>

  <div class="d-flex gap-2">
    <%= button_to t('email_links.confirm.button'), confirm_users_path,
                  params: { token: params[:token] }, method: :post, class: 'btn btn-primary' %>
    <%= link_to t('email_links.cancel'), root_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>
