<div class="col-md-6">
  <p><%= t('volunteer_area.joins.remove_staff_label') %></p>
  <%= form_for @new_volunteer_join, url: { controller: 'volunteer_task_joins', action: 'remove' } do |f| %>
    <%= f.hidden_field :volunteer_task_id, value: @volunteer_task.id %>
    <%= f.select :user_id, @staff_in_task, { prompt: t('volunteer_area.joins.choose_staff') }, { class: 'form-control form-select', 'data-live-search': 'true' } %>
    <br />
    <br />
    <%= f.submit t('volunteer_area.joins.remove_staff'), class: 'btn btn-danger mb-5',
                                 **confirmation_options(t('confirmations.volunteer_tasks.remove_user')) %>
  <% end %>
</div>

<div class="col-md-6">
  <p><%= t('volunteer_area.joins.remove_volunteer_label') %></p>
  <%= form_for @new_volunteer_join, url: { controller: 'volunteer_task_joins', action: 'remove' } do |f| %>
    <%= f.hidden_field :volunteer_task_id, value: @volunteer_task.id %>
    <%= f.select :user_id, @volunteers_in_task, { prompt: t('volunteer_area.joins.choose_volunteer') }, { class: 'form-control form-select', 'data-live-search': 'true' } %>
    <br />
    <br />
    <%= f.submit t('volunteer_area.joins.remove_volunteer'), class: 'btn btn-danger mb-5',
                                     **confirmation_options(t('confirmations.volunteer_tasks.remove_user')) %>
  <% end %>
</div>