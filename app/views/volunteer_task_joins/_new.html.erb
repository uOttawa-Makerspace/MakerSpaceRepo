<div class="col-md-6">
  <p><%= t('volunteer_area.joins.add_staff_label') %></p>
  <%= form_for @new_volunteer_join, url: { controller: 'volunteer_task_joins', action: 'create' } do |f| %>
    <%= f.hidden_field :volunteer_task_id, value: @volunteer_task.id %>
    <%= f.select :user_id, @staff, { prompt: t('volunteer_area.joins.choose_staff') }, { class: 'form-control form-select', 'data-live-search': 'true' } %>
    <br />
    <br />
    <%= f.submit t('volunteer_area.joins.add_staff'), class: 'btn btn-primary mb-5' %>
  <% end %>
</div>

<div class="col-md-6">
  <p><%= t('volunteer_area.joins.add_volunteer_label') %></p>
  <%= form_for @new_volunteer_join, url: { controller: 'volunteer_task_joins', action: 'create' } do |f| %>
    <%= f.hidden_field :volunteer_task_id, value: @volunteer_task.id %>
    <%= f.select :user_id, @volunteers, { prompt: t('volunteer_area.joins.choose_volunteer') }, { class: 'form-control form-select', 'data-live-search': 'true' } %>
    <br />
    <br />
    <%= f.submit t('volunteer_area.joins.add_volunteer'), class: 'btn btn-primary mb-5' %>
  <% end %>
</div>