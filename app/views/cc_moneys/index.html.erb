<% store_link = link_to('MakerStore', 'http://makerstore.ca/', target: :blank) %>
<div class="container py-5">

  <!-- Hero -->
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">
      <i class="fa fa-money text-warning"></i> <%= t('rewards.index.title') %>
    </h1>
    <p class="lead text-muted">
      <%= t('rewards.index.subtitle') %>
    </p>
  </div>

  <% if current_user %>
    <!-- Wallet -->
    <div class="row justify-content-center mb-5">
      <div class="col-md-6">
        <div class="card border-0 shadow text-center">
          <div class="card-body py-4">
            <h5 class="text-muted mb-1"><%= t('rewards.index.wallet.title') %></h5>
            <h2 class="display-5 fw-bold text-primary">
              <%= @user_wallet %>
            </h2>
            <%= link_to t('rewards.index.wallet.redeem_button'), new_discount_code_path, class: 'btn btn-primary mt-2' %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- What Are CC Points -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h2 class="card-title mb-3">
            <i class="fa fa-question-circle text-primary me-2"></i>
            <%= t('rewards.index.what.title') %>
          </h2>
          <p class="card-text fs-5">
            <%= t('rewards.index.what.body_html', store_link: store_link) %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- How to Earn -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <h2 class="text-center mb-4">
        <i class="fa fa-line-chart text-success me-2"></i>
        <%= t('rewards.index.earn.title') %>
      </h2>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-graduation-cap fa-3x text-primary mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.training.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.training.body') %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-calendar-check-o fa-3x text-success mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.events.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.events.body') %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-users fa-3x text-warning mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.volunteer.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.volunteer.body') %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-qrcode fa-3x text-info mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.qr_codes.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.qr_codes.body') %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-lightbulb-o fa-3x text-danger mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.projects.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.projects.body') %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <i class="fa fa-trophy fa-3x text-secondary mb-3"></i>
              <h5 class="card-title"><%= t('rewards.index.earn.achievements.title') %></h5>
              <p class="card-text text-muted">
                <%= t('rewards.index.earn.achievements.body') %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- How to Redeem -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <h2 class="text-center mb-4">
        <i class="fa fa-gift text-danger me-2"></i>
        <%= t('rewards.index.redeem.title') %>
      </h2>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="row text-center">
            <div class="col-md-3 mb-3">
              <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                <span class="fw-bold fs-5">1</span>
              </div>
              <h6><%= t('rewards.index.redeem.step1.title') %></h6>
              <p class="text-muted small"><%= t('rewards.index.redeem.step1.body') %></p>
            </div>
            <div class="col-md-3 mb-3">
              <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                <span class="fw-bold fs-5">2</span>
              </div>
              <h6><%= t('rewards.index.redeem.step2.title') %></h6>
              <p class="text-muted small"><%= t('rewards.index.redeem.step2.body_html', redemption_link: link_to(t('rewards.index.redeem.step2.link_text'), new_discount_code_path)) %></p>
            </div>
            <div class="col-md-3 mb-3">
              <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                <span class="fw-bold fs-5">3</span>
              </div>
              <h6><%= t('rewards.index.redeem.step3.title') %></h6>
              <p class="text-muted small"><%= t('rewards.index.redeem.step3.body') %></p>
            </div>
            <div class="col-md-3 mb-3">
              <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                <span class="fw-bold fs-5">4</span>
              </div>
              <h6><%= t('rewards.index.redeem.step4.title') %></h6>
              <p class="text-muted small"><%= t('rewards.index.redeem.step4.body_html', store_link: store_link) %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if current_user && @cc_activities.present? %>
    <!-- Recent Activity -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-10">
        <h2 class="text-center mb-4">
          <i class="fa fa-history text-secondary me-2"></i>
          <%= t('rewards.index.activity.title') %>
        </h2>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead class="table-primary">
              <tr class="text-center">
                <th><%= t('rewards.index.activity.date') %></th>
                <th><%= t('rewards.index.activity.points') %></th>
              </tr>
            </thead>
            <tbody>
              <% @cc_activities.each do |cc| %>
                <tr class="text-center">
                  <td><%= cc.created_at.strftime('%Y/%m/%d') %></td>
                  <td>
                    <span class="badge bg-<%= cc.cc.to_i >= 0 ? 'success' : 'danger' %>">
                      <%= cc.cc.to_i >= 0 ? '+' : '' %><%= cc.cc %> CC
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- FAQ -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <h2 class="text-center mb-4">
        <i class="fa fa-question-circle text-info me-2"></i>
        <%= t('rewards.index.faq.title') %>
      </h2>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-2"><%= t('rewards.index.faq.expire.question') %></h5>
          <p class="mb-0 text-muted">
            <%= t('rewards.index.faq.expire.answer') %>
          </p>
        </div>
      </div>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-2"><%= t('rewards.index.faq.transfer.question') %></h5>
          <p class="mb-0 text-muted">
            <%= t('rewards.index.faq.transfer.answer') %>
          </p>
        </div>
      </div>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-2"><%= t('rewards.index.faq.discount.question') %></h5>
          <p class="mb-0 text-muted">
            <%= t('rewards.index.faq.discount.answer_html',
                  store_link: store_link,
                  codes_link: link_to(t('rewards.index.faq.discount.codes_link_text'), discount_codes_path)) %>
          </p>
        </div>
      </div>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-2"><%= t('rewards.index.faq.contact.question') %></h5>
          <p class="mb-0 text-muted">
            <%= t('rewards.index.faq.contact.answer_html', email_link: mail_to('uottawa.makerepo@gmail.com')) %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <% unless current_user %>
    <!-- Sign-in CTA -->
    <div class="text-center mb-5">
      <div class="card border-0 shadow bg-primary text-white">
        <div class="card-body py-5">
          <h3 class="fw-bold mb-3"><%= t('rewards.index.sign_in_cta.title') %></h3>
          <p class="fs-5 mb-4"><%= t('rewards.index.sign_in_cta.body') %></p>
          <%= link_to t('rewards.index.sign_in_cta.button'), new_user_session_path, class: 'btn btn-light btn-lg fw-bold' %>
        </div>
      </div>
    </div>
  <% end %>

</div>
