<div class="container text-center">
  <h4>Link CC to an user</h4>
  <p>You can only link this CC points once. They will be added to your account (<%= current_user.email %>), which must be the account the purchase was made with.</p>
  <%= form_with(url: redeem_cc_moneys_path, method: :post) do |f| %>
    <%= hidden_field_tag :token, @cc_token %>
    <%= f.submit 'Send CC', class: 'btn btn-primary' %>
    <br />
    <br>
    <%= link_to 'Cancel', root_url %>
  <% end %>
</div>
