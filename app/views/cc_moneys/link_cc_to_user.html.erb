<div class="container text-center">
  <h4><%= t('rewards.link_cc_to_user.title') %></h4>
  <p><%= t('rewards.link_cc_to_user.body', email: current_user.email) %></p>
  <%= form_with(url: redeem_cc_moneys_path, method: :post) do |f| %>
    <%= hidden_field_tag :token, @cc_token %>
    <%= f.submit t('rewards.link_cc_to_user.submit'), class: 'btn btn-primary' %>
    <br />
    <br>
    <%= link_to t('rewards.link_cc_to_user.cancel'), root_url %>
  <% end %>
</div>
