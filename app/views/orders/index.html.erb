<% provide(:title, 'Orders') %>

<section class="p-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center mb-4">
        <h2><b>Your Orders</b></h2>
      </div>
    </div>
    <div class="text-center">
      <% if !@orders.present? %>
        <p class="text-center">
          You have no orders. Please check our <%= link_to 'projects', proficient_projects_path, class: 'text-info' %> and add some items to your cart.
        </p>
      <% else %>
        <div class="apple_pagination text-center mb-3">
          <% if @pagy.count > 0 %>
            <small class="text-muted d-block mb-2">
              Displaying orders <b><%= @pagy.from %></b> - <b><%= @pagy.to %></b> of <b><%= @pagy.count %></b> in total
            </small>
          <% end %>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
        <div class="table-responsive">
          <table class="table table-striped">
          <thead class="table-primary">
            <tr>
              <th>Product/Quantity</th>
              <th>Date</th>
              <th>Subtotal</th>
              <th>Order Status</th>
              <th>Total</th>
            </tr>
          </thead>
            <tbody>
              <% @orders.each do |order| %>
                <tr>
                  <td>
                    <% order.order_items.each do |order_item| %>
                      <p><b><%= link_to order_item.proficient_project.title, proficient_project_path(order_item.proficient_project.id) %></b> / <%= order_item.quantity %></p>
                    <% end %>
                  </td>
                  <td><p><%= order.created_at.strftime('%Y/%m/%d') %></p></td>
                  <td><p><%= order.subtotal %></p></td>
                  <td><p><%= order.order_status.name %></p></td>
                  <td><p><%= order.total %></p></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
    <% if current_user.admin? %>
      <hr>
      <div class="row">
        <div class="col-lg-12 text-center mb-4">
          <h2><b>All Orders</b></h2>
        </div>
      </div>
      <div class="text-center">
        <% if !@all_orders.present? %>
          <p class="text-center">
            No orders were made.
          </p>
        <% else %>
          <div class="apple_pagination text-center mb-3">
            <% if @pagy_all && @pagy_all.count > 0 %>
              <small class="text-muted d-block mb-2">
                Displaying orders <b><%= @pagy_all.from %></b> - <b><%= @pagy_all.to %></b> of <b><%= @pagy_all.count %></b> in total
              </small>
            <% end %>
            <%== @pagy_all.series_nav(:bootstrap) if @pagy_all && @pagy_all.pages > 1 %>
          </div>

          <div class="table-responsive">
            <table class="table table-striped">
            <thead class="table-primary">
              <tr>
                <th>User</th>
                <th>Product/Quantity</th>
                <th>Date Updated</th>
                <th>Subtotal</th>
                <th>Order Status</th>
                <th>Total</th>
                <th>Action</th>
              </tr>
            </thead>
              <tbody>
              <% @all_orders.each do |order| %>
                <tr>
                  <td class="username"><p> <%= link_to order.user&.username, user_path(order.user&.username) if order.user&.username %></p></td>
                  <td>
                    <% order.order_items.each do |order_item| %>
                      <p><b><%= link_to order_item.proficient_project.title, proficient_project_path(order_item.proficient_project.id) %></b> / <%= order_item.quantity %></p>
                    <% end %>
                  </td>
                  <td><p><%= order.created_at.strftime('%Y/%m/%d') %></p></td>
                  <td><p><%= order.subtotal %></p></td>
                  <td><p><%= order.order_status.name %></p></td>
                  <td><p><%= order.total %></p></td>
                  <td>
                    <%= button_to 'Delete', order, method: :delete, data: { confirm: 'Are you sure? This will give back the CC points used to purchase this order.' }, class: 'btn btn-danger' %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>


