<% if @question.images.attached? %>
  <% @question.images.each do |img| %>
    <div class="img-wrap col-md-6 col-12 mx-auto" style="border: 1px dotted gray; border-radius: 30px; padding: 1em;">
      <div class="projects-image" style="background-image: url(<%= url_for(img) %>);">
        <span><%= button_to '<i class="fa-solid fa-xmark"></i>'.html_safe, delete_individually_questions_path(id: img.id, question_id: @question.id), method: :delete, class: 'btn btn-default x-button text-danger', data: { turbo_confirm: 'Are you sure you want to delete this image?' } %></span>
      </div>
    </div>
  <% end %>
<% end %>
