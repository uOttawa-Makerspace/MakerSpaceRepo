<div class="text-left row mb-4" id="edit-image">
  <%= render 'question_images' %>
</div>

<%= form_for @question, url: { controller: 'questions', action: 'update' }, method: :patch, html: { class: 'needs-validation', novalidate: 'novalidate' } do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="col-md-12">
        <%= render partial: 'answers', locals: { f: } %>
      </div>
      <div class="col-12">
        <%= link_to t('questions.edit.add_answer'), edit_question_path(id: @question.id, n_answers: @answers.count + 1), method: :post, class: 'btn btn-info text-white float-start' %>
      </div>
      <br />
      <br />


      <div class="mb-3 text-center">
        <%= f.label :description %>
        <%= f.text_area :description, placeholder: t('questions.form.question_placeholder'), class: 'form-control', required: true %>
        <div class="invalid-feedback">
          <%= t('questions.form.provide_description') %>
        </div>
        <br />
        <%= t('questions.form.categories') %>
        <br />
        <div class="mt-3">
          <%= f.select :training_ids, options_from_collection_for_select(@categories, 'id', 'name', selected: (@question.trainings.pluck(:id) if @question.trainings.present?)), {}, { multiple: true, id: 'questions_trainings', class: 'form-control form-select' } %>
        </div>
        <br />
        <div class="mb-3">
          <%= f.label :level, class: 'form-label' %>
          <%= f.select :level, options_for_select(question_level_options(@levels), selected: @question.level), { prompt: t('questions.edit.select_level') }, class: 'form-control form-select', required: true %>
        </div>
      </div>
      <br />

      <div class="text-center">
        <%= f.file_field :images, id: 'pictureInput', multiple: true %>
      </div>

      <br />
      <br />

      <div id="image-target" class="mx-auto text-center"></div>

    </div>

    <div class="col-lg-12 text-center">
      <%= f.submit t('questions.edit.update'), class: 'btn btn-secondary btn-xl text-uppercase' %>
    </div>
  </div>

<% end %>

<%# Remove-answer forms live outside the update form (HTML forbids nesting); the Remove buttons point at them via the form attribute. %>
<% @answers.select { |a| a.persisted? && !a.correct }.each do |answer| %>
  <%= form_with url: remove_answer_question_path(@question, answer_id: answer.id), method: :delete, id: "remove-answer-#{answer.id}" do %><% end %>
<% end %>
