<div class="mb-3">
  <p class="text-success text-center"><%= t('questions.edit.first_answer_correct_html') %></p>
  <%= f.fields_for :answers, @answers do |af| %>
    <%= af.rich_text_area :description, placeholder: t('questions.edit.answers_placeholder'), class: "form-control h-auto #{return_answer_border_color(af.object)}", required: true %>
    <% unless af.object.correct %>
      <% if af.object.persisted? %>
        <%= button_tag t('questions.edit.remove'), type: 'submit', form: "remove-answer-#{af.object.id}", class: 'btn btn-danger text-white float-end', **confirmation_options(t('confirmations.questions.remove_answer')) %>
      <% else %>
        <%= link_to t('questions.edit.remove'), edit_question_path(id: @question.id, n_answers: @answers.count - 1), class: 'btn btn-danger text-white float-end' %>
      <% end %>
    <% end %>
    <br />
    <br />
    <div class="invalid-feedback">
      <%= t('questions.form.provide_answers') %>
    </div>
    <br />
  <% end %>
</div>
