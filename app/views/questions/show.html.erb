<h2 class="text-center pt-2 mb-5"><%= t('questions.show.title_html', trainings: (sanitize(@question.trainings.map(&:name).join(', ')) if @question.trainings.present?)) %></h2>

<div class="text-start word-break">
  <h2><b><%= sanitize(@question.description) %></b></h2>
</div>

<div class="text-center col-12 justified-gallery">
  <% if @question.images.attached? %>
    <% @question.images.each do |img| %>
      <a href="#">
        <%= image_tag(img, alt: t('common.names.question_image'), style: 'border:1px solid #021a40;', class: 'd-inline-block mx-auto') %>
      </a>
    <% end %>
  <% end %>
</div>

<hr>

<div class="text-start">
  <% @question.answers.shuffle.each do |a| %>
    <% if a.correct %>
      <div class="correct-answers"><%= a.description %></div>
    <% else %>
      <div class="answers"><%= a.description %></div>
    <% end %>
  <% end %>
</div>
