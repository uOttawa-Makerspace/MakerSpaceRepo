<h2 class="text-center pt-2 mb-5 fw-bold"><%= t('questions.new.title') %></h2>

<div class="container my-5">
  <div class="row">
    <div class="col-lg-12">
      <%= form_for @new_question, url: { controller: 'questions', action: 'create' }, html: { class: 'needs-validation', novalidate: 'novalidate', multipart: true } do |f| %>
        <% if @new_question.errors.any? %>
          <div class="alert alert-danger text-center"><%= @new_question.errors.full_messages.to_sentence %></div>
        <% end %>
        <div class="row">
          <div class="col-md-12">
            <div class="mb-3 text-center">
              <%= f.text_area :description, placeholder: t('questions.form.question_placeholder'), class: 'form-control', required: true %>
              <div class="invalid-feedback">
                <%= t('questions.form.provide_description') %>
              </div>
              <br />
              <%= t('questions.form.categories') %>
              <br />
              <div class="mt-3">
                <%= f.select :training_ids, options_from_collection_for_select(@categories, 'id', 'name', false), {}, { multiple: true, id: 'questions_trainings', class: 'form-control form-select' } %>
              </div>
              <br />

              <div class="mb-3">
                <%= f.label 'level', class: 'form-label' %>
                <%= f.select 'level', options_for_select(question_level_options(@levels)), { prompt: t('questions.new.select_level') }, class: 'form-control form-select', required: true %><br>
              </div>
              <br />
              <br />

              <div class="text-center">
                <%= f.file_field :images, id: 'pictureInput', multiple: true %>
              </div>
              <br />
              <br />

              <div id="image-target" class="mx-auto"></div>

            </div>
          </div>
          <br />

          <div class="col-md-12">
            <div class="mb-3">
              <p class="text-success text-center"><%= t('questions.new.first_answer_correct_html') %></p>
              <% i = 1 %>
              <%= f.fields_for :answers do |af| %>
                <%= af.rich_text_area :description, placeholder: t('questions.new.answer_placeholder', number: i), class: "form-control h-auto #{return_answer_border_color(af.object)}", required: true %>
                <div class="invalid-feedback"><%= t('questions.form.provide_answers') %></div>
                <br />
                <% i += 1 %>
              <% end %>
            </div>
          </div>

          <div class="row col-4 mx-auto">
            <div class="col-auto">
              <%= link_to '', new_question_path(n_answers: params[:n_answers].to_i - 1), class: 'float-start btn minus-button plus-button-large', title: t('questions.new.remove_answers'), 'data-bs-toggle' => 'tooltip', 'data-placement' => 'top' %>
            </div>
            <div class="col-auto text-center">
              <%= link_to '2', new_question_path(n_answers: 2), class: 'btn circle-button', title: t('questions.new.answer_count', count: 2), 'data-bs-toggle' => 'tooltip', 'data-placement' => 'top' %>
            </div>
            <div class="col-auto text-center">
              <%= link_to '4', new_question_path(n_answers: 4), class: 'btn circle-button', title: t('questions.new.answer_count', count: 4), 'data-bs-toggle' => 'tooltip', 'data-placement' => 'top' %>
            </div>
            <div class="col-auto">
              <%= link_to '', new_question_path(n_answers: params[:n_answers].to_i + 1), class: 'float-end btn plus-button plus-button-large', title: t('questions.new.add_answers'), 'data-bs-toggle' => 'tooltip', 'data-placement' => 'top' %>
            </div>
          </div>

          <div class="col-lg-12 text-center my-5">
            <%= f.submit t('questions.new.create'), class: 'btn btn-secondary btn-xl text-uppercase' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
