<%# The list comes from AnnouncementsHelper#visible_announcements (cached per
    user); the dismiss forms are rendered live (session-bound CSRF tokens). %>
<% visible_announcements.each do |group, id, description| %>
  <% css, label = AnnouncementsHelper::ANNOUNCEMENT_BAR_STYLES.fetch(group) %>
  <div class="alert <%= css %> text-center alert-dismissible fade show" role="alert">
    <b><%= label %></b> <%= description %>
    <% if signed_in? %>
      <%= button_to '', dismiss_announcements_path(announcement_id: id), method: :put, class: 'btn-close', data: { 'bs-dismiss': 'alert' } %>
    <% else %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    <% end %>
  </div>
<% end %>
