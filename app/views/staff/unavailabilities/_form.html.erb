<div class="modal fade" id="unavailabilityModal" data-controller="unavailability-form" data-unavailability-form-exit-message-value="<%= t('confirmations.unsaved_changes.exit') %>" data-action="hide.bs.modal->unavailability-form#confirmExit hidden.bs.modal->unavailability-form#reset show.bs.modal->unavailability-form#proposeTimes" tabindex="-1" aria-labelledby="unavailabilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="content">
            <div class="modal-header">
                <h5 class="modal-title" id="unavailabilityModalLabel" data-unavailability-form-target="label">Add Unavailability</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
            </div>
            <%= form_with url: staff_unavailabilities_path, scope: :staff_unavailability, local: false, html: { class: "useTurbo", id: "unavailForm", data: { unavailability_form_target: "form", action: "submit->unavailability-form#sendInstants" } }  do |f| %>
                <%= hidden_field_tag "_method", "patch", id: nil, disabled: true, data: { unavailability_form_target: "methodField" } %>
                <div class="modal-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="all_day_checkbox" data-unavailability-form-target="allDay" data-action="change->unavailability-form#allDayChanged">
                        <label class="form-check-label" for="all_day_checkbox">All Day</label>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <%= f.label :start_time, "Start Time", for: "start_time_field", class: "form-label", required: "true" %>
                            <%= f.datetime_local_field :start_time, class: "form-control", id: "start_time_field", required: "true", data: { unavailability_form_target: "startTime", action: "change->unavailability-form#startChanged" } %>
                        </div>
                        <div class="col">
                            <%= f.label :end_time, "End Time", for: "end_time_field", class: "form-label" %>
                            <%= f.datetime_local_field :end_time, class: "form-control", id: "end_time_field", disabled: false, data: { unavailability_form_target: "endTime", action: "change->unavailability-form#validateTimeRange" } %>
                        </div>
                    </div>

                    <div id="time_error" class="alert alert-danger d-none mb-3" data-unavailability-form-target="timeError">
                        End time must be after start time
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Repeats</label>
                        <select id="recurrence_frequency" class="form-select" data-unavailability-form-target="frequency" data-action="change->unavailability-form#frequencyChanged">
                            <option value="">Does not repeat</option>
                            <option value="DAILY">Daily</option>
                            <option value="WEEKLY">Weekly</option>
                            <option value="MONTHLY">Monthly</option>
                        </select>
                    </div>

                    <div id="recurrence_options" style="display: none;" data-unavailability-form-target="options">
                        <div class="mb-3">
                            <label class="form-label">Ends (Leave blank for never)</label>
                            <input type="date" id="recurrence_until" class="form-control" data-unavailability-form-target="until" data-action="change->unavailability-form#warnWithoutWeekday">
                        </div>

                        <div id="weekly_options" class="mb-3" style="display: none;" data-unavailability-form-target="weeklyOptions">
                            <label class="form-label">Repeat On</label>
                            <div class="d-flex gap-2">
                                <% %w[SU MO TU WE TH FR SA].each do |day| %>
                                    <span>
                                        <input class="form-check-input dayCheckbox" type="checkbox" value="<%= day %>" id="day_<%= day %>" data-unavailability-form-target="dayCheckbox" data-action="change->unavailability-form#warnWithoutWeekday">
                                        <label class="form-check-label" for="day_<%= day %>"><%= day %></label>
                                    </span>
                                <% end %>
                            </div>

                            <div id="day_freq_error" class="alert alert-danger d-none my-3" data-unavailability-form-target="dayFreqError">
                                At least one day must be selected
                            </div>
                        </div>
                    </div>

                    <%= f.hidden_field :utc_start_time, id: "utc_start_time", data: { unavailability_form_target: "utcStart" } %>
                    <%= f.hidden_field :utc_end_time, id: "utc_end_time", data: { unavailability_form_target: "utcEnd" } %>
                    <%= f.hidden_field :recurrence_rule, id: "recurrence_rule_field", data: { unavailability_form_target: "ruleField" } %>

                    <div id="accordion" class="accordion mt-3">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#customFieldsCollapse">
                                    Custom Values (Optional)
                                </button>
                            </h2>
                            <div id="customFieldsCollapse" class="accordion-collapse collapse" data-unavailability-form-target="collapse">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <%= f.label :title, for: "title", class: "form-label" %>
                                        <%= f.text_field :title, class: "form-control", id: "title", data: { unavailability_form_target: "titleField" } %>
                                    </div>

                                    <div class="mb-3">
                                        <%= f.label :description, for: "description", class: "form-label" %>
                                        <%= f.text_area :description, class: "form-control", rows: 2, id: "description", data: { unavailability_form_target: "descriptionField" } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" id="modal_buttons" data-unavailability-form-target="modalButtons">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <%= f.submit "Update", class: "btn btn-success", id: "save_button", data: { unavailability_form_target: "saveButton" } %>

                    <div class="dropdown" id="update_dropdown" data-bs-auto-close="outside" data-unavailability-form-target="updateDropdown">
                        <button class="btn btn-success dropdown-toggle hidden" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Save
                        </button>
                        <div class="dropdown-menu p-3" id="update_dropdown_items" style="min-width: 250px;" data-unavailability-form-target="updateDropdownItems" data-action="click->unavailability-form#keepMenuOpen">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="update_scope" id="update_this" value="this" checked>
                                <label class="form-check-label" for="update_this">
                                    Update this event only
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="update_scope" id="update_all" value="all">
                                <label class="form-check-label" for="update_all">
                                    Update all events
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            <% end %>

            <div class="modal-footer second" id="delete_forms" style="display: none" data-unavailability-form-target="deleteChoices">
                <div class="dropdown show">
                    <button type="button" class="btn btn-primary dropdown-toggle" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Delete
                    </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <%= form_with url: "#", method: :delete, local: false, html: { class: "useTurbo", id: "delete_single_form", data: { unavailability_form_target: "deleteForm" } } do %>
                            <%= hidden_field_tag :scope, "single" %>
                            <%= hidden_field_tag :start_date, nil, class: "delete_start_date", data: { unavailability_form_target: "deleteStartDate" } %>
                            <%= submit_tag "This event", class: "dropdown-item py-2 text-start" %>
                        <% end %>

                        <%= form_with url: "#", method: :delete, local: false, html: { class: "useTurbo", id: "delete_following_form", data: { unavailability_form_target: "deleteForm", repeating_only: true } } do %>
                            <%= hidden_field_tag :scope, "following" %>
                            <%= hidden_field_tag :start_date, nil, class: "delete_start_date", data: { unavailability_form_target: "deleteStartDate" } %>
                            <%= submit_tag "This and following events", class: "dropdown-item py-2 text-start" %>
                        <% end %>

                        <%= form_with url: "#", method: :delete, local: false, html: { class: "useTurbo", id: "delete_all_form", data: { unavailability_form_target: "deleteForm", repeating_only: true } } do %>
                            <%= hidden_field_tag :scope, "all" %>
                            <%= submit_tag "All events", class: "dropdown-item py-2 text-start" %>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-footer.second {
    border: 0 !important;
    padding-top: 0 !important;
    }
</style>