<section class="page-contents">
  <div class="text-center">

    <h2><%= t('volunteer_area.hours.per_user.title') %></h2>
    <h5><%= t('volunteer_area.hours.per_user.volunteers_html', count: @total_volunteers) %></h5>
    <h5><%= t('volunteer_area.hours.per_user.requested_html', hours: @total_volunteer_hours_requested) %></h5>
    <h5><%= t('volunteer_area.hours.per_user.approved_html', hours: @total_volunteer_hour_approved || 0) %></h5>
    <h5><%= t('volunteer_area.hours.per_user.rejected_html', hours: @total_volunteer_hour_rejected || 0) %></h5>

    <% if !@users_with_volunteer_hours.blank? %>

      <input type="text" id="query" onkeyup="findSession('sessions-table')" placeholder="<%= t('volunteer_area.hours.per_user.find_placeholder') %>" class="form-control mx-auto">

      <br />

      <div>
        <table class="table sessions-table">

          <thead>
            <tr>
              <th><%= t('volunteer_area.hours.columns.user') %></th>
              <th><%= t('volunteer_area.hours.per_user.total_time') %></th>
              <th><%= t('volunteer_area.hours.per_user.information') %></th>
            </tr>
          </thead>

          <tbody>
          <% i = 0 %>
          <%== @pagy.series_nav(:bootstrap) if @pagy && @pagy.pages > 1 %>
          <% @users_with_volunteer_hours.each do |user| %>
            <tr data-bs-toggle="collapse" id="row<%= i %>" data-bs-target=".row<%= i %>">
              <td class = "username">
                <%= link_to user.name.titleize, user_path(user.username) %>
              </td>
              <td class="">
                <b><%= user.volunteer_hours.approved.sum(:total_time) %></b>
              </td>
              <td>
                <i class="fa fa-plus"></i>
              </td>
            </tr>
            <tr class="collapse row<%= i %>">
              <td colspan="3">
                <table class="table sessions-table">
                  <thead>
                  <% user.volunteer_hours.processed.order(approval: :desc).each do |vh| %>
                    <tr>
                      <th class = "volunteer_task">
                        <%= link_to vh.volunteer_task.title, volunteer_task_path(vh.volunteer_task.id) %>
                      </th>
                      <th><%= t('volunteer_area.hours.per_user.time_worked', hours: vh.total_time) %></th>
                      <th><%= return_approval(vh.approval) %></th>
                    </tr>
                  <% end %>
                  </thead>
                </table>
              </td>
            </tr>
            <% i += 1 %>
          <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>