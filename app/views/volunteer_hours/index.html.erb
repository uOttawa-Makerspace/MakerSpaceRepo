<section class="page-contents">
  <div class="text-center">

    <%#= render :partial => 'new' %>

    <h2><%= t('volunteer_area.hours.index.title', name: @user.name.titleize) %></h2>
    <h5><%= t('volunteer_area.hours.index.total_html', hours: @total_hours) %></h5>

    <% if !@user_volunteer_hours.blank? %>

      <input type="text" id="query" onkeyup="findSession('sessions-table')" placeholder="<%= t('volunteer_area.hours.find_placeholder') %>" class="form-control mx-auto">

      <br />

      <div class="table-responsive">
        <table class="table sessions-table">

          <tr>
            <th><%= t('volunteer_area.hours.columns.submitted') %> <span onclick="sortTable('sessions-table', 0, true)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.task') %> <span onclick="sortTable('sessions-table', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.date') %><span onclick="sortTable('sessions-table', 2, true)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.hours') %> <span onclick="sortTable('sessions-table', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.approved') %><span onclick="sortTable('sessions-table', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th class="action-header"><%= t('volunteer_area.hours.columns.action') %></th>
          </tr>

          <tbody>
          <%== @pagy.series_nav(:bootstrap) if @pagy && @pagy.pages > 1 %>
          <% @user_volunteer_hours.each do |vh| %>
            <tr>
              <td data-sort-as="<%= vh.created_at.iso8601 %>">
                <%= l(vh.created_at, format: :volunteer_numeric) %>
                <br>
                <%= l(vh.created_at, format: :volunteer_clock).downcase %>
              </td>

              <td>
                <%= vh.volunteer_task.title %>
              </td>

              <td data-sort-as="<%= vh.date_of_task&.iso8601 %>">
                <%= l(vh.date_of_task, format: :volunteer_numeric) if vh.date_of_task %>
              </td>

              <td>
                <%= t('volunteer_area.hours.total_time', hours: vh.total_time) %>
              </td>

              <td>
                <%= return_approval(vh.approval) %>
              </td>

              <td class="action-cell">
                <% if vh.approval.nil? %>
                  <%= link_to t('volunteer_area.shared.edit'), edit_volunteer_hour_path(vh.id), class: 'd-block w-100 visit-button mb-1 mt-0' %>
                  <%= button_to t('common.delete'), { action: :destroy, id: vh.id }, method: :delete, **confirmation_options(t('confirmations.volunteer_hours.delete')), class: 'd-block w-100 destroy-button mb-1 me-0' %>
                <% else %>
                  <%= t('volunteer_area.hours.index.processed') %>
                <% end %>
              </td>

            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <br />
      <br />
      <h6><%= t('volunteer_area.hours.index.empty_html', link: link_to(t('volunteer_area.hours.index.track_hours'), new_volunteer_hour_path, class: 'btn-link')) %></h6>
    <% end %>
  </div>
</section>
