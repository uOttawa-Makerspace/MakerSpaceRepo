<h2 class="text-center"><%= t('volunteer_area.hours.form.new_title') %></h2>

<div class="container my-5">
  <div class="row">
    <div class="col-lg-12">
      <%= form_for @new_volunteer_hour, url: { controller: 'volunteer_hours', action: 'create' }, html: { id: 'volunteerForm', class: 'needs-validation', novalidate: 'novalidate' } do |f| %>
        <div class="row">
          <div class="col-md-12">
            <div class="mb-3 text-center">
              <%= f.label :volunteer_task_id, t('volunteer_area.hours.form.task'), class: 'form-label' %>
              <%= f.select :volunteer_task_id, @volunteer_tasks, { prompt: t('volunteer_area.hours.form.task_prompt') }, { class: 'form-control form-select', 'data-live-search': 'true' } %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <%= f.label :date_of_task, t('volunteer_area.hours.form.date'), class: 'form-label' %>
              <%= f.date_field :date_of_task, class: 'form-control', required: true %>
              <div class="invalid-feedback">
                <%= t('volunteer_area.hours.form.date_missing') %>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <%= f.label :amount_of_hours_worked, t('volunteer_area.hours.form.amount'), for: 'hours', class: 'form-label' %>
            <div class="input-group mx-auto">
              <input id="hours" class="form-control col-6" type="number" required="required" placeholder="<%= t('volunteer_area.hours.form.hours') %>" min="0">
              <span class="input-group-text">:</span>
              <input id="minutes" class="form-control col-6" type="number" required="required" placeholder="<%= t('volunteer_area.hours.form.minutes') %>" min="0" max="59" step="1">
              <div class="invalid-feedback">
                <%= t('volunteer_area.hours.form.amount_missing') %>
              </div>
            </div>
            <%= f.hidden_field :total_time, id: 'total_time_hidden' %>
          </div>
          <div class="col-lg-12 text-center">
            <%= f.submit t('volunteer_area.hours.form.send'), class: 'btn btn-secondary btn-xl text-uppercase' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
