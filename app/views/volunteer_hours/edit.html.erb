<section class="page-contents">
  <div class="edit-column">

    <h2 class="text-center"><%= t('volunteer_area.hours.edit.title', name: @volunteer_hour.user.name.titleize) %></h2>

    <h5 class="text-center"><%= t('volunteer_area.hours.edit.this_hour_html', hours: @volunteer_hour.total_time) %></h5>

    <div class="container my-5">
      <div class="row">
        <div class="col-lg-12">
          <%= form_for @volunteer_hour, url: { controller: 'volunteer_hours', action: 'update' }, html: { id: 'volunteerForm', class: 'needs-validation', novalidate: 'novalidate' } do |f| %>
            <div class="row">
              <div class="col-md-12">
                <div class="mb-3 text-center">
                  <%= f.label :volunteer_task_id, t('volunteer_area.hours.form.task'), class: 'form-label' %>
                  <%= f.select :volunteer_task_id, @volunteer_tasks, {}, { class: 'form-control form-select', 'data-live-search': 'true' } %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :date_of_task, t('volunteer_area.hours.form.date'), class: 'form-label' %>
                  <%= f.date_field :date_of_task, class: 'form-control', required: true %>
                  <div class="invalid-feedback">
                    <%= t('volunteer_area.hours.form.date_missing') %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <%= f.label :amount_of_hours_worked, t('volunteer_area.hours.form.amount'), for: 'hours', class: 'form-label' %>
                <div class="input-group">
                  <input id="hours" class="form-control col-4" type="number" required="required" placeholder="<%= t('volunteer_area.hours.form.hours') %>" min="0" value="<%= @hour %>">
                  <span class="input-group-text">:</span>
                  <input id="minutes" class="form-control col-4" type="number" required="required" placeholder="<%= t('volunteer_area.hours.form.minutes') %>" min="0" max="59" step="1" value="<%= @minutes %>">
                  <div class="invalid-feedback">
                    <%= t('volunteer_area.hours.form.amount_missing') %>
                  </div>
                </div>
                <%= f.hidden_field :total_time, id: 'total_time_hidden' %>
              </div>
              <% if current_user.staff? && !@volunteer_hour.approval.nil? %>
                <div class="col-md-12">
                  <div class="mb-3 text-center">
                    <%= f.label :approval, t('volunteer_area.hours.edit.approved'), class: 'form-label' %>
                    <br />
                    <%= f.radio_button :approval, true %>
                    <%= label :approval, 'Yes', t('volunteer_area.hours.edit.yes'), class: 'form-label' %>
                    <%= f.radio_button :approval, false %>
                    <%= label :approval, 'No', t('volunteer_area.hours.edit.no'), class: 'form-label' %>
                  </div>
                </div>
              <% end %>
              <div class="col-lg-12 text-center">
                <%= f.submit t('volunteer_area.hours.edit.update'), class: 'btn btn-secondary btn-xl text-uppercase' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
