<section class="page-contents">
  <div class="text-center">

    <h2><%= t('volunteer_area.hours.requests.title') %></h2>
    <h5><%= t('volunteer_area.hours.requests.pending_total_html', count: @total_volunteer_hour_requests) %></h5>

    <% if !@new_volunteer_hour_requests.blank? %>
      <input type="text" id="query" onkeyup="findSession('sessions-table')" placeholder="<%= t('volunteer_area.hours.find_placeholder') %>" class="form-control mx-auto">

      <br />

      <h5><%= t('volunteer_area.hours.requests.pending') %></h5>

      <div class="table-responsive">
        <table class="table sessions-table">

          <tr>
            <th><%= t('volunteer_area.hours.columns.user') %><span onclick="sortTable('sessions-table', 0)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.submitted') %> <span onclick="sortTable('sessions-table', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.task') %> <span onclick="sortTable('sessions-table', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.date') %><span onclick="sortTable('sessions-table', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.hours') %> <span onclick="sortTable('sessions-table', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.approve') %><span onclick="sortTable('sessions-table', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th class="action-header"><%= t('volunteer_area.hours.columns.action') %></th>
          </tr>

          <tbody>
          <%== @pagy_new.series_nav(:bootstrap) if @pagy_new && @pagy_new.pages > 1 %>
          <% @new_volunteer_hour_requests.each do |vh| %>
            <tr>
              <td class = "username">
                <%= link_to vh.user.name.titleize, user_path(vh.user.username) %>
              </td>

              <td>
                <%= l(vh.created_at, format: :volunteer_numeric) %>
                <br>
                <%= l(vh.created_at, format: :volunteer_clock).downcase %>
              </td>

              <td class = "volunteer_task">
                <%= link_to vh.volunteer_task.title, volunteer_task_path(vh.volunteer_task.id) %>
              </td>

              <td>
                <%= l(vh.date_of_task, format: :volunteer_numeric) if vh.date_of_task %>
              </td>

              <td>
                <%= t('volunteer_area.hours.total_time', hours: vh.total_time) %>
              </td>

              <td class="action-cell">
                <%= button_to '<i class="fa-solid fa-xmark"></i>'.html_safe, { controller: :volunteer_hours, action: :update_approval, id: vh.id, approval: false }, method: :put, class: 'btn btn-default x-button', aria: { label: t('common.decline') } %>
                <%= button_to '<i class="fa-solid fa-check"></i>'.html_safe, { controller: :volunteer_hours, action: :update_approval, id: vh.id, approval: true }, method: :put, class: 'btn btn-default check-button', aria: { label: t('common.approve') } %>
              </td>

              <td class="action-cell">
                <%= link_to t('volunteer_area.shared.edit'), edit_volunteer_hour_path(vh.id), class: 'd-block w-100 visit-button mb-1 mt-0' %>
                <%= button_to t('common.delete'), { action: :destroy, id: vh.id }, method: :delete, **confirmation_options(t('confirmations.volunteer_hours.delete')), class: 'd-block w-100 destroy-button mb-1 me-0' %>
              </td>

            </tr>
          <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="m-5">
        <%= t('volunteer_area.hours.requests.none_pending') %>
      </div>
    <% end %>

    <h5><%= t('volunteer_area.hours.requests.processed') %></h5>

    <% if !@old_volunteer_hour_requests.blank? %>

      <input type="text" id="query-2" onkeyup="findSession('sessions-table-2', 'query-2')" placeholder="<%= t('volunteer_area.hours.find_placeholder') %>" class="form-control mx-auto">

      <br />

      <div class="table-responsive">
        <table class="table table-primary table-striped sessions-table-2">

          <tr>
            <th><%= t('volunteer_area.hours.columns.user') %><span onclick="sortTable('sessions-table-2', 0)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.submitted') %> <span onclick="sortTable('sessions-table-2', 1)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.task') %> <span onclick="sortTable('sessions-table-2', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.date') %><span onclick="sortTable('sessions-table-2', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.hours') %> <span onclick="sortTable('sessions-table-2', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th><%= t('volunteer_area.hours.columns.approved') %><span onclick="sortTable('sessions-table-2', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th class="action-header"><%= t('volunteer_area.hours.columns.action') %></th>
          </tr>

          <tbody>
          <%== @pagy_old.series_nav(:bootstrap) if @pagy_old && @pagy_old.pages > 1 %>
          <% @old_volunteer_hour_requests.each do |vh| %>
            <tr>
              <td class = "username">
                <%= link_to vh.user.name.titleize, user_path(vh.user.username) %>
              </td>

              <td>
                <%= l(vh.created_at, format: :volunteer_numeric) %>
                <br>
                <%= l(vh.created_at, format: :volunteer_clock).downcase %>
              </td>

              <td class = "volunteer_task">
                  <%= link_to vh.volunteer_task.title, volunteer_task_path(vh.volunteer_task.id) %>
              </td>

              <td>
                <%= l(vh.date_of_task, format: :volunteer_numeric) if vh.date_of_task %>
              </td>

              <td>
                <%= t('volunteer_area.hours.total_time', hours: vh.total_time) %>
              </td>

              <td>
                <%= return_approval(vh.approval) %>
              </td>

              <td class="action-cell">
                <%= link_to t('volunteer_area.shared.edit'), edit_volunteer_hour_path(vh.id), class: 'd-block w-100 visit-button mb-1 mt-0' %>
                <%= button_to t('common.delete'), { action: :destroy, id: vh.id }, method: :delete, **confirmation_options(t('confirmations.volunteer_hours.delete')), class: 'd-block w-100 destroy-button mb-1 me-0' %>
              </td>

            </tr>
          <% end %>
          </tbody>
        </table>
    <% else %>
      <div class="m-5">
        <%= t('volunteer_area.hours.requests.none_processed') %>
      </div>
    <% end %>
    </div>
  </div>
</section>
