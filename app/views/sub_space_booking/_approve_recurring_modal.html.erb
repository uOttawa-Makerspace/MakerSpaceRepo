<div class="modal fade" tabindex="-1" id="approveRecurringModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow bg-body">
      <div class="modal-header text-bg-primary">
        <h5 class="modal-title fw-bold">Select Recurring Dates to Approve</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: bulk_approve_decline_sub_space_booking_index_path, method: :put do |f| %>
        <%= f.hidden_field :bulk_status, value: 'approve' %>
        <div class="modal-body p-4">
          <!-- Template Checkbox used by JS -->
          <label class="form-check w-100 mb-2 p-2 border border-secondary-subtle rounded bg-body-tertiary cursor-pointer">
            <input class="form-check-input ms-0 me-2" type="checkbox" name="sub_space_booking_ids[]" value=""> 
            <span class="form-check-label fw-medium text-body-emphasis">Template</span>
          </label>
        </div>
        <div class="modal-footer bg-body-tertiary border-top border-secondary-subtle">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit 'Approve Selected', class: 'btn btn-success' %>
        </div>
      <% end %>
    </div>
  </div>
</div>