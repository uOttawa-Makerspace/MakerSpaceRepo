<section class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow border-0 rounded-4 bg-body">
        <div class="card-header text-bg-primary text-center py-3">
          <h4 class="mb-0 fw-bold">Edit Booking</h4>
        </div>
        <div class="card-body p-4 p-md-5">
          <%= form_for @sub_space_booking, url: { controller: 'sub_space_booking', action: 'update' }, html: { id: 'bookingEdit', class: 'needs-validation', novalidate: 'novalidate' } do |f| %>
            <%= f.hidden_field :sub_space_booking_id, value: @sub_space_booking.id %>

            <div class="form-floating mb-3">
              <%= f.text_field :name, class: 'form-control', required: true, placeholder: 'Event Name' %>
              <%= f.label :name, 'Event Name' %>
            </div>

            <div class="form-floating mb-4">
              <%= f.text_area :description, class: 'form-control', required: true, placeholder: 'Description', style: "height: 100px" %>
              <%= f.label :description, 'Task Description' %>
            </div>

            <div class="p-3 bg-body-tertiary border border-secondary-subtle rounded mb-4">
              <h6 class="fw-bold mb-3 text-body-secondary">Time Slot</h6>
              <div class="form-floating mb-3">
                <%= f.text_field :start_time, class: 'form-control', placeholder: 'Start Time' %>
                <%= f.label :start_time, 'Start Time' %>
              </div>
              <div class="form-floating mb-0">
                <%= f.text_field :end_time, class: 'form-control', placeholder: 'End Time' %>
                <%= f.label :end_time, 'End Time' %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit 'Update Booking', class: 'btn btn-primary btn-lg fw-bold' %>
            </div>
          <% end %>
          
          <hr class="my-4 border-secondary-subtle">
          
          <div class="text-center">
             <%= button_to sub_space_booking_delete_path(sub_space_booking_id: @sub_space_booking.id), method: :delete, data: { confirm: 'Are you absolutely sure you want to delete this booking?' }, class: 'btn btn-outline-danger' do %>
                <i class="fa fa-trash me-1"></i> Delete Booking Permanently
             <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>