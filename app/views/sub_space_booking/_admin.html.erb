<section>
  <h3 class="text-center my-4 fw-bold text-primary">Booking Admin Panel</h3>
  
  <div class="container-fluid px-0">
    <!-- PENDING BOOKINGS -->
    <div class="card shadow-sm mb-4 border-0 bg-body" id="pending-accordion">
      <div class="card-header text-bg-warning d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#pendingBody">
        <h5 class="mb-0 fw-bold text-dark"><%= fa_icon 'clock-o' %> Pending Bookings</h5>
        <span class="text-dark"><%= fa_icon 'chevron-down' %></span>
      </div>
      
      <div id="pendingBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @pending_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @pending_bookings, container: false, param_name: 'pending_page' %>
              </div>
            </div>

            <!-- Bulk Approve Form Handle -->
            <%= form_with id: 'bulkApproveDeclineForm', url: bulk_approve_decline_sub_space_booking_index_path, method: :put do |f| %><% end %>

            <table class="table table-hover align-middle mb-0 table-sub-space-booking-pending">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">
                    <div class="form-check">
                      <%= check_box_tag :pending_bookings_select_all, '1', false, class: 'form-check-input' %>
                    </div>
                  </th>
                  <th>Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% processed_recurring_ids = Set.new %>
                <% @pending_bookings.each do |booking| %>
                  <% if booking.recurring_booking_id.present? %>
                    <% next if processed_recurring_ids.include?(booking.recurring_booking_id) %>
                    <% processed_recurring_ids.add(booking.recurring_booking_id) %>
                    <% bookings = @recurring_bookings_map[booking.recurring_booking_id] || [booking] %>
                  <% else %>
                    <% bookings = [booking] %>
                  <% end %>
                  
                  <tr>
                    <td class="ps-3">
                      <div class="form-check">
                        <%= check_box_tag "sub_space_booking_ids[]", booking.id, false, id: "booking_#{booking.id}", class: 'form-check-input pending-booking-select', form: 'bulkApproveDeclineForm' %>
                      </div>
                    </td>
                    <td>
                      <span class="badge text-bg-secondary">
                        <%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %>
                      </span>
                    </td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.name %></strong><br>
                      <small class="text-body-secondary"><%= truncate(booking.description, length: 50) %></small>
                    </td>
                    <td>
                      <%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none fw-bold text-primary') %><br>
                      <small class="text-body-secondary"><%= booking.user.email %></small>
                    </td>
                    <td>
                      <% if bookings.length > 1 %>
                        <span class="badge text-bg-info mb-1">Recurring (<%= bookings.length %>)</span><br>
                        <small class="text-body-secondary">From: <%= bookings.first.start_time.strftime("%b %e, %Y") %></small>
                      <% else %>
                        <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                        <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                      <% end %>
                    </td>
                    <td class="text-end pe-3">
                      <% if bookings.length > 1 %>
                        <div class="btn-group btn-group-sm">
                          <%= button_to bulk_approve_decline_sub_space_booking_index_path, method: :put, params: { bulk_status: 'approve', sub_space_booking_ids: bookings.map(&:id) }, class: 'btn btn-outline-success', title: 'Approve All' do %><%= fa_icon 'check-double' %><% end %>
                          <%= button_tag type: 'button', class: 'btn btn-outline-primary', title: 'Select Specific', data: { bs_toggle: 'modal', bs_target: '#approveRecurringModal', dates: bookings.map { |b| [b.id, "#{b.start_time.strftime("%b %e")} (#{b.start_time.strftime("%l:%M%P")}-#{b.end_time.strftime("%l:%M%P")})"] } } do %><%= fa_icon 'list' %><% end %>
                          <%= button_to bulk_approve_decline_sub_space_booking_index_path, method: :put, params: { bulk_status: 'decline', sub_space_booking_ids: bookings.map(&:id) }, class: 'btn btn-outline-danger', title: 'Reject All' do %><%= fa_icon 'times' %><% end %>
                        </div>
                      <% else %>
                        <div class="d-flex gap-2 justify-content-end">
                          <%= button_to sub_space_booking_approve_path(sub_space_booking_id: booking.id), method: :put, class: 'btn btn-sm btn-success' do %><%= fa_icon 'check' %> Approve<% end %>
                          <%= button_to sub_space_booking_decline_path(sub_space_booking_id: booking.id), method: :put, class: 'btn btn-sm btn-danger' do %><%= fa_icon 'times' %> Reject<% end %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            
            <div class="p-3 bg-body-tertiary border-top border-secondary-subtle d-flex gap-2">
              <button type="submit" form="bulkApproveDeclineForm" name="bulk_status" value="approve" class="btn btn-success"><%= fa_icon 'check' %> Bulk Approve Selected</button>
              <button type="submit" form="bulkApproveDeclineForm" name="bulk_status" value="decline" class="btn btn-danger"><%= fa_icon 'times' %> Bulk Reject Selected</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ACCEPTED BOOKINGS -->
    <div class="card shadow-sm mb-4 border-0 bg-body" id="approved-accordion">
      <div class="card-header text-bg-success d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#approvedBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'calendar-check-o' %> Accepted Bookings</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="approvedBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @approved_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @approved_bookings, container: false, param_name: 'approved_page' %>
              </div>
            </div>
            
            <table class="table table-hover align-middle mb-0 table-sub-space-booking-accepted">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                  <th>Status</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @approved_bookings.each do |booking| %>
                  <tr>
                    <td class="ps-3">
                      <span class="badge text-bg-secondary"><%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %></span>
                    </td>
                    <td><strong class="text-body-emphasis"><%= booking.name %></strong></td>
                    <td><%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none text-primary') %></td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                      <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                    </td>
                    <td>
                      <span class="badge <%= booking.public ? 'text-bg-info text-dark' : 'text-bg-dark' %>"><%= booking.public ? 'Public' : 'Private' %></span>
                    </td>
                    <td class="text-end pe-3">
                      <div class="btn-group btn-group-sm">
                        <%= button_to sub_space_booking_publish_path(sub_space_booking_id: booking.id), method: :put, class: "btn #{booking.public ? 'btn-outline-secondary' : 'btn-outline-primary'}" do %>
                          <%= booking.public ? 'Make Private' : 'Make Public' %>
                        <% end %>
                        <%= button_to sub_space_booking_decline_path(sub_space_booking_id: booking.id), method: :put, class: 'btn btn-outline-danger' do %><%= fa_icon 'times' %><% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- DECLINED BOOKINGS -->
    <div class="card shadow-sm mb-4 border-0 bg-body" id="declined-accordion">
      <div class="card-header text-bg-danger d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#declinedBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'ban' %> Declined Bookings</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="declinedBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @declined_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @declined_bookings, container: false, param_name: 'denied_page' %>
              </div>
            </div>
            
            <table class="table table-hover align-middle mb-0 table-sub-space-booking-declined">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @declined_bookings.each do |booking| %>
                  <tr>
                    <td class="ps-3">
                      <span class="badge text-bg-secondary"><%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %></span>
                    </td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.name %></strong><br>
                      <small class="text-body-secondary"><%= truncate(booking.description, length: 50) %></small>
                    </td>
                    <td><%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none text-primary') %></td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                      <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                    </td>
                    <td class="text-end pe-3">
                      <%= button_to sub_space_booking_approve_path(sub_space_booking_id: booking.id), method: :put, class: 'btn btn-sm btn-success' do %><%= fa_icon 'check' %> Approve<% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- USER PERMISSIONS -->
    <div class="card shadow-sm mb-4 border-0 bg-body" id="user-card">
      <div class="card-header text-bg-primary d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#userPermsBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'users' %> Manage User Permissions</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="userPermsBody" class="collapse show">
        <div class="card-body p-4 bg-body">
          <%= form_with url: approve_access_sub_space_booking_index_path, method: :put, class: 'mb-4' do |f| %>
            <div class="input-group">
              <%= f.select :user_id, [], {}, { class: 'form-select', id: 'user_booking_select' } %>
              <%= f.submit 'Permit Access', class: 'btn btn-primary fw-bold' %>
            </div>
          <% end %>

          <h5 class="mt-4 text-warning border-bottom border-warning-subtle pb-2">Pending Requests</h5>
          <%= form_with url: bulk_approve_access_sub_space_booking_index_path, method: :put do |f| %>
            <div class="table-responsive">
              <table class="table table-hover align-middle border border-secondary-subtle">
                <thead class="table-secondary">
                  <tr>
                    <th class="ps-3"><input type="checkbox" id="userRequestSelectAll" class="form-check-input" /></th>
                    <th>Name</th>
                    <th>Reason</th>
                    <th>Date</th>
                    <th class="text-end pe-3">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% UserBookingApproval.includes(:user).where(approved: false).find_each do |req| %>
                    <tr>
                      <td class="ps-3"><%= check_box_tag 'user_booking_approval_ids[]', req.id, false, class: 'form-check-input user-request-select' %></td>
                      <td>
                        <strong class="text-body-emphasis"><%= req.user.name %></strong><br>
                        <small class="text-body-secondary"><%= req.user.email %></small>
                      </td>
                      <td class="text-body-emphasis"><%= req.comments %></td>
                      <td class="text-body-secondary"><%= req.created_at.strftime("%b %e, %Y") %></td>
                      <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                          <%= button_to approve_access_sub_space_booking_index_path(id: req.id), method: :put, class: 'btn btn-outline-success' do %><%= fa_icon 'check' %><% end %>
                          <%= button_to deny_access_sub_space_booking_index_path(id: req.id), method: :put, class: 'btn btn-outline-danger' do %><%= fa_icon 'times' %><% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <%= f.submit 'Bulk Approve Selected', class: 'btn btn-success btn-sm mt-2' %>
          <% end %>

          <h5 class="mt-5 text-success border-bottom border-success-subtle pb-2">Approved Users</h5>
          <div class="table-responsive">
            <table class="table table-hover align-middle border border-secondary-subtle">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Name</th>
                  <th>Reason</th>
                  <th>Approved By</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% UserBookingApproval.includes(:user, :staff).where(approved: true).find_each do |req| %>
                  <tr>
                    <td class="ps-3">
                      <strong class="text-body-emphasis"><%= req.user.name %></strong><br>
                      <small class="text-body-secondary"><%= req.user.email %></small>
                    </td>
                    <td class="text-body-emphasis"><%= truncate(req.comments, length: 40) %></td>
                    <td class="text-body-secondary"><%= req.staff.name %></td>
                    <td class="text-end pe-3">
                      <%= button_to deny_access_sub_space_booking_index_path(id: req.id), method: :put, class: 'btn btn-sm btn-outline-danger' do %>Revoke<% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- EXPIRED PENDING -->
    <div class="card shadow-sm border-0 bg-body mb-4" id="past-pending-accordion">
      <div class="card-header text-bg-secondary d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#pastPendingBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'history' %> Expired Pending Bookings</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="pastPendingBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @old_pending_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @old_pending_bookings, container: false, param_name: 'old_pending_page' %>
              </div>
            </div>
            <table class="table table-hover align-middle mb-0">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                </tr>
              </thead>
              <tbody>
                <% @old_pending_bookings.each do |booking| %>
                  <tr>
                    <td class="ps-3">
                      <span class="badge text-bg-secondary"><%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %></span>
                    </td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.name %></strong><br>
                      <small class="text-body-secondary"><%= truncate(booking.description, length: 50) %></small>
                    </td>
                    <td><%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none text-primary') %></td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                      <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <!-- EXPIRED APPROVED -->
    <div class="card shadow-sm border-0 bg-body mb-4" id="past-approved-accordion">
      <div class="card-header text-bg-secondary d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#pastApprovedBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'history' %> Expired Accepted Bookings</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="pastApprovedBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @old_approved_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @old_approved_bookings, container: false, param_name: 'old_approved_page' %>
              </div>
            </div>
            <table class="table table-hover align-middle mb-0">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                </tr>
              </thead>
              <tbody>
                <% @old_approved_bookings.each do |booking| %>
                  <tr>
                    <td class="ps-3">
                      <span class="badge text-bg-secondary"><%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %></span>
                    </td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.name %></strong><br>
                      <small class="text-body-secondary"><%= truncate(booking.description, length: 50) %></small>
                    </td>
                    <td><%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none text-primary') %></td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                      <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <!-- EXPIRED DECLINED -->
    <div class="card shadow-sm border-0 bg-body" id="past-declined-accordion">
      <div class="card-header text-bg-secondary d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#pastDeclinedBody">
        <h5 class="mb-0 fw-bold"><%= fa_icon 'history' %> Expired Declined Bookings</h5>
        <%= fa_icon 'chevron-down' %>
      </div>
      <div id="pastDeclinedBody" class="collapse show">
        <div class="card-body p-0">
          <div class="table-responsive">
            <div class="p-3 bg-body-tertiary border-bottom border-secondary-subtle d-flex justify-content-between align-items-center">
              <span class="text-body-secondary small"><%= page_entries_info @old_declined_bookings, model: 'subspace_booking' %></span>
              <div class="apple_pagination m-0">
                <%= will_paginate @old_declined_bookings, container: false, param_name: 'old_denied_page' %>
              </div>
            </div>
            <table class="table table-hover align-middle mb-0">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-3">Room</th>
                  <th>Event Details</th>
                  <th>User</th>
                  <th>Schedule</th>
                </tr>
              </thead>
              <tbody>
                <% @old_declined_bookings.each do |booking| %>
                  <tr>
                    <td class="ps-3">
                      <span class="badge text-bg-secondary"><%= booking.sub_space.name == booking.sub_space.space.name ? booking.sub_space.space.name : "#{booking.sub_space.space.name} - #{booking.sub_space.name}" %></span>
                    </td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.name %></strong><br>
                      <small class="text-body-secondary"><%= truncate(booking.description, length: 50) %></small>
                    </td>
                    <td><%= link_to(booking.user.name, user_path(booking.user.username), class: 'text-decoration-none text-primary') %></td>
                    <td>
                      <strong class="text-body-emphasis"><%= booking.start_time.strftime("%b %e, %Y") %></strong><br>
                      <small class="text-body-secondary"><%= booking.start_time.strftime("%l:%M %p") %> - <%= booking.end_time.strftime("%l:%M %p") %></small>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>