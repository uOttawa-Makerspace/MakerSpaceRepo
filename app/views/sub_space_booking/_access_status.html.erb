<%# Where the signed-in user's booking access stands, from User#booking_access_request (nil: no request). %>
<% status = approval&.status || "none" %>
<% changed_at = approval&.status_changed_at %>
<p class="text-body text-center mb-3" id="booking-access-status">
  <%= t("sub_space_booking.access_status.#{status}", date: changed_at && l(changed_at.to_date, format: :long)) %>
  <% if approval&.reason.present? %>
    <br>
    <%= t("sub_space_booking.access_status.reason", reason: approval.reason) %>
  <% end %>
  <% if approval&.declined? || approval&.revoked? %>
    <br>
    <%= t("sub_space_booking.access_status.ask_again") %>
  <% end %>
</p>
