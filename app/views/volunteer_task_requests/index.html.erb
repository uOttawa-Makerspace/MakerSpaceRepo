<section id="volunteerTaskRequestsIndex" class="page-contents py-4">
  <div class="container-xl">

    <!-- 1. Header & Navigation -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
      <div>
        <h2 class="page-title fw-bold mb-1">
          <%= current_user.staff? ? 'Volunteer Task Requests' : 'Your Task Requests' %>
        </h2>
        <p class="text-body-secondary mb-0 small">
          <%= current_user.staff? ? 'Review and manage completion submissions from volunteers.' : 'Track the review status and CC rewards of your completed tasks.' %>
        </p>
      </div>
      <div>
        <%= link_to volunteer_tasks_path, class: 'btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm fw-semibold shadow-sm' do %>
          <i class="fa fa-arrow-left me-1"></i> Back to Tasks
        <% end %>
      </div>
    </div>

    <!-- 2. KPI Summary Cards (BS 5.3 Native Dark Mode Cards) -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <div class="card bg-body border shadow-sm rounded-4 h-100 p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-body-secondary small text-uppercase fw-semibold">Total Requests</span>
              <h3 class="fw-bold mb-0 mt-1 text-body"><%= @total_count %></h3>
            </div>
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 46px; height: 46px;">
              <i class="fa fa-list-alt fa-lg"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card bg-body border shadow-sm rounded-4 h-100 p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-body-secondary small text-uppercase fw-semibold">Pending Review</span>
              <h3 class="fw-bold mb-0 mt-1 text-warning"><%= @pending_count %></h3>
            </div>
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning" style="width: 46px; height: 46px;">
              <i class="fa fa-clock-o fa-lg"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card bg-body border shadow-sm rounded-4 h-100 p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-body-secondary small text-uppercase fw-semibold">Processed History</span>
              <h3 class="fw-bold mb-0 mt-1 text-success"><%= @processed_count %></h3>
            </div>
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success" style="width: 46px; height: 46px;">
              <i class="fa fa-check-circle-o fa-lg"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Navigation Status Tabs -->
    <div class="status-tabs-wrapper mb-4">
      <ul class="nav nav-pills bg-body-tertiary border p-1 rounded-pill d-inline-flex flex-nowrap task-status-pills" id="requestStatusTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link rounded-pill text-nowrap fw-semibold <%= 'active' if @active_tab == 'pending' %>" 
                  id="pending-tab" 
                  data-bs-toggle="pill" 
                  data-bs-target="#pending-pane" 
                  data-tab-name="pending"
                  type="button" 
                  role="tab" 
                  aria-controls="pending-pane" 
                  aria-selected="<%= @active_tab == 'pending' %>">
            <i class="fa fa-hourglass-half me-1"></i> Pending Requests
            <span class="badge rounded-pill ms-1 <%= @active_tab == 'pending' ? 'bg-white text-dark' : 'bg-warning-subtle text-warning-emphasis' %>"><%= @pending_count %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link rounded-pill text-nowrap fw-semibold <%= 'active' if @active_tab == 'processed' %>" 
                  id="processed-tab" 
                  data-bs-toggle="pill" 
                  data-bs-target="#processed-pane" 
                  data-tab-name="processed"
                  type="button" 
                  role="tab" 
                  aria-controls="processed-pane" 
                  aria-selected="<%= @active_tab == 'processed' %>">
            <i class="fa fa-history me-1"></i> Processed History
            <span class="badge rounded-pill ms-1 <%= @active_tab == 'processed' ? 'bg-white text-dark' : 'bg-secondary-subtle text-secondary-emphasis' %>"><%= @processed_count %></span>
          </button>
        </li>
      </ul>
    </div>

    <!-- 4. Tab Panes -->
    <div class="tab-content" id="requestStatusTabsContent">

      <!-- 1. Pending Requests Pane -->
      <div class="tab-pane fade <%= 'show active' if @active_tab == 'pending' %>" id="pending-pane" role="tabpanel" aria-labelledby="pending-tab" tabindex="0">
        <div class="card bg-body border shadow-sm rounded-4 p-3 mb-3">
          <div class="input-group">
            <span class="input-group-text border-end-0 bg-transparent text-body-secondary"><i class="fa fa-search"></i></span>
            <input type="text" id="search_pending" class="form-control border-start-0 ps-0 shadow-none bg-transparent text-body" placeholder="Search pending requests by volunteer, task title, or space..." autocomplete="off">
          </div>
        </div>

        <div class="pending-requests">
          <%= render 'volunteer_task_requests/pending_requests' %>
        </div>
      </div>

      <!-- 2. Processed Requests Pane -->
      <div class="tab-pane fade <%= 'show active' if @active_tab == 'processed' %>" id="processed-pane" role="tabpanel" aria-labelledby="processed-tab" tabindex="0">
        <div class="card bg-body border shadow-sm rounded-4 p-3 mb-3">
          <div class="input-group">
            <span class="input-group-text border-end-0 bg-transparent text-body-secondary"><i class="fa fa-search"></i></span>
            <input type="text" id="search_processed" class="form-control border-start-0 ps-0 shadow-none bg-transparent text-body" placeholder="Search processed history by volunteer, task title, or space..." autocomplete="off">
          </div>
        </div>

        <div class="processed-requests">
          <%= render 'volunteer_task_requests/processed_requests' %>
        </div>
      </div>

    </div>

  </div>
</section>
