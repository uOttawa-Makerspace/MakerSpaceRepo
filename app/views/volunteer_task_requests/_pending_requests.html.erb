
<div class="table-responsive">
    <table class="table table-striped sessions-table">
    <thead class="table-primary">
        <tr>
            <th>Date Submitted <span onclick="sortTable('sessions-table', 0, true)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th>Date Updated <span onclick="sortTable('sessions-table', 1, true)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th>CC/Hours<span onclick="sortTable('sessions-table', 2)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th>Task<span onclick="sortTable('sessions-table', 3)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th>User<span onclick="sortTable('sessions-table', 4)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <th>Status<span onclick="sortTable('sessions-table', 5)"><i class="fa-solid fa-arrow-down"></i></span></th>
            <% if current_user.staff? %>
            <th class="action-header">Action</th>
            <% end %>
        </tr>
    </thead>
        <tbody>
        <%== @pagy_pending.series_nav(:bootstrap) if @pagy_pending && @pagy_pending.pages > 1 %>
        <% @pending_volunteer_task_requests.each do |vtr| %>
        <tr>
            <td>
                <%= vtr.created_at.strftime('%Y-%m-%d') %>
                <br>
                <%= vtr.created_at.strftime('%I:%M %p').downcase %>
            </td>

            <td>
                <%= vtr.updated_at.strftime('%Y-%m-%d') %>
                <br>
                <%= vtr.updated_at.strftime('%I:%M %p').downcase %>
            </td>

            <td>
                <%= vite_image_tag 'images/cc.png', alt: 'CC', class: 'ccs hidden', id: 'myCcBlack' %>
                <%= vtr.volunteer_task.cc %>
                <br/>
                <%= vtr.volunteer_task.hours %> hours
            </td>

            <td>
                <%= link_to vtr.volunteer_task.title, volunteer_task_path(vtr.volunteer_task.id) %>
            </td>

            <td>
                <%= link_to vtr.user.name, user_path(vtr.user.username) %>
            </td>

            <td>
                Waiting for approval
            </td>
            <% if current_user.staff? %>
            <td class="action-cell">
                <%= button_to '<i class="fa-solid fa-xmark"></i>'.html_safe, { controller: :volunteer_task_requests, action: :update_approval, id: vtr.id, approval: false }, method: :put, class: 'btn btn-default x-button' %>
                <%= button_to '<i class="fa-solid fa-check"></i>'.html_safe, { controller: :volunteer_task_requests, action: :update_approval, id: vtr.id, approval: true }, method: :put, class: 'btn btn-default check-button' %>
            </td>
            <% end %>

        </tr>
        <% end %>
        </tbody>
    </table>
</div>
